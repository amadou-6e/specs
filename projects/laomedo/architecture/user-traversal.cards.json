{
  "schema": "laomedo-journey-card-authoring-v1",
  "scope": "Diagram authoring metadata, not an execution API schema. Categories describe responsibility in this draft journey; deployment and authorization remain open.",
  "cards": {
    "SOURCE": {"category": "External service", "input": "GitHub repository", "output": "Issue context", "detail": "Storage: GitHub; access and retention unspecified"},
    "START": {"category": "User", "input": "GitHub issue", "output": "Selected issue", "detail": "Completion: issue selected"},
    "CHANNEL": {"category": "User"},
    "CONFIG": {"category": "User", "input": "Selected issue", "output": "Run configuration", "detail": "Choices: direct UI or chat-assisted API"},
    "CHAT": {"category": "Agent", "input": "User request and Laomedo API", "output": "Configuration, launch, navigation hints", "detail": "Permissions and limits: unspecified"},
    "MODE": {"category": "User"},
    "DIRECT": {"category": "User", "input": "Available agents and library", "output": "Prepared agent, prompt and skills", "detail": "Review configuration before launch; library publication is separate"},
    "FLOW": {"category": "User", "input": "Available Langflow graphs", "output": "Prepared workflow", "detail": "Review agents, skills, handoffs, reviews and loop limits before launch"},
    "SESSION": {"category": "User", "input": "Available sessions", "output": "Session selection", "detail": "Choices: existing or new"},
    "WORKSPACE": {"category": "User", "input": "Available workspace options", "output": "Selected workspace", "detail": "Choices: local checkout or isolated workspace; default unspecified"},
    "LAUNCH": {"category": "User", "input": "Configuration, session and workspace", "output": "New run", "detail": "Confirmation policy: unspecified"},
    "EXECUTE": {"category": "Agent", "input": "Issue, configured prompt and skills", "output": "Actions and execution events", "detail": "Provider and execution limits: selected per run / unspecified"},
    "LIVE": {"category": "Laomedo", "input": "Execution events", "output": "Inspectable graph and trace", "detail": "Retention: unspecified"},
    "INSPECT": {"category": "User", "input": "Stage card", "output": "Telemetry inspection", "detail": "Action: click a card"},
    "BUILD": {"category": "Laomedo", "input": "Run actions and results", "output": "Run record, digest and artifact references", "detail": "Record configuration, trace, status and summary; outputs may live elsewhere"},
    "DIGEST": {"category": "Laomedo", "input": "Run actions", "output": "Expandable action records", "detail": "Includes tool calls, searches, edits and shell commands"},
    "SUMMARY": {"category": "Laomedo", "input": "Completed or stopped run", "output": "Semi-structured summary", "detail": "List artifact type, location and saved/published state; schema remains draft"},
    "STORE": {"category": "User", "input": "Findings in run summary", "output": "Selected findings for storage", "detail": "Optional; GitHub publication is separate"},
    "KNOWLEDGE": {"category": "Laomedo", "input": "Selected findings", "output": "Durable project knowledge", "detail": "Source/run links; storage and retention unspecified"},
    "OUTCOME": {"category": "Laomedo"},
    "PR": {"category": "Agent", "input": "Changes and existing PR when applicable", "output": "Created or updated PR", "detail": "Success: PR available; publication failures remain unspecified"},
    "PRDOC": {"category": "External service", "input": "Published changes", "output": "GitHub PR and review context", "detail": "Storage: user's GitHub repository"},
    "REVIEW": {"category": "User", "input": "PR and run results", "output": "Review and follow-up choice", "detail": "Choices: no further run or address comments"},
    "END": {"category": "User", "input": "No further run requested", "output": "Traversal ends", "detail": "PR merge behavior unspecified"},
    "FOLLOW": {"category": "User", "input": "Existing PR and session options", "output": "Follow-up session selection", "detail": "Choices: existing session or new session"},
    "RERUN": {"category": "Laomedo", "input": "Existing PR and chosen session", "output": "New linked run", "detail": "Same PR; separate trace, digest and summary"},
    "ADDRESS": {"category": "Agent", "input": "PR reference and comment hint", "output": "Review-response work", "detail": "Agent retrieves comments; exact skill/prompt selected per run"},
    "REPEAT": {"category": "Laomedo", "input": "Follow-up run", "output": "Execution and inspection path", "detail": "Carry PR/run links; stopping limits unspecified"},
    "FAILURE": {"category": "Laomedo", "input": "Unsuccessful run", "output": "Failure report", "detail": "Completed work, blocker, evidence and remaining work"},
    "DRAFT": {"category": "Laomedo", "input": "Failure report", "output": "Issue draft", "detail": "Publishing requires user review/editing"},
    "DRAFTDOC": {"category": "Laomedo", "input": "Failure report conversion", "output": "Editable issue proposal", "detail": "Not yet published; retention unspecified"},
    "EDIT": {"category": "User", "input": "Issue draft", "output": "Reviewed and published issue", "detail": "Review and editing before publication"},
    "ISSUE": {"category": "External service", "input": "Reviewed issue proposal", "output": "Published follow-up issue", "detail": "Carries previous run context and evidence"},
    "NEXT": {"category": "User", "input": "Follow-up issue", "output": "Normal issue execution path", "detail": "Agent/session/skills selected normally"},
    "LIBRARY": {"category": "User", "input": "Prompts and skills", "output": "Curated library changes", "detail": "Agents can also edit; native or GitHub backend"},
    "LIBDOC": {"category": "Laomedo", "input": "Curated prompts and skills", "output": "Selectable library entries", "detail": "Backend: native or GitHub; version/access policy unspecified"},
    "PUBLISH": {"category": "User"},
    "LIBPR": {"category": "Agent", "input": "Library edits and GitHub backend", "output": "Library PR", "detail": "Default review path; user can publish too"},
    "LIBDIRECT": {"category": "Agent", "input": "Library edits and review-disabled setting", "output": "Updated GitHub branch", "detail": "Explicitly configured option; user can publish too"}
  }
}
