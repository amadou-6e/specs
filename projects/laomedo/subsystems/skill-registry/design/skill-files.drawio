<mxfile host="app.diagrams.net">
  <diagram name="Skill files panel" id="skill-files">
    <mxGraphModel dx="1500" dy="1050" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1050">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="SF01" value="SF01: Laomedo Skill node&#10;Skill ID + exact revision&#10;[Skill files] replaces primary &lt;&gt; Code" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="30" y="30" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="SF03" value="SF03: Skill files  |  Read only                          [Close]&#10;live-report  |  sha256:&lt;full selected immutable revision&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="350" y="30" width="1090" height="85" as="geometry" />
        </mxCell>
        <mxCell id="SF04" value="SF04: Explorer&#10;Folder: live-report&#10;  SKILL.md&#10;  to references&#10;    examples.md&#10;  to scripts&#10;&#10;Expand/collapse folders.&#10;Select file to open tab." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="350" y="120" width="245" height="440" as="geometry" />
        </mxCell>
        <mxCell id="tabs" value="SF04: [SKILL.md close] [examples.md close]&#10;Close tab to another open tab; last tab to choose a file." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="600" y="120" width="840" height="65" as="geometry" />
        </mxCell>
        <mxCell id="SF05" value="SF05: [Source] [Preview if Markdown]&#10;Locally bundled Monaco, read-only syntax highlighting, search.&#10;No save, edit, terminal or execute action.&#10;&#10;SF06: Markdown Preview: raw HTML skipped, remote images suppressed.&#10;Links shown as text. No scripts/commands run.&#10;Escape closes search first; otherwise closes the panel." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="600" y="190" width="840" height="280" as="geometry" />
        </mxCell>
        <mxCell id="SF08" value="SF08: Binary selection&#10;relative path | bytes | file hash&#10;Preview unavailable for binary files. No download/run action." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="600" y="475" width="840" height="85" as="geometry" />
        </mxCell>
        <mxCell id="SF02" value="SF02: Open to capture node Skill ID/revision to authenticated GET.&#10;No graph execution/model turn. Verify exact registry bytes first." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="350" y="580" width="1090" height="80" as="geometry" />
        </mxCell>
        <mxCell id="SF07" value="SF07 Loading: Loading selected skill revision...&#10;Error: fixed category + [Retry]. No stale contents after selection change.&#10;Missing/invalid/corrupt/unsafe/oversized all refuse.&#10;Empty viewer: Select a file. Retry uses same pinned selection." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="350" y="680" width="1090" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
<diagram name="Skill operations and history" id="skill-operations-history"><mxGraphModel page="1" pageWidth="1500" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="SO01" value="SO01 User | Skill node&#10;Source / Skill / Revision&#10;Base Commit (advanced)&#10;Edit Request&#10;Operation input: ordinary or Agent feedback&#10;Outputs: Skill Reference / Task / Operation Result" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=#64748b;"><mxGeometry x="30" y="30" width="430" height="220" as="geometry" /></mxCell><mxCell id="SO02" value="SO02 Agent | Existing Codex Agent&#10;IN: Task + exact skill snapshot and host policy&#10;OUT: modify, message, files[]&#10;Task → Agent → same Skill Operation&#10;One turn; no canonical promotion" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#eff6ff;strokeColor=#64748b;"><mxGeometry x="510" y="30" width="450" height="220" as="geometry" /></mxCell><mxCell id="SO03" value="SO03 Laomedo | Atomic proposal&#10;Validate every changed file&#10;Store immutable candidate and one commit&#10;Record policy + adapter run provenance&#10;Canonical/source files remain unchanged" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#f0fdf4;strokeColor=#64748b;"><mxGeometry x="1010" y="30" width="450" height="220" as="geometry" /></mxCell><mxCell id="SH01" value="SH01 User | Skill files                                      [Close]&#10;Current: skill ID + full immutable revision captured on open&#10;One workspace: file tree and commit graph left; source or selected-file comparison right. No Files/History mode buttons." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#e2e8f0;strokeColor=#64748b;"><mxGeometry x="30" y="300" width="1430" height="90" as="geometry" /></mxCell><mxCell id="SH02" value="SH02 - Files and commits&#10;Independent collapsible sections.&#10;Compact chevron headers + three dots.&#10;Either uses remaining column height.&#10;Preserve selection and scroll state.&#10;Section actions: expand only / both.&#10;Column actions: hide / reset width." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=#64748b;"><mxGeometry x="30" y="500" width="310" height="250" as="geometry" /></mxCell><mxCell id="SH03" value="SH03 - Selected file comparison&#10;Click commit: inline selected-file diff to current.&#10;Same old/new number: one index; otherwise both.&#10;Absent index: blank. Shifted context: both indexes.&#10;Digit-sized indexes + 4 px; divider and header rule.&#10;Dedicated 24 px signs: bold, high-contrast +/minus.&#10;Short current hash; full identity on hover.&#10;Switch file: retain selected commit; no raw patch.&#10;Added/deleted: explicit rows; binary: metadata.&#10;Details: backend-asserted provenance." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=#64748b;"><mxGeometry x="370" y="500" width="1090" height="250" as="geometry" /></mxCell><mxCell id="SH04" value="SH04 Laomedo | Loading and failure&#10;Loading commits / comparison; clear previous content on selection change&#10;History unavailable or Comparison unavailable with Retry; empty history is explicit.&#10;Files remain usable if history is unavailable. Browsing/comparing/resizing never runs an Agent or edits a skill." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#fff7ed;strokeColor=#64748b;"><mxGeometry x="30" y="860" width="1430" height="120" as="geometry" /></mxCell><mxCell id="SH05-handle" value="" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#94a3b8;strokeColor=#64748b;"><mxGeometry x="347" y="500" width="8" height="250" as="geometry" /></mxCell><mxCell id="SH05" value="SH05 | Resize or collapse navigation&#10;Drag below 90 px: collapse to 0; otherwise 180-600 px bounded to editor space. Persistent divider + Show navigation restore. Double-click toggle; Home collapse; End maximum; arrows resize/restore." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#f1f5f9;strokeColor=#64748b;"><mxGeometry x="30" y="770" width="1430" height="80" as="geometry" /></mxCell><mxCell id="SH06" value="SH06 | Complete purpose summary [disclosure]&#10;Top/bottom dividers only; no frame. Summary always visible, wraps fully.&#10;Details initially collapsed; click or Enter/Space toggles revision-local full docs and images." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="30" y="400" width="1430" height="80" as="geometry" /></mxCell><mxCell id="SH06-top" value="" style="shape=line;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="400" width="1430" height="1" /></mxCell><mxCell id="SH06-bottom" value="" style="shape=line;strokeColor=#64748b;" vertex="1" parent="1"><mxGeometry as="geometry" x="30" y="480" width="1430" height="1" /></mxCell></root></mxGraphModel></diagram><diagram name="Skill navigation states" id="skill-navigation-states"><mxGraphModel page="1" pageWidth="1500" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="SH07-0" value="SH07-A Both expanded&#10;&#10;SKILL                         [...]&#10;FILES [v]                     [...]&#10;File tree (half available height)&#10;COMMITS [v]                   [...]&#10;Commit graph (remaining height)" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;"><mxGeometry as="geometry" x="30" y="40" width="460" height="340" /></mxCell><mxCell id="SH07-1" value="SH07-B One expanded&#10;&#10;SKILL                         [...]&#10;FILES [&gt;]                     [...]&#10;COMMITS [v]                   [...]&#10;Commit graph fills remaining height.&#10;Inverse: collapse Commits for Files." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;"><mxGeometry as="geometry" x="520" y="40" width="460" height="340" /></mxCell><mxCell id="SH07-2" value="SH07-C Column collapsed&#10;&#10;[Show navigation] | Source / diff&#10;Divider remains grabbable at left.&#10;Drag right or Show restores width.&#10;File and commit selections preserved.&#10;Double-click divider toggles." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;"><mxGeometry as="geometry" x="1010" y="40" width="460" height="340" /></mxCell><mxCell id="SH07-actions" value="Three-dot actions&#10;Files/Commits: Expand only this section; Expand both sections.&#10;SKILL: Hide navigation; Reset navigation width. Native disclosure buttons support keyboard focus.&#10;Summary remains above this workspace. All navigation is read-only; no model or registry writes.&#10;Escape/outside: dismiss; Escape focuses trigger. Restore focuses separator. Foreground contrast, labels fit." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;"><mxGeometry as="geometry" x="30" y="430" width="1440" height="240" /></mxCell></root></mxGraphModel></diagram></mxfile>