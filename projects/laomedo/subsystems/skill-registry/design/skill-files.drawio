        <mxCell id="SH10-label-file" value="unknown.ext · generic file" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacingLeft=8;">
