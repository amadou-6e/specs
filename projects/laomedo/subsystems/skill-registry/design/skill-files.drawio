<mxfile host="app.diagrams.net">
  <diagram name="Skill files panel" id="skill-files">
    <mxGraphModel dx="1500" dy="1050" grid="1" gridSize="10" page="1" pageWidth="1500" pageHeight="1050">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="SF01" value="SF01: Laomedo Skill node&#10;Skill ID + exact revision&#10;[Skill files] replaces primary &lt;&gt; Code" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="30" y="30" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="SF03" value="SF03: Skill files  |  Read only                          [Close]&#10;live-report  |  sha256:&lt;full selected immutable revision&gt;" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="350" y="30" width="1090" height="85" as="geometry" />
        </mxCell>
        <mxCell id="SF04" value="SF04: Explorer&#10;Folder: live-report&#10;  SKILL.md&#10;  to references&#10;    examples.md&#10;  to scripts&#10;&#10;Expand/collapse folders.&#10;Select file to open tab." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="350" y="120" width="245" height="440" as="geometry" />
        </mxCell>
        <mxCell id="tabs" value="SF04: [SKILL.md close] [examples.md close]&#10;Close tab to another open tab; last tab to choose a file." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="600" y="120" width="840" height="65" as="geometry" />
        </mxCell>
        <mxCell id="SF05" value="SF05: [Source] [Preview if Markdown]&#10;Locally bundled Monaco, read-only syntax highlighting, search.&#10;No save, edit, terminal or execute action.&#10;&#10;SF06: Markdown Preview: raw HTML skipped, remote images suppressed.&#10;Links shown as text. No scripts/commands run.&#10;Escape closes search first; otherwise closes the panel." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="600" y="190" width="840" height="280" as="geometry" />
        </mxCell>
        <mxCell id="SF08" value="SF08: Binary selection&#10;relative path | bytes | file hash&#10;Preview unavailable for binary files. No download/run action." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="600" y="475" width="840" height="85" as="geometry" />
        </mxCell>
        <mxCell id="SF02" value="SF02: Open to capture node Skill ID/revision to authenticated GET.&#10;No graph execution/model turn. Verify exact registry bytes first." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="350" y="580" width="1090" height="80" as="geometry" />
        </mxCell>
        <mxCell id="SF07" value="SF07 Loading: Loading selected skill revision...&#10;Error: fixed category + [Retry]. No stale contents after selection change.&#10;Missing/invalid/corrupt/unsafe/oversized all refuse.&#10;Empty viewer: Select a file. Retry uses same pinned selection." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#64748b;fontColor=#172033;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=14;">
          <mxGeometry x="350" y="680" width="1090" height="120" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
<diagram name="Skill operations and history" id="skill-operations-history"><mxGraphModel page="1" pageWidth="1500" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="SO01" value="SO01 User | Skill node&#10;Source / Skill / Revision&#10;Base Commit (advanced)&#10;Edit Request&#10;Operation input: ordinary or Agent feedback&#10;Outputs: Skill Reference / Task / Operation Result" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=#64748b;"><mxGeometry x="30" y="30" width="430" height="220" as="geometry" /></mxCell><mxCell id="SO02" value="SO02 Agent | Existing Codex Agent&#10;IN: Task + exact skill snapshot and host policy&#10;OUT: modify, message, files[]&#10;Task → Agent → same Skill Operation&#10;One turn; no canonical promotion" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#eff6ff;strokeColor=#64748b;"><mxGeometry x="510" y="30" width="450" height="220" as="geometry" /></mxCell><mxCell id="SO03" value="SO03 Laomedo | Atomic proposal&#10;Validate every changed file&#10;Store immutable candidate and one commit&#10;Record policy + adapter run provenance&#10;Canonical/source files remain unchanged" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#f0fdf4;strokeColor=#64748b;"><mxGeometry x="1010" y="30" width="450" height="220" as="geometry" /></mxCell><mxCell id="SH01" value="SH01 User | Skill files                         [Close]&#10;Selected skill + exact tree revision&#10;[Files] [History]&#10;Opening or switching tabs never executes the graph." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#e2e8f0;strokeColor=#64748b;"><mxGeometry x="30" y="300" width="1430" height="110" as="geometry" /></mxCell><mxCell id="SH02" value="SH02 User | History list&#10;Message / timestamp / commit&#10;Tree revision / changed paths&#10;[View diff] per commit&#10;[Load older] when another page exists&#10;Imported root shown as Import&#10;Selected revision stays pinned." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=#64748b;"><mxGeometry x="30" y="440" width="430" height="230" as="geometry" /></mxCell><mxCell id="SH03" value="SH03 Laomedo | Selected commit diff&#10;Full commit ID + parent + tree revision&#10;Change message / timestamp&#10;Editor: operator or Agent run/thread/trace when available&#10;Agent provenance: backend-asserted, not runner-verified&#10;Policy reference and changed paths&#10;Read-only unified diff from exact parent/current bytes&#10;Imported root: No file changes (import)." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=#64748b;"><mxGeometry x="510" y="440" width="950" height="230" as="geometry" /></mxCell><mxCell id="SH04" value="SH04 Laomedo | Loading and failure&#10;Loading history / Loading diff; clear previous content on selection change&#10;History unavailable or Diff unavailable with Retry&#10;No commits: No operation history for this skill.&#10;Files view remains usable when history service is unavailable." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#fff7ed;strokeColor=#64748b;"><mxGeometry x="30" y="710" width="1430" height="160" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>