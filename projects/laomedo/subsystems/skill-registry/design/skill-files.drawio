          <mxGeometry x="53" y="726" width="287" height="23" as="geometry" />
        </mxCell>
        <mxCell id="SH03" value="SH03 - Selected file comparison&#10;Click commit: inline selected-file diff to current.&#10;Same old/new number: one index; otherwise both.&#10;Absent index: blank. Shifted context: both indexes.&#10;Digit-sized indexes + 4 px; divider and header rule.&#10;Dedicated 24 px signs: bold, high-contrast +/minus.&#10;Short current hash; full identity on hover.&#10;Switch file: retain selected commit; no raw patch.&#10;Added/deleted: explicit rows; binary: metadata.&#10;Details: backend-asserted provenance." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#ffffff;strokeColor=#64748b;">
          <mxGeometry x="370" y="500" width="1090" height="250" as="geometry" />
        </mxCell>
        <mxCell id="SH04" value="SH04 Laomedo | Loading and failure&#10;Loading commits / comparison; clear previous content on selection change&#10;History unavailable or Comparison unavailable with Retry; empty history is explicit.&#10;Files remain usable if history is unavailable. Browsing/comparing/resizing never runs an Agent or edits a skill." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#fff7ed;strokeColor=#64748b;">
          <mxGeometry x="30" y="860" width="1430" height="120" as="geometry" />
        </mxCell>
        <mxCell id="SH05-handle" value="" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#94a3b8;strokeColor=#64748b;">
          <mxGeometry x="347" y="500" width="8" height="250" as="geometry" />
        </mxCell>
        <mxCell id="SH05" value="SH05 | Resize or collapse navigation&#10;Drag below 90 px: collapse to 0; otherwise 180-600 px bounded to editor space. Persistent divider + Show navigation restore. Double-click toggle; Home collapse; End maximum; arrows resize/restore." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fontFamily=Arial;fontSize=16;fillColor=#f1f5f9;strokeColor=#64748b;">
          <mxGeometry x="30" y="770" width="1430" height="80" as="geometry" />
        </mxCell>
        <mxCell id="SH06" value="SH06 | Complete purpose summary [disclosure]&#10;Top/bottom dividers only; no frame. Summary always visible, wraps fully.&#10;Details initially collapsed; click or Enter/Space toggles revision-local full docs and images." style="rounded=0;whiteSpace=wrap;html=0;fillColor=none;strokeColor=none;" vertex="1" parent="1">
