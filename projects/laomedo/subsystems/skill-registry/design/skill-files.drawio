        </mxCell>
        <mxCell id="SH13-unsaved" value="Unsaved changes · close/discard confirmation" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#cbd5e1;fontColor=#172033;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry x="750" y="644" width="710" height="36" as="geometry" />
        </mxCell>
        <mxCell id="SH13-unsaved-text" value="Keep editing retains text. Discard removes only working edits and opens the journal head, never deleting an already-saved immutable commit or altering registry current. Close with unsaved work asks first." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172033;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry x="750" y="684" width="710" height="68" as="geometry" />
        </mxCell>
        <mxCell id="SH13-keep" value="Keep editing" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172033;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry x="750" y="762" width="160" height="32" as="geometry" />
        </mxCell>
        <mxCell id="SH13-discard" value="Discard changes" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172033;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry x="1270" y="762" width="190" height="32" as="geometry" />
        </mxCell>
        <mxCell id="SH13-busy" value="Publishing: spinner; save then promotion; controls locked until confirmed result. Check result reconciles exact pending stage." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#cbd5e1;fontColor=#172033;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry x="750" y="818" width="710" height="36" as="geometry" />
        </mxCell>
        <mxCell id="SH13-error" value="Failure retains text or the saved candidate. Unknown outcomes: Check result with exact identity. Definitive failure: correct/retry Publish or Discard to reload journal head. A saved candidate remains traceable if publication fails." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#fee2e2;strokeColor=#cbd5e1;fontColor=#172033;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry x="750" y="862" width="710" height="80" as="geometry" />
        </mxCell>
        <mxCell id="SH11-rules" value="SH11: Replace textual Full page / Restore window with 16 px maximize/restore icons in 32 px buttons. Keep those accessible names, tooltips, keyboard activation, focus trap and same-dialog state. Use VS Code Seti Markdown glyph E060 from bundled licensed font, the same 150% scale and light/dark theme colors. Keep Codicon arrows. SH12: Find is a nested folder → file → matching-line tree; folder/file buttons have aria-expanded and counts, independent collapse state retained across typing and section hiding. Global Open/Collapse all includes search groups. Literal current-working-copy text search, bounded to 500 matching lines; choosing a match opens current source, not historical comparison." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172033;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="972" width="1440" height="78" as="geometry" />
        </mxCell>
        <mxCell id="SH13-rules" value="SH13: Always-editable text at journal head when local grants and versioned policy permit; otherwise read-only. Open journal head automatically without changing saved graph pins. One-line Skill ID + short SHA, no description paragraph or Edit/Review/Open latest controls. Dirty-only bottom-right Discard and Publish, optional commit message. Publish saves all changed files atomically then promotes exact saved commit by CAS with policy revalidation. Keep uncertain stage identity; never blindly retry with a new UUID/base. On definitive promotion failure keep candidate reachable and allow correction/retry; Discard never erases history. New edits after failed promotion produce a new commit. No model, Git or source writes. Binary editing and durable crash restoration unsupported. Actual browser, independent review and owner validation required. Before Publish, footer lists/counts full cumulative changed files including earlier saved changes; choosing one shows its registry diff. Publish waits for comparison. Retain SH06 summary/overview. Show graph pin hint only when different. Default message: Update Skill files; provenance operator." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172033;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=8;">
          <mxGeometry x="20" y="1062" width="1440" height="78" as="geometry" />
        </mxCell>
        <mxCell id="SH13-dialog-error" value="SH13 error cards: bottom-right screen bounds; inside the active dialog interaction boundary. Dismiss, Copy and Escape remain keyboard/pointer reachable; Escape dismisses the card without closing the Skill or losing buffers. Background global notifications remain hidden while a modal is open and reappear afterward; they never cover Publish." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=none;fontColor=#172033;fontFamily=Arial;fontSize=12;align=left;verticalAlign=middle;spacing=6;">
          <mxGeometry x="20" y="942" width="1440" height="28" as="geometry" />
        </mxCell>
        <mxCell id="SH13-retry-controls" value="Footer: Retry edit controls / Retry comparison when needed; Check result on uncertain outcome." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172033;fontFamily=Arial;fontSize=12;align=left;verticalAlign=middle;spacing=6;">
          <mxGeometry x="750" y="798" width="710" height="18" as="geometry" />
        </mxCell>
      <mxCell id="SH13-edit-discard" value="Discard" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#cbd5e1;fontColor=#172033;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1236" y="558" width="100" height="32" as="geometry" /></mxCell><mxCell id="SH13-source-summary" value="Propose a PR operation.   Overview (expand)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172033;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="32" y="174" width="686" height="28" as="geometry" /></mxCell><mxCell id="SH13-edit-summary" value="Propose a PR operation.   Overview (expand)" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172033;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="762" y="174" width="686" height="28" as="geometry" /></mxCell><mxCell id="SH13-view-toggle-rules" value="No Source/Preview/bytes bar. Markdown text only: one fixed icon beside scrollable tabs; Preview Markdown / Show source (tooltip and accessible name). Pressed = preview. Pointer, Enter and Space preserve unsaved text. Other file types keep their existing source/binary view. Find result or Ctrl+F returns to source. Show source also applies read-only. SH13 supersedes older toolbar drawings; byte count removed with the row." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172033;fontFamily=Arial;fontSize=13;align=left;verticalAlign=middle;spacing=8;"><mxGeometry x="20" y="1152" width="1440" height="86" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
