<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="skill-source-selection" name="Skill source selection">
    <mxGraphModel dx="1200" dy="1000" grid="1" page="1" pageWidth="1200" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="SS01" value="SS01: Skill source&#10;Repository URL or local folder link/path&#10;[ Source location (refresh on change)     ]&#10;Source path/URL | loading | fixed access error" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="40" width="520" height="150" />
        </mxCell>
        <mxCell id="SS02" value="SS02: Skill&#10;[ Type to filter discovered skills        v ]&#10;Matching skill name | relative folder&#10;Choose an existing result | Refresh list&#10;Empty source and no matches are separate states" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="210" width="520" height="180" />
        </mxCell>
        <mxCell id="SS03" value="SS03: Revision&#10;[ Type to filter discovered revisions     v ]&#10;Source label if available | immutable bundle revision&#10;Choose a verified discovered revision&#10;No arbitrary typed value becomes an accepted reference" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="410" width="520" height="180" />
        </mxCell>
        <mxCell id="SS04" value="SS04: Selection dependencies&#10;Source changed: clear Skill and Revision&#10;Skill changed: clear Revision&#10;Ignore obsolete discovery responses&#10;Do not silently substitute a newer revision" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="40" width="530" height="180" />
        </mxCell>
        <mxCell id="SS05" value="SS05: Discovery states&#10;Loading / source empty / no filter matches&#10;Access failed / revision unavailable&#10;Visible fixed error + refresh/retry&#10;No model turn, script execution or hidden fallback" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="240" width="530" height="170" />
        </mxCell>
        <mxCell id="SS06" value="SS06: Resolved selection&#10;Skill Reference retains exact skill_id, revision_id and tree_hash&#10;[Skill files] opens the selected immutable bundle&#10;Runner verifies/materializes its bytes before dispatch&#10;Repository commit and skill-bundle hash are distinct identities" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="620" width="1100" height="140" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
<diagram id="skill-node-settings" name="SS07 Compact Skill node settings"><mxGraphModel page="1" pageWidth="1350" pageHeight="1050"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="SS07-title" value="PROPOSED SS07 - compact Skill node controls" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#cbd5e1;fontColor=#172033;fontSize=18;fontFamily=Arial;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="20" y="20" width="1310" height="45" as="geometry" /></mxCell><mxCell id="SS07-closed" value="Laomedo Skill&#10;Use and edit versioned skill files.&#10;&#10;Source                              (i)&#10;[ Repository URL or local folder ]&#10;&#10;Skill&#10;[ Select an option                       v ]&#10;&#10;Operation                         [input]&#10;&#10;&gt; Advanced settings&#10;&#10;Skill Reference / Task / Operation Result" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172033;fontSize=14;fontFamily=Arial;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="25" y="90" width="420" height="610" as="geometry" /></mxCell><mxCell id="SS07-open" value="Laomedo Skill&#10;Use and edit versioned skill files.&#10;&#10;Source / Skill / Operation&#10;&#10;v Advanced settings&#10;&#10;Revision                             (i)&#10;[ Choose an exact revision            v ]&#10;&#10;Base Commit                       (i)&#10;[ Exact parent commit                    ]&#10;&#10;Skill Reference / Task / Operation Result" vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#172033;fontSize=14;fontFamily=Arial;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="470" y="90" width="420" height="610" as="geometry" /></mxCell><mxCell id="SS07-help" value="Source help&#10;Public HTTPS GitHub/GitLab repository URL, or an allowed local folder containing SKILL.md files. Leave empty to use a saved registry reference.&#10;&#10;Source states&#10;Empty Source: no message, Skill says No source found.&#10;Discovered choices: Skill says Select an option; no success message.&#10;Failure: fixed error directly below Source, without a Discovery heading.&#10;Scanning never runs a Skill or changes a selected revision.&#10;&#10;Revision help&#10;The exact file version to use. Choose a discovered revision; refreshing never selects a newer version." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172033;fontSize=14;fontFamily=Arial;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="915" y="90" width="415" height="610" as="geometry" /></mxCell><mxCell id="SS07-transitions" value="Advanced settings starts collapsed; click or Enter/Space expands/collapses it.&#10;Revision and Base Commit remain mounted; values/options/refresh survive disclosure.&#10;No Edit Request control on the Skill card or its settings. New changes arrive through Operation, or manual editing and Publish in Skill files. Existing saved feedback requests are compatibility data only, never a new visible prompt.&#10;Saved revision stays exact. Changing Source clears Skill/Revision; changing Skill clears Revision. Open Advanced settings to choose the replacement revision. No Discovery row; source failures appear below Source.&#10;Operation and every connected input remain on the ordinary canvas path. Minimized nodes hide the disclosure.&#10;Existing Skill files/history/manual publication are unchanged. No graph or model dispatch from selecting/toggling controls." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172033;fontSize=14;fontFamily=Arial;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="20" y="725" width="1310" height="210" as="geometry" /></mxCell><mxCell id="SS07-acceptance" value="Actual browser: legacy saved pin retained, no Edit Request, Revision/Base Commit inside keyboard-operable disclosure; repeated toggle retains selection. Source change clears old selection; skill change requires exact revision in Advanced settings; empty Source has no message, successful discovery supplies Skill choices, and failures appear below Source with refresh recovery. Real source selection opens exact files without Agent execution. Normal/narrow and Light/Dark stay usable." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontColor=#172033;fontSize=14;fontFamily=Arial;align=left;verticalAlign=top;spacing=10;"><mxGeometry x="20" y="950" width="1310" height="85" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>