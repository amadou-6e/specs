  <diagram name="Typography rules">
    <mxGraphModel page="1" pageWidth="960" pageHeight="800" grid="1" gridSize="8">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="style-title-39" value="&lt;div style=&quot;line-height:22px;&quot;&gt;Recovery panel / typography rules&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=16;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
