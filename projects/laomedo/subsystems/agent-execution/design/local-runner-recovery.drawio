        <mxCell id="family-title-40" value="&lt;div style=&quot;line-height:22px;&quot;&gt;One font family&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="110" width="250" height="22" as="geometry" />
        </mxCell>
        <mxCell id="family-41" value="&lt;div style=&quot;line-height:22px;&quot;&gt;Inter throughout; the same Arial/sans-serif fallback applies to every cell.&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
