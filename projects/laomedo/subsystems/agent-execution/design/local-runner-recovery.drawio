  <diagram name="Typography rules">
    <mxGraphModel page="1" pageWidth="960" pageHeight="800" grid="1" gridSize="8">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="style-title-39" value="&lt;div style=&quot;line-height:22px;&quot;&gt;Recovery panel / typography rules&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="48" width="832" height="24" as="geometry" />
        </mxCell>
        <mxCell id="family-title-40" value="&lt;div style=&quot;line-height:22px;&quot;&gt;One font family&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="110" width="250" height="22" as="geometry" />
        </mxCell>
        <mxCell id="family-41" value="&lt;div style=&quot;line-height:22px;&quot;&gt;Inter throughout; the same Arial/sans-serif fallback applies to every cell.&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="64" y="142" width="832" height="44" as="geometry" />
        </mxCell>
        <mxCell id="sizes-title-42" value="&lt;div style=&quot;line-height:22px;&quot;&gt;One size&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="216" width="250" height="22" as="geometry" />
        </mxCell>
        <mxCell id="title-sample-43" value="&lt;div style=&quot;line-height:22px;&quot;&gt;14 px / bold / title and action labels&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="250" width="832" height="24" as="geometry" />
        </mxCell>
        <mxCell id="body-sample-44" value="&lt;div style=&quot;line-height:22px;&quot;&gt;14 px / regular / body text and diagnostics&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="64" y="292" width="832" height="44" as="geometry" />
        </mxCell>
        <mxCell id="label-sample-45" value="&lt;div style=&quot;line-height:22px;&quot;&gt;Use weight and spacing for hierarchy; no extra section headings.&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="338" width="832" height="22" as="geometry" />
        </mxCell>
        <mxCell id="weights-title-46" value="&lt;div style=&quot;line-height:22px;&quot;&gt;Two weights&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="402" width="250" height="22" as="geometry" />
        </mxCell>
        <mxCell id="weights-47" value="&lt;div style=&quot;line-height:22px;&quot;&gt;Regular (400) and bold (700). No uppercase micro-labels, mixed typefaces or smaller footer text.&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="64" y="434" width="832" height="44" as="geometry" />
        </mxCell>
        <mxCell id="spacing-title-48" value="&lt;div style=&quot;line-height:22px;&quot;&gt;One spacing rhythm&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="510" width="250" height="22" as="geometry" />
        </mxCell>
        <mxCell id="spacing-49" value="&lt;div style=&quot;line-height:22px;&quot;&gt;22 px line height. 24 px horizontal panel insets. 8 px between related elements; 16–24 px between groups. Buttons are 36 px tall.&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="64" y="542" width="832" height="44" as="geometry" />
        </mxCell>
        <mxCell id="viewport-title-50" value="&lt;div style=&quot;line-height:22px;&quot;&gt;Viewport and scrolling&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="618" width="250" height="22" as="geometry" />
        </mxCell>
        <mxCell id="viewport-51" value="&lt;div style=&quot;line-height:22px;&quot;&gt;Keep the header and Dismiss visible. Constrain the panel to the available viewport; scroll its body to reach expanded diagnostics. No control or content should extend below the window.&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="64" y="650" width="832" height="66" as="geometry" />
        </mxCell>
        <mxCell id="scope-52" value="&lt;div style=&quot;line-height:22px;&quot;&gt;This proposal does not change application typography or recovery behavior.&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#475569;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="64" y="744" width="832" height="44" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="App connection-error recovery">
    <mxGraphModel page="1" pageWidth="1200" pageHeight="1050">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="offline" value="APP CONNECTION ERROR / shared error presenter&#10;The remote outcome is not confirmed&#10;A connection failed; the operation may still be active.&#10;What to do: inspect its existing run before new work.&#10;&#10;Local runner backend is offline.&#10;[ Restart local backend ] API only; no graph retry.&#10;&gt; Technical details: transport code + safe run/request UUIDs&#10;[Dismiss] / no generic graph Retry" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="520" height="300" as="geometry" />
        </mxCell>
        <mxCell id="starting" value="PENDING / STARTING&#10;Restarting the local runner backend...&#10;[ Restarting local backend... ] disabled&#10;Poll availability; ignore stale pre-click responses.&#10;Dismiss closes the error UI; startup remains API-only." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="640" y="40" width="500" height="190" as="geometry" />
        </mxCell>
        <mxCell id="ready" value="READY / same shared error panel&#10;Local runner backend is online.&#10;Inspect the existing run before new work; no automatic execution.&#10;Exhausted allowance: status and recorded results remain available.&#10;&gt; Technical details: original code + safe run/request UUIDs&#10;Original build error stays until dismissed." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="40" y="370" width="520" height="230" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="FAILED / UNCONFIGURED / UNVERIFIED&#10;Startup failed: host log guidance + explicit API-only retry.&#10;Not configured: ask operator; no button.&#10;Identity/auth mismatch: do not replace listener.&#10;Checking availability failed: explain; no guessed restart." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="640" y="370" width="500" height="190" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="OWNERSHIP AND TRANSITIONS&#10;Entry: actual runner_transport_failed in app error handling. Recovery only inside the app shared presenter, never node popovers, canvas banners or activity controls.&#10;Offline -&gt; explicit click -&gt; starting -&gt; ready or failed. No graph dependency or browser URL.&#10;GET/status and POST/start select the trusted host configuration; explicit legacy URLs remain allowlisted.&#10;Ready + exhausted is different from offline; never reset the ledger, ceiling or credentials.&#10;One shared diagnostic block keeps the code and safe UUIDs; original exception bodies, secrets and startup logs stay private.&#10;Checking: no action until availability is verified. Health timeout -&gt; bounded TCP probe; present/uncertain listener -&gt; no replacement." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fontSize=14;fillColor=#ffffff;strokeColor=#64748b;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="1100" height="280" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>