          <mxGeometry x="64" y="216" width="250" height="22" as="geometry" />
        </mxCell>
        <mxCell id="title-sample-43" value="&lt;div style=&quot;line-height:22px;&quot;&gt;16 px / bold / panel title&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=16;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="250" width="832" height="24" as="geometry" />
        </mxCell>
