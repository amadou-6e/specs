          <mxGeometry x="64" y="292" width="832" height="44" as="geometry" />
        </mxCell>
        <mxCell id="label-sample-45" value="&lt;div style=&quot;line-height:22px;&quot;&gt;14 px / bold / section labels and button text&lt;/div&gt;" style="text;fontFamily=Inter,Arial,sans-serif;fontSize=14;whiteSpace=wrap;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;spacing=0;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="64" y="338" width="832" height="22" as="geometry" />
