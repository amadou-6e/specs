<mxCell id="note" value="Local Git checkout · explicit file save/load&#xa;No automatic commits, pushes or editor synchronization." style="text;html=0;whiteSpace=wrap;fontColor=#a1a1aa;align=left;fontSize=13;" vertex="1" parent="panel"><mxGeometry x="20" y="55" width="600" height="55" as="geometry"/></mxCell>
