<?xml version='1.0' encoding='utf-8'?>
<mxfile>
  <diagram name="Project storage pilot">
    <mxGraphModel page="1" pageWidth="1100" pageHeight="1100">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="panel" value="Project storage" style="swimlane;startSize=42;fillColor=#19191c;swimlaneFillColor=#19191c;fontColor=#eeeeee;strokeColor=#45454b;fontSize=17;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="640" height="900" as="geometry" />
        </mxCell>
        <mxCell id="note" value="Editor changes autosave to Laomedo. Graph files update the app only with Load; completed shell edits save to the repository." style="text;html=0;whiteSpace=wrap;fontColor=#a1a1aa;align=left;fontSize=13;" vertex="1" parent="panel">
          <mxGeometry x="20" y="55" width="600" height="55" as="geometry" />
        </mxCell>
        <mxCell id="repository-name" value="Repository name [My project]" style="rounded=1;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;spacingLeft=12;" vertex="1" parent="panel">
          <mxGeometry x="20" y="120" width="600" height="38" as="geometry" />
        </mxCell>
        <mxCell id="repository-path" value="GitHub repository [owner/repository]" style="rounded=1;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;spacingLeft=12;" vertex="1" parent="panel">
          <mxGeometry x="20" y="168" width="600" height="38" as="geometry" />
        </mxCell>
        <mxCell id="connect" value="Clone repository" style="rounded=1;fillColor=#303036;fontColor=#eeeeee;strokeColor=#45454b;" vertex="1" parent="panel">
          <mxGeometry x="20" y="264" width="170" height="34" as="geometry" />
        </mxCell>
        <mxCell id="agents" value="Agent files&#10;Persistent files available to chat in the normal shell workspace." style="text;whiteSpace=wrap;fontColor=#eeeeee;align=left;fontSize=14;" vertex="1" parent="panel">
          <mxGeometry x="20" y="323" width="600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="agent-repository" value="Repository [My project ▾]" style="rounded=1;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;spacingLeft=12;" vertex="1" parent="panel">
          <mxGeometry x="20" y="383" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="agent-path" value="Folder relative to repository [agent-files]" style="rounded=1;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;spacingLeft=12;" vertex="1" parent="panel">
          <mxGeometry x="290" y="383" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="agent-save" value="Use folder" style="rounded=1;fillColor=#303036;fontColor=#eeeeee;strokeColor=#45454b;" vertex="1" parent="panel">
          <mxGeometry x="20" y="433" width="130" height="34" as="geometry" />
        </mxCell>
        <mxCell id="graphs" value="Graph files&#10;Choose a separate repository and relative JSON file for each graph." style="text;whiteSpace=wrap;fontColor=#eeeeee;align=left;fontSize=14;" vertex="1" parent="panel">
          <mxGeometry x="20" y="493" width="600" height="50" as="geometry" />
        </mxCell>
        <mxCell id="graph" value="Graph [Research workflow ▾]" style="rounded=1;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;spacingLeft=12;" vertex="1" parent="panel">
          <mxGeometry x="20" y="553" width="600" height="38" as="geometry" />
        </mxCell>
        <mxCell id="graph-repository" value="Repository [My project ▾]" style="rounded=1;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;spacingLeft=12;" vertex="1" parent="panel">
          <mxGeometry x="20" y="603" width="260" height="38" as="geometry" />
        </mxCell>
        <mxCell id="graph-path" value="File relative to repository [graphs/research.json]" style="rounded=1;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;spacingLeft=12;" vertex="1" parent="panel">
          <mxGeometry x="290" y="603" width="330" height="38" as="geometry" />
        </mxCell>
        <mxCell id="graph-save" value="Save graph file" style="rounded=1;fillColor=#303036;fontColor=#eeeeee;strokeColor=#45454b;" vertex="1" parent="panel">
          <mxGeometry x="20" y="653" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="graph-load" value="Load graph file" style="rounded=1;fillColor=#303036;fontColor=#eeeeee;strokeColor=#45454b;" vertex="1" parent="panel">
          <mxGeometry x="185" y="653" width="150" height="34" as="geometry" />
        </mxCell>
        <mxCell id="warning" value="Load asks before replacement. Old editors cannot save over a loaded version; reload first. Graph files omit app-managed settings and component code. Ordinary text is exported." style="text;whiteSpace=wrap;fontColor=#a1a1aa;align=left;fontSize=13;" vertex="1" parent="panel">
          <mxGeometry x="20" y="703" width="600" height="75" as="geometry" />
        </mxCell>
        <mxCell id="status" value="Inline status/error with recovery. No success until the operation returns. Busy controls disabled. Close preserves saved locations." style="text;whiteSpace=wrap;fontColor=#a1a1aa;align=left;fontSize=13;" vertex="1" parent="panel">
          <mxGeometry x="20" y="808" width="600" height="75" as="geometry" />
        </mxCell>
        <mxCell id="states" value="Entry: assistant header → Project storage.&#10;Clone validates the selected remote; failure retains repository/name. Token is cleared after submission.&#10;Use folder persists selection.&#10;Save/Load compares observed revisions.&#10;Stale file/app → refresh settings and inspect.&#10;Missing checkout → reconnect/make available.&#10;No repository → agent/graph actions disabled.&#10;Successful load → tell user to reload editor." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="720" y="70" width="340" height="480" as="geometry" />
        </mxCell>
        <mxCell id="read-token" value="Read token [optional, private repositories; used once, never saved]" style="rounded=1;fillColor=#242428;fontColor=#aaaaaa;strokeColor=#45454b;align=left;spacingLeft=12;" vertex="1" parent="panel">
          <mxGeometry x="20" y="216" width="600" height="38" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Storage states and interactions">
    <mxGraphModel page="1" pageWidth="1120" pageHeight="1040">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ST01-open" value="Open storage&#10;&#10;Header folder icon opens modal. Close preserves selections. Empty state: select a repository to clone; graph and folder actions disabled." style="rounded=1;whiteSpace=wrap;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ST02-connected" value="Connected checkouts&#10;&#10;Project | app-owned checkout&#10;Clone fields clear after success. Connections remain listed. Restore missing checkout, or connect another and select it." style="rounded=1;whiteSpace=wrap;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="30" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ST03-busy" value="Working...&#10;&#10;Fields disabled while request runs. No success text before authoritative response. Escape/Close do not discard an active operation." style="rounded=1;whiteSpace=wrap;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="220" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ST04-invalid" value="Choose a normal project path&#10;&#10;Inline error + recovery: use a relative path without links or private files. Form values retained; no automatic retry." style="rounded=1;whiteSpace=wrap;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="220" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ST05-missing" value="Checkout unavailable&#10;&#10;Inline error + recovery: restore its directory, or connect a new checkout and select that location. Existing app graph remains available." style="rounded=1;whiteSpace=wrap;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="410" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ST06-changed" value="The file changed&#10;&#10;Selected saved location appears in the fields. Refresh observes current hash. File changed since last synchronization: Load uses file; Save replaces it with app graph." style="rounded=1;whiteSpace=wrap;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="410" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ST07-load-confirm" value="Replace this saved graph?&#10;&#10;Load requires confirmation. Cancel changes nothing. Confirm compares app/file revisions. Old editor saves are fenced; reload before editing again." style="rounded=1;whiteSpace=wrap;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="600" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ST08-success" value="Graph file saved / loaded&#10;&#10;Inline outcome; omitted settings warning when applicable. Loaded: reload open editor. Prompts and ordinary values enter the repository; review before committing." style="rounded=1;whiteSpace=wrap;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="600" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ST09-agent" value="Agent-files folder selected&#10;&#10;Current repository/folder shown. New chats receive selected files in the normal shell. Completed changes persist with hash checks. Writes need exact observed hash or absence. Selections are frozen per conversation; new settings apply to new chats." style="rounded=1;whiteSpace=wrap;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="30" y="790" width="520" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ST10-rejected" value="Graph file not supported&#10;&#10;Oversized, malformed, wrong-workflow or unsupported graph: no app replacement. Inline recovery asks for a supported portable file. App data stays available." style="rounded=1;whiteSpace=wrap;fillColor=#242428;fontColor=#eeeeee;strokeColor=#45454b;align=left;verticalAlign=top;spacing=16;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="580" y="790" width="520" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>