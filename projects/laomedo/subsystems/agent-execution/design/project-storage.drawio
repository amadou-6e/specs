<mxCell id="warning" value="Loading replaces saved graph contents. Reload open graph editors before editing again. App-managed settings remain in Laomedo; graph files omit secrets and component code." style="text;whiteSpace=wrap;fontColor=#a1a1aa;align=left;fontSize=13;" vertex="1" parent="panel"><mxGeometry x="20" y="655" width="600" height="75" as="geometry"/></mxCell>
<mxCell id="status" value="Inline status/error with recovery. No success until the operation returns. Busy controls disabled. Close preserves saved locations." style="text;whiteSpace=wrap;fontColor=#a1a1aa;align=left;fontSize=13;" vertex="1" parent="panel"><mxGeometry x="20" y="760" width="600" height="75" as="geometry"/></mxCell>
<mxCell id="states" value="Entry: assistant header → Project storage.&#xa;Connect validates checkout; failure retains form.&#xa;Use folder persists selection.&#xa;Save/Load compares observed revisions.&#xa;Stale file/app → refresh settings and inspect.&#xa;Missing checkout → reconnect/make available.&#xa;No repository → agent/graph actions disabled.&#xa;Successful load → tell user to reload editor." style="text;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=14;" vertex="1" parent="1"><mxGeometry x="720" y="70" width="340" height="480" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
