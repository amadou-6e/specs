<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="profile-entry" name="Create and enter a local profile">
    <mxGraphModel grid="1" page="1" pageWidth="1200" pageHeight="2140">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="&lt;b&gt;Local setup profiles&lt;/b&gt;&lt;br&gt;PROPOSED / NOT IMPLEMENTED - one Windows user, no administrator setup" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
