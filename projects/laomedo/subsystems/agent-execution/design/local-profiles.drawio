          <mxGeometry x="435" y="125" width="330" height="45" as="geometry" />
        </mxCell>
        <mxCell id="LP-C03" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="810" y="110" width="360" height="440" as="geometry" />
        </mxCell>
        <mxCell id="LP-C03-title" value="&lt;b&gt;LP-C03 - Log in&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="873" y="125" width="282" height="45" as="geometry" />
        </mxCell>
        <mxCell id="create-fields" value="Profile name&lt;br&gt;[ name ]&lt;br&gt;[ Name error ]&lt;br&gt;&lt;br&gt;PIN (masked, six digits)&lt;br&gt;[ ****** ]&lt;br&gt;[ PIN error ]&lt;br&gt;&lt;br&gt;Confirm PIN (masked)&lt;br&gt;[ ****** ]&lt;br&gt;[ Confirmation error ]" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="175" width="330" height="225" as="geometry" />
        </mxCell>
        <mxCell id="create-error" value="Field errors appear beside inputs.&lt;br&gt;Never display a PIN." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="405" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="create" value="Create profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T01">
          <mxGeometry x="60" y="460" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="create-back" value="Back to profiles" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T04">
          <mxGeometry x="60" y="505" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="picker-body" value="Profiles" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="435" y="175" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="picker-work-icon-head" value="W" style="ellipse;fillColor=#F1F5F9;strokeColor=none;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="446" y="218" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="picker-personal-icon-head" value="P" style="ellipse;fillColor=#F1F5F9;strokeColor=none;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="446" y="282" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="picker-work-name" value="Work" style="text;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="220" width="240" height="32" as="geometry" /></mxCell>
        <mxCell id="picker-personal-name" value="Personal" style="text;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacing=0;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="494" y="284" width="240" height="32" as="geometry" /></mxCell>
        <mxCell id="picker-icon-note" value="Names identify setups on this machine. Initials avatars are decorative. Names align left; whole rows select. A divider separates Create profile." style="text;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="435" y="342" width="330" height="65" as="geometry" /></mxCell>
        <mxCell id="picker-row-separator" value="" style="line;strokeColor=#E2E8F0;" vertex="1" parent="1"><mxGeometry x="435" y="270" width="330" height="1" as="geometry" /></mxCell>
        <mxCell id="picker-create-separator" value="" style="line;strokeColor=#E2E8F0;" vertex="1" parent="1"><mxGeometry x="435" y="415" width="330" height="1" as="geometry" /></mxCell>
        <mxCell id="add" value="+ Create profile" style="text;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=middle;spacing=16;fillColor=none;strokeColor=none;" vertex="1" parent="1" actionRef="LP-T04">
          <mxGeometry x="435" y="425" width="330" height="40" as="geometry" />
        </mxCell>
        <mxCell id="unlock-fields" value="Selected profile: [ name ]&lt;br&gt;&lt;br&gt;PIN (masked, six digits)&lt;br&gt;[ ****** ]&lt;br&gt;&lt;br&gt;Incorrect PIN stays here with Login failed.&lt;br&gt;Rate limiting displays the actual wait." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="825" y="175" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="unlock" value="Log in" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T03">
          <mxGeometry x="840" y="460" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="unlock-back" value="&#8592;" style="text;html=1;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;" vertex="1" parent="1" actionRef="LP-T05"><mxGeometry x="825" y="130" width="36" height="36" as="geometry" /></mxCell>
        <mxCell id="LP-T01" value="&lt;b&gt;LP-T01&lt;/b&gt; Create -&gt; confirmed ordinary profile + matching login -&gt; workspace. Duplicate/reserved -&gt; LP-C08. Confirmed failed save -&gt; LP-C09. Committed creation + unconfirmed login -&gt; LP-C10. Unknown save result -&gt; reconcile picker; never blindly create again. Local field errors show concise catalogue messages beside inputs. Service and save-reconciliation failures show title, explanation and recovery without technical diagnostics. Field errors: Enter a profile name; Use a six-digit PIN; Confirm your PIN; PINs don't match. Associate each error with its field; edits clear relevant advice. Navigation clears previous-screen errors. LP-C12 availability details are unchanged." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="590" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="LP-T02" value="&lt;b&gt;LP-T02&lt;/b&gt; Select a listed profile -&gt; LP-C03. Profile identity alone grants no authenticated session." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="680" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="LP-T03" value="&lt;b&gt;LP-T03&lt;/b&gt; PIN login -&gt; matching ordinary profile session -&gt; LP-C04. Wrong PIN -&gt; Login failed, not PIN creation guidance; 429 -&gt; actual retry wait. Clear PIN after completion; no credential persistence." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="770" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="LP-T04" value="&lt;b&gt;LP-T04&lt;/b&gt; Picker Create -&gt; LP-C01; Back -&gt; populated LP-C02 or empty LP-C07. First run -&gt; LP-C07. No administrator step. Every form masks the PIN and requests numeric entry; browser save/autofill is not required." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="860" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="LP-T05" value="&lt;b&gt;LP-T05&lt;/b&gt; LP-C03 Back -&gt; LP-C02 and clear PIN. Submit shows progress; disable conflicting navigation while a login/create request is pending." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="950" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="entry-policy" value="Six-digit PIN is the proposed initial policy, with upstream hashing and login rate limiting. No email, role selection or OS-account isolation is implied." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="1050" width="1140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="LP-C07" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1140" width="270" height="290" />
        </mxCell>
        <mxCell id="LP-C07-title" value="&lt;b&gt;LP-C07 - No profiles yet&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1150" width="250" height="60" />
        </mxCell>
        <mxCell id="LP-C07-body" value="Create a setup for this machine.&lt;br&gt;No email or administrator required." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1215" width="250" height="140" />
        </mxCell>
        <mxCell id="LP-C07-action" value="Create profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T04">
          <mxGeometry as="geometry" x="45" y="1375" width="240" height="38" />
        </mxCell>
        <mxCell id="LP-C08" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="1140" width="270" height="290" />
        </mxCell>
        <mxCell id="LP-C08-title" value="&lt;b&gt;LP-C08 - Choose another name&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="330" y="1150" width="250" height="60" />
        </mxCell>
        <mxCell id="LP-C08-body" value="This name is unavailable.&lt;br&gt;Use a different profile name.&lt;br&gt;Your profile has not been created." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="330" y="1215" width="250" height="140" />
        </mxCell>
        <mxCell id="LP-C08-action" value="Edit name" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T11">
          <mxGeometry as="geometry" x="335" y="1375" width="240" height="38" />
        </mxCell>
        <mxCell id="LP-C09" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="1140" width="270" height="290" />
        </mxCell>
        <mxCell id="LP-C09-title" value="&lt;b&gt;LP-C09 - Profile was not saved&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="1150" width="250" height="60" />
        </mxCell>
        <mxCell id="LP-C09-body" value="The app confirmed the save failed.&lt;br&gt;Your profile has not been created.&lt;br&gt;Try again when the app is available." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="1215" width="250" height="140" />
        </mxCell>
        <mxCell id="LP-C09-action" value="Back to form" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T11">
          <mxGeometry as="geometry" x="625" y="1375" width="240" height="38" />
        </mxCell>
        <mxCell id="LP-C10" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="900" y="1140" width="270" height="290" />
        </mxCell>
        <mxCell id="LP-C10-title" value="&lt;b&gt;LP-C10 - Profile saved&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="1150" width="250" height="60" />
        </mxCell>
        <mxCell id="LP-C10-body" value="Your profile exists.&lt;br&gt;Sign-in could not be confirmed.&lt;br&gt;Enter the PIN to open it.&lt;br&gt;Do not create the profile again." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="910" y="1215" width="250" height="140" />
        </mxCell>
        <mxCell id="LP-C10-action" value="Open existing profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T12">
          <mxGeometry as="geometry" x="915" y="1375" width="240" height="38" />
        </mxCell>
        <mxCell id="LP-T11" value="&lt;b&gt;LP-T11&lt;/b&gt; LP-C08/09 -&gt; LP-C01; preserve only the non-secret name, clear PIN fields. Unknown creation result remains pending reconciliation: list matching profiles, then enter existing profile or offer a new form only after absence is confirmed." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1460" width="1140" height="85" />
        </mxCell>
        <mxCell id="LP-T12" value="&lt;b&gt;LP-T12&lt;/b&gt; LP-C10 -&gt; LP-C03 for the committed identity; no creation replay. Failure controls are disabled while reconciling. All errors use shared catalogue presentation; no submitted PIN or raw validation payload." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1555" width="1140" height="85" />
        </mxCell>
        <mxCell id="LP-C11" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1700" width="360" height="255" />
        </mxCell>
        <mxCell id="LP-C11-title" value="&lt;b&gt;LP-C11 - Loading profiles&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="1710" width="330" height="65" />
        </mxCell>
        <mxCell id="LP-C11-body" value="[ throbber ] Loading profiles...&lt;br&gt;No failure advice while checking." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="1775" width="330" height="110" />
        </mxCell>
        <mxCell id="LP-C12" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="420" y="1700" width="360" height="255" />
        </mxCell>
        <mxCell id="LP-C12-title" value="&lt;b&gt;LP-C12 - Profiles could not be loaded&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="435" y="1710" width="330" height="65" />
        </mxCell>
        <mxCell id="LP-C12-body" value="The app could not read saved profiles.&lt;br&gt;Check the local app, then reload.&lt;br&gt;Shared safe technical details." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="435" y="1775" width="330" height="110" />
        </mxCell>
        <mxCell id="LP-C12-reload" value="Reload profiles" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T17">
          <mxGeometry as="geometry" x="450" y="1900" width="300" height="38" />
        </mxCell>
        <mxCell id="LP-C13" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="810" y="1700" width="360" height="255" />
        </mxCell>
        <mxCell id="LP-C13-title" value="&lt;b&gt;LP-C13 - Browser cannot manage profiles&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="825" y="1710" width="330" height="65" />
        </mxCell>
        <mxCell id="LP-C13-body" value="Required coordination features are unavailable.&lt;br&gt;Use a supported local browser setup.&lt;br&gt;Existing profile data is preserved." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="825" y="1775" width="330" height="110" />
        </mxCell>
        <mxCell id="LP-C13-reload" value="Reload profiles" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T17">
          <mxGeometry as="geometry" x="840" y="1900" width="300" height="38" />
        </mxCell>
        <mxCell id="LP-T17" value="&lt;b&gt;LP-T17&lt;/b&gt; Initial login/signup -&gt; LP-C11. Explicit backend profile mode false -&gt; existing native page unchanged. Enabled + list success -&gt; LP-C02/07 (signup -&gt; LP-C01). List/read failure -&gt; LP-C12; missing browser features -&gt; LP-C13. Reload -&gt; LP-C11; no registration replay. Replaced/unmounted requests cannot update the next page." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1980" width="1140" height="110" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="profile-switch" name="Switching and session recovery">
    <mxGraphModel grid="1" page="1" pageWidth="1200" pageHeight="1270">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
