<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="profile-entry" name="Create and enter a local profile">
    <mxGraphModel grid="1" page="1" pageWidth="1200" pageHeight="1140">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="&lt;b&gt;Local setup profiles&lt;/b&gt;&lt;br&gt;PROPOSED / NOT IMPLEMENTED - one Windows user, no administrator setup" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="LP-C01" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="360" height="440" as="geometry" />
        </mxCell>
        <mxCell id="LP-C01-title" value="&lt;b&gt;LP-C01 - Create profile&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="125" width="330" height="45" as="geometry" />
        </mxCell>
        <mxCell id="LP-C02" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="360" height="440" as="geometry" />
        </mxCell>
        <mxCell id="LP-C02-title" value="&lt;b&gt;LP-C02 - Choose profile&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="435" y="125" width="330" height="45" as="geometry" />
        </mxCell>
        <mxCell id="LP-C03" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="810" y="110" width="360" height="440" as="geometry" />
        </mxCell>
        <mxCell id="LP-C03-title" value="&lt;b&gt;LP-C03 - Open profile&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="825" y="125" width="330" height="45" as="geometry" />
        </mxCell>
        <mxCell id="create-fields" value="Profile name&lt;br&gt;[ name ]&lt;br&gt;&lt;br&gt;PIN&lt;br&gt;[ 6 digits ]&lt;br&gt;&lt;br&gt;Confirm PIN&lt;br&gt;[ 6 digits ]" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="175" width="330" height="225" as="geometry" />
        </mxCell>
        <mxCell id="create-error" value="Inline validation/duplicate error here.&lt;br&gt;Never echo a PIN." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="405" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="create" value="Create profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T01">
          <mxGeometry x="60" y="460" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="create-back" value="Back to profiles" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T04">
          <mxGeometry x="60" y="505" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="picker-body" value="Profiles&lt;br&gt;&lt;br&gt;[ Work ]&lt;br&gt;&lt;br&gt;[ Personal ]&lt;br&gt;&lt;br&gt;Names identify setups on this machine." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="435" y="175" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="choose" value="Select profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T02">
          <mxGeometry x="450" y="460" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="add" value="Create another profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T04">
          <mxGeometry x="450" y="505" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="unlock-fields" value="Selected profile: [ name ]&lt;br&gt;&lt;br&gt;PIN&lt;br&gt;[ 6 digits ]&lt;br&gt;&lt;br&gt;Wrong PIN stays here with a safe error.&lt;br&gt;Rate limiting displays the actual wait." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="825" y="175" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="unlock" value="Open profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T03">
          <mxGeometry x="840" y="460" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="unlock-back" value="Back to profiles" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T05">
          <mxGeometry x="840" y="505" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="LP-T01" value="&lt;b&gt;LP-T01&lt;/b&gt; Valid name/PIN/confirmation -&gt; create ordinary active profile -&gt; existing login -&gt; confirm matching session -&gt; workspace. If creation committed but login unconfirmed -&gt; LP-C03; never create again." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="590" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="LP-T02" value="&lt;b&gt;LP-T02&lt;/b&gt; Select a listed profile -&gt; LP-C03. Profile identity alone grants no authenticated session." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="680" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="LP-T03" value="&lt;b&gt;LP-T03&lt;/b&gt; PIN login -&gt; matching ordinary profile session -&gt; LP-C04. Wrong PIN -&gt; inline error; 429 -&gt; actual retry wait. Clear PIN after completion; no credential persistence." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="770" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="LP-T04" value="&lt;b&gt;LP-T04&lt;/b&gt; LP-C02 Create -&gt; LP-C01. LP-C01 Back -&gt; LP-C02. Empty first run offers Create directly; no administrator/approval step." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="860" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="LP-T05" value="&lt;b&gt;LP-T05&lt;/b&gt; LP-C03 Back -&gt; LP-C02 and clear PIN. Submit shows progress; disable conflicting navigation while a login/create request is pending." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="950" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="entry-policy" value="Six-digit PIN is the proposed initial policy, with upstream hashing and login rate limiting. No email, role selection or OS-account isolation is implied." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="1050" width="1140" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="profile-switch" name="Switching and session recovery">
    <mxGraphModel grid="1" page="1" pageWidth="1200" pageHeight="1090">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="switch-heading" value="&lt;b&gt;Local profile switching and recovery&lt;/b&gt;&lt;br&gt;PROPOSED / NOT IMPLEMENTED" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="LP-C04" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="360" height="320" as="geometry" />
        </mxCell>
        <mxCell id="LP-C04-title" value="&lt;b&gt;LP-C04 - Workspace profile menu&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="125" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="LP-C05" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="420" y="110" width="360" height="320" as="geometry" />
        </mxCell>
        <mxCell id="LP-C05-title" value="&lt;b&gt;LP-C05 - Profile session expired&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="435" y="125" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="LP-C06" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry x="810" y="110" width="360" height="320" as="geometry" />
        </mxCell>
        <mxCell id="LP-C06-title" value="&lt;b&gt;LP-C06 - Profile switch not confirmed&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="825" y="125" width="330" height="65" as="geometry" />
        </mxCell>
        <mxCell id="workspace-body" value="Current profile: [ Work ]&lt;br&gt;&lt;br&gt;Your workspace remains in place.&lt;br&gt;Switching does not rerun a graph." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="200" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="switch" value="Switch profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T06">
          <mxGeometry x="60" y="350" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="expired-body" value="Enter your PIN to continue.&lt;br&gt;&lt;br&gt;Saved profile and workspace remain.&lt;br&gt;No GitHub reconnection is implied." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="435" y="200" width="330" height="110" as="geometry" />
        </mxCell>
        <mxCell id="expired" value="Open profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T07">
          <mxGeometry x="450" y="350" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="switch-error-rail" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#FB8F8F;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="810" y="110" width="4" height="320" as="geometry" />
        </mxCell>
        <mxCell id="switch-error-copy" value="The app could not confirm sign-out.&lt;br&gt;It has not switched profiles.&lt;br&gt;&lt;br&gt;Technical details: safe code only." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="825" y="200" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="retry-switch" value="Retry switch" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T08">
          <mxGeometry x="840" y="330" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="check-profile" value="Check current profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T09">
          <mxGeometry x="840" y="378" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="LP-T06" value="&lt;b&gt;LP-T06&lt;/b&gt; Switch -&gt; existing logout mutation. Confirm sign-out, clear auth/query/private buffers and pending profile-bound OAuth -&gt; LP-C02. Failure -&gt; LP-C06. Preserve saved files/graphs; do not cancel unrelated runs." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="470" width="1140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="LP-T07" value="&lt;b&gt;LP-T07&lt;/b&gt; Valid restored ordinary session -&gt; workspace after matching identity check. Expired session -&gt; LP-C05 -&gt; LP-C03 for known profile, otherwise LP-C02. Explicit switching always requires target PIN." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="570" width="1140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="LP-T08" value="&lt;b&gt;LP-T08&lt;/b&gt; LP-C06 Retry -&gt; repeat LP-T06. Never claim switch on an unconfirmed result or silently select another credential." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="670" width="1140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="LP-T09" value="&lt;b&gt;LP-T09&lt;/b&gt; LP-C06 Check current profile -&gt; query real session: confirmed previous ordinary profile -&gt; LP-C04; confirmed signed out -&gt; LP-C02; unresolved -&gt; remain LP-C06 with descriptive error." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="770" width="1140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="LP-T10" value="&lt;b&gt;LP-T10&lt;/b&gt; On every switch/restore, reject stale responses from the prior profile. Public registry/activity remain installation-shared; private data remains profile/consent/generation-bound. Existing SC01 private logout guarantees are not waived." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="870" width="1140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="recovery-limit" value="PIN reset/deletion is not shown as implemented. Forgotten PIN must not trigger destructive profile deletion. Real create/switch/restore/failure stories and requesting-owner validation are still required." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="990" width="1140" height="70" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>