          <mxGeometry as="geometry" x="450" y="400" width="300" height="38" />
        </mxCell>
        <mxCell id="LP-T13" value="&lt;b&gt;LP-T13&lt;/b&gt; Log out -&gt; same local-session logout as LP-T06 -&gt; picker, no target selected. Failure -&gt; LP-C06; retry repeats the original logout/switch intent. LP-T14 Close -&gt; workspace without changing session. LP-T15 Choose different profile -&gt; LP-C02/07; clear expired identity and PIN. LP-T16 Error Close dismisses the panel only; it does not cancel a submitted sign-out. Pending retry/check replaces advice with progress; copy contains safe details only." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
