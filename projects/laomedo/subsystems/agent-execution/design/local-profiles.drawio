          <mxGeometry x="825" y="125" width="330" height="45" as="geometry" />
        </mxCell>
        <mxCell id="create-fields" value="Profile name&lt;br&gt;[ name ]&lt;br&gt;&lt;br&gt;PIN (masked, numeric)&lt;br&gt;[ ****** ]&lt;br&gt;&lt;br&gt;Confirm PIN (masked)&lt;br&gt;[ ****** ]" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="175" width="330" height="225" as="geometry" />
        </mxCell>
        <mxCell id="create-error" value="Inline validation/duplicate error here.&lt;br&gt;Never echo a PIN." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="45" y="405" width="330" height="50" as="geometry" />
        </mxCell>
        <mxCell id="create" value="Create profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T01">
          <mxGeometry x="60" y="460" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="create-back" value="Back to profiles" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T04">
          <mxGeometry x="60" y="505" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="picker-body" value="Profiles&lt;br&gt;&lt;br&gt;[ Work ]&lt;br&gt;&lt;br&gt;[ Personal ]&lt;br&gt;&lt;br&gt;Names identify setups on this machine." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="435" y="175" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="choose" value="Select profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T02">
          <mxGeometry x="450" y="460" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="add" value="Create another profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T04">
          <mxGeometry x="450" y="505" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="unlock-fields" value="Selected profile: [ name ]&lt;br&gt;&lt;br&gt;PIN (masked, numeric)&lt;br&gt;[ ****** ]&lt;br&gt;&lt;br&gt;Wrong PIN stays here with a safe error.&lt;br&gt;Rate limiting displays the actual wait." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="825" y="175" width="330" height="230" as="geometry" />
        </mxCell>
        <mxCell id="unlock" value="Open profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T03">
          <mxGeometry x="840" y="460" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="unlock-back" value="Back to profiles" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T05">
          <mxGeometry x="840" y="505" width="300" height="38" as="geometry" />
        </mxCell>
        <mxCell id="LP-T01" value="&lt;b&gt;LP-T01&lt;/b&gt; Create -&gt; confirmed ordinary profile + matching login -&gt; workspace. Duplicate/reserved -&gt; LP-C08. Confirmed failed save -&gt; LP-C09. Committed creation + unconfirmed login -&gt; LP-C10. Unknown save result -&gt; reconcile picker; never blindly create again." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="590" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="LP-T02" value="&lt;b&gt;LP-T02&lt;/b&gt; Select a listed profile -&gt; LP-C03. Profile identity alone grants no authenticated session." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="680" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="LP-T03" value="&lt;b&gt;LP-T03&lt;/b&gt; PIN login -&gt; matching ordinary profile session -&gt; LP-C04. Wrong PIN -&gt; inline error; 429 -&gt; actual retry wait. Clear PIN after completion; no credential persistence." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="770" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="LP-T04" value="&lt;b&gt;LP-T04&lt;/b&gt; Picker Create -&gt; LP-C01; Back -&gt; populated LP-C02 or empty LP-C07. First run -&gt; LP-C07. No administrator step. Every form masks the PIN and requests numeric entry; browser save/autofill is not required." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="860" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="LP-T05" value="&lt;b&gt;LP-T05&lt;/b&gt; LP-C03 Back -&gt; LP-C02 and clear PIN. Submit shows progress; disable conflicting navigation while a login/create request is pending." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="950" width="1140" height="80" as="geometry" />
        </mxCell>
        <mxCell id="entry-policy" value="Six-digit PIN is the proposed initial policy, with upstream hashing and login rate limiting. No email, role selection or OS-account isolation is implied." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="1050" width="1140" height="60" as="geometry" />
        </mxCell>
        <mxCell id="LP-C07" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1140" width="270" height="290" />
        </mxCell>
        <mxCell id="LP-C07-title" value="&lt;b&gt;LP-C07 - No profiles yet&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1150" width="250" height="60" />
        </mxCell>
        <mxCell id="LP-C07-body" value="Create a setup for this machine.&lt;br&gt;No email or administrator required." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="1215" width="250" height="140" />
        </mxCell>
        <mxCell id="LP-C07-action" value="Create profile" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="LP-T04">
          <mxGeometry as="geometry" x="45" y="1375" width="240" height="38" />
        </mxCell>
        <mxCell id="LP-C08" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="320" y="1140" width="270" height="290" />
        </mxCell>
        <mxCell id="LP-C08-title" value="&lt;b&gt;LP-C08 - Choose another name&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="330" y="1150" width="250" height="60" />
        </mxCell>
        <mxCell id="LP-C08-body" value="This name is unavailable.&lt;br&gt;Use a different profile name.&lt;br&gt;Your profile has not been created." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="330" y="1215" width="250" height="140" />
