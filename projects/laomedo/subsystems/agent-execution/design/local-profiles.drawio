        </mxCell>
        <mxCell id="LP-T06" value="&lt;b&gt;LP-T06&lt;/b&gt; Switch -&gt; confirmed upstream logout, clear local auth/query state -&gt; LP-C02/07. Unconfirmed sign-out -&gt; LP-C06 with shared profile sign-out error. Private GitHub revocation and OAuth invalidation are deferred. Never cancel unrelated graph runs." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="570" width="1140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="LP-T07" value="&lt;b&gt;LP-T07&lt;/b&gt; Valid restored ordinary session -&gt; workspace after matching identity check. Expired session -&gt; LP-C05 -&gt; LP-C03 for known profile, otherwise LP-C02. Explicit switching always requires target PIN." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="670" width="1140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="LP-T08" value="&lt;b&gt;LP-T08&lt;/b&gt; LP-C06 Retry -&gt; repeat LP-T06. Never claim switch on an unconfirmed result or silently select another credential." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="770" width="1140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="LP-T09" value="&lt;b&gt;LP-T09&lt;/b&gt; LP-C06 Check current profile -&gt; query real session: confirmed previous ordinary profile -&gt; LP-C04; confirmed signed out -&gt; LP-C02; unresolved -&gt; remain LP-C06 with descriptive error." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="870" width="1140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="LP-T10" value="&lt;b&gt;LP-T10&lt;/b&gt; Reject stale responses on switch/restore. Tabs share one browser-context cookie session: confirmed profile changes replace other documents; back-forward cache cannot restore stale state. Independent profiles need separate browser contexts. Public state stays shared; private GitHub session revocation is outside this local-profile slice." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry x="30" y="970" width="1140" height="90" as="geometry" />
        </mxCell>
        <mxCell id="recovery-limit" value="PIN reset/deletion is not shown as implemented. Forgotten PIN must not trigger destructive profile deletion. Real create/switch/restore/failure stories and requesting-owner validation are still required." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry x="30" y="1090" width="1140" height="70" as="geometry" />
        </mxCell>
