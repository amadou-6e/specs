          <mxGeometry as="geometry" x="335" y="1375" width="240" height="38" />
        </mxCell>
        <mxCell id="LP-C09" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="610" y="1140" width="270" height="290" />
        </mxCell>
        <mxCell id="LP-C09-title" value="&lt;b&gt;LP-C09 - Profile was not saved&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="620" y="1150" width="250" height="60" />
        </mxCell>
        <mxCell id="LP-C09-body" value="The app confirmed the save failed.&lt;br&gt;Your profile has not been created.&lt;br&gt;Try again when the app is available." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;fillColor=none;strokeColor=none;" vertex="1" parent="1">
