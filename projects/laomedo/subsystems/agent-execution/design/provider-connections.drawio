        <mxCell id="P16-reset" value="Resets Nov18,15:30&lt;br&gt;Checked14:28" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontColor=#f4f4f5;fontFamily=Arial;fontSize=14;fontSize=12;fontColor=#a1a1aa;" vertex="1" parent="1">
