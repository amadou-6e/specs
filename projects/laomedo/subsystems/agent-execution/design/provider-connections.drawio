        <mxCell id="P15-window-b" value="7-day window &amp;nbsp; &lt;b&gt;40% remaining&lt;/b&gt;&lt;br&gt;Resets Nov23,18:00" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontColor=#f4f4f5;fontFamily=Arial;fontSize=14;" vertex="1" parent="1">
