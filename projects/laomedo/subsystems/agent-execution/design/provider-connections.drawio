        <mxCell id="P13-account2" value="&lt;b&gt;Work Codex&lt;/b&gt; &amp;nbsp;&amp;nbsp; Not checked" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontColor=#f4f4f5;fontFamily=Arial;fontSize=14;" vertex="1" parent="1">
