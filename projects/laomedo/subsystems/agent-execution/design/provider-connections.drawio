        <mxCell id="P09-heading" value="Sign-in unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=none;fontColor=#fafafa;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="3942" width="550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="story-P09" value="&lt;b&gt;S02 · Understand a missing method&lt;/b&gt;&lt;br&gt;&lt;br&gt;As a user, I am told when a provider method is unavailable in this setup and can choose another supported method or go back.&lt;br&gt;&lt;br&gt;Example: native integration not installed, route unsupported or eligibility review incomplete. No active sign-in button is shown for an unavailable route.&lt;br&gt;&lt;br&gt;No borrowing a host token to make the screen appear successful.&lt;br&gt;&lt;br&gt;T06: Continue discovers that a previously available method no longer meets its prerequisites. Choose another method returns to P03; Back returns to the list/details." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;spacing=20;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="3920" width="450" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P09-body" value="This sign-in method isn't available in this setup.&lt;br&gt;&lt;br&gt;Choose a supported method to continue." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=none;fontColor=#fafafa;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="4005" width="530" height="90" as="geometry" />
        </mxCell>
        <mxCell id="P09-back" value="Choose another method" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#fafafa;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;fontColor=#fafafa;align=center;verticalAlign=middle;spacing=0;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1">
