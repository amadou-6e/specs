        </mxCell>
        <mxCell id="P10-field" value="Enter your API key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;verticalAlign=middle;fontColor=#64748b;" vertex="1" parent="1">
