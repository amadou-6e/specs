        <mxCell id="accessibility" value="All screens: labelled keyboard-accessible controls; logical focus and return focus; announced asynchronous status; narrow layouts stack controls without horizontal scrolling. No provider passwords, credentials, login URLs or technical transport details in user-facing errors. Example data is illustrative, not live acceptance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;" vertex="1" parent="1">
