      <mxCell id="P18-card" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="30" y="9250" width="630" height="650" as="geometry" /></mxCell><mxCell id="P18-heading" value="P18 - OpenCode Go limits" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;fontSize=20;" vertex="1" parent="1"><mxGeometry x="54" y="9270" width="582" height="32" as="geometry" /></mxCell><mxCell id="P18-tabs" value="Codex &amp;nbsp; Claude Code &amp;nbsp; &lt;b&gt;OpenCode&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="54" y="9320" width="582" height="32" as="geometry" /></mxCell><mxCell id="P18-account" value="&lt;b&gt;Personal Go&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="54" y="9380" width="582" height="32" as="geometry" /></mxCell><mxCell id="P18-bucket" value="&lt;b&gt;OpenCode Go&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="54" y="9430" width="582" height="28" as="geometry" /></mxCell><mxCell id="P18-window-0" value="5-hour window &amp;nbsp; &lt;b&gt;70% remaining&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="54" y="9475" width="582" height="45" as="geometry" /></mxCell><mxCell id="P18-bar-0" value="" style="rounded=1;html=1;fillColor=#a1a1aa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="54" y="9548" width="407.4" height="6" as="geometry" /></mxCell><mxCell id="P18-window-1" value="7-day window &amp;nbsp; &lt;b&gt;0% remaining&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="54" y="9585" width="582" height="45" as="geometry" /></mxCell><mxCell id="P18-bar-1" value="" style="rounded=1;html=1;fillColor=#a1a1aa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="54" y="9658" width="0" height="6" as="geometry" /></mxCell><mxCell id="P18-window-2" value="Monthly window &amp;nbsp; &lt;b&gt;50% remaining&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="54" y="9695" width="582" height="45" as="geometry" /></mxCell><mxCell id="P18-bar-2" value="" style="rounded=1;html=1;fillColor=#a1a1aa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="54" y="9768" width="291.0" height="6" as="geometry" /></mxCell><mxCell id="P18-checked" value="Checked08:00" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="54" y="9830" width="582" height="24" as="geometry" /></mxCell><mxCell id="P19-card" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="30" y="9960" width="320" height="650" as="geometry" /></mxCell><mxCell id="P19-heading" value="P19 - OpenCode Go limits" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;fontSize=20;" vertex="1" parent="1"><mxGeometry x="54" y="9980" width="272" height="32" as="geometry" /></mxCell><mxCell id="P19-tabs" value="Codex &amp;nbsp; Claude Code &amp;nbsp; &lt;b&gt;OpenCode&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="54" y="10030" width="272" height="32" as="geometry" /></mxCell><mxCell id="P19-account" value="&lt;b&gt;Personal Go&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="54" y="10090" width="272" height="32" as="geometry" /></mxCell><mxCell id="P19-bucket" value="&lt;b&gt;OpenCode Go&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="54" y="10140" width="272" height="28" as="geometry" /></mxCell><mxCell id="P19-window-0" value="5-hour window&lt;br&gt;&lt;b&gt;70% remaining&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="54" y="10185" width="272" height="45" as="geometry" /></mxCell><mxCell id="P19-bar-0" value="" style="rounded=1;html=1;fillColor=#a1a1aa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="54" y="10258" width="190.39999999999998" height="6" as="geometry" /></mxCell><mxCell id="P19-window-1" value="7-day window&lt;br&gt;&lt;b&gt;0% remaining&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="54" y="10295" width="272" height="45" as="geometry" /></mxCell><mxCell id="P19-bar-1" value="" style="rounded=1;html=1;fillColor=#a1a1aa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="54" y="10368" width="0" height="6" as="geometry" /></mxCell><mxCell id="P19-window-2" value="Monthly window&lt;br&gt;&lt;b&gt;50% remaining&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="54" y="10405" width="272" height="45" as="geometry" /></mxCell><mxCell id="P19-bar-2" value="" style="rounded=1;html=1;fillColor=#a1a1aa;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="54" y="10478" width="136.0" height="6" as="geometry" /></mxCell><mxCell id="P19-checked" value="Checked08:00" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="54" y="10540" width="272" height="24" as="geometry" /></mxCell><mxCell id="P18-story" value="&lt;b&gt;S12 - Inspect Go subscription limits&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use the saved Go execution key. Opening loads all three documented meters and refreshes every 10 seconds, with zero inference and no second login.&lt;br&gt;&lt;br&gt;Monthly is a calendar window: show its reported reset, never a thirty-day approximation. Unknown fields remain unknown; absent meters are not reconstructed.&lt;br&gt;&lt;br&gt;401: OpenCode did not accept this key. Update it in Manage accounts.&lt;br&gt;&lt;br&gt;403: This key cannot access Go subscription limits. Check its subscription in OpenCode.&lt;br&gt;&lt;br&gt;429: OpenCode is limiting usage checks. Try again later.&lt;br&gt;&lt;br&gt;Failures preserve the saved connection and mark any previous snapshot Out of date. Never show raw upstream errors.&lt;br&gt;&lt;br&gt;Limits load automatically on opening and refresh every 10 seconds while this panel is open. Skip overlapping checks; stop on leaving. Manual Refresh stays icon-only.&lt;br&gt;&lt;br&gt;Refresh remains icon-only. Polls never overlap and stop when leaving this panel." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#172b4d;fontSize=14;fillColor=#f5f8fc;strokeColor=#dde5ed;spacing=16;" vertex="1" parent="1"><mxGeometry x="710" y="9270" width="440" height="620" as="geometry" /></mxCell><mxCell id="P19-story" value="&lt;b&gt;S12 - Go at320px&lt;/b&gt;&lt;br&gt;&lt;br&gt;Reuse P16 hierarchy. Keep the account and Refresh aligned. Put each window name, remaining percentage and reset on separate lines. All three meters remain visible without horizontal clipping.&lt;br&gt;&lt;br&gt;Values shown in this design are illustrative, not a live quota claim.&lt;br&gt;&lt;br&gt;Limits load automatically on opening and refresh every 10 seconds while this panel is open. Skip overlapping checks; stop on leaving. Manual Refresh stays icon-only.&lt;br&gt;&lt;br&gt;Refresh remains icon-only. Polls never overlap and stop when leaving this panel." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#172b4d;fontSize=14;fillColor=#f5f8fc;strokeColor=#dde5ed;spacing=16;" vertex="1" parent="1"><mxGeometry x="710" y="9980" width="440" height="400" as="geometry" /></mxCell><mxCell id="P18-card-refresh" value="&amp;#10227;" style="text;html=1;fontColor=#fafafa;fontSize=20;" vertex="1" parent="1"><mxGeometry x="606.0" y="9380.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="P18-window-0-reset" value="Resets Nov26,13:00" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="54" y="9560.0" width="582" height="24" as="geometry" /></mxCell><mxCell id="P18-window-1-reset" value="Resets Nov30,09:00" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="54" y="9670.0" width="582" height="24" as="geometry" /></mxCell><mxCell id="P18-window-2-reset" value="Resets Dec1,00:00" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="54" y="9780.0" width="582" height="24" as="geometry" /></mxCell><mxCell id="P19-card-refresh" value="&amp;#10227;" style="text;html=1;fontColor=#fafafa;fontSize=20;" vertex="1" parent="1"><mxGeometry x="296.0" y="10090.0" width="30" height="30" as="geometry" /></mxCell><mxCell id="P19-window-0-reset" value="Resets Nov26,13:00" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="54" y="10270.0" width="272" height="24" as="geometry" /></mxCell><mxCell id="P19-window-1-reset" value="Resets Nov30,09:00" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontColor=#fafafa;fontSize=14;fontSize=12;" vertex="1" parent="1"><mxGeometry x="54" y="10380.0" width="272" height="24" as=