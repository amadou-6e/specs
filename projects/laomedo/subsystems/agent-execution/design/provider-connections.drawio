        </mxCell>
        <mxCell id="P14-reconnect" value="&lt;b&gt;Personal Codex&lt;/b&gt; &amp;nbsp;&amp;nbsp; Account unavailable&lt;br&gt;Manage accounts" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontColor=#f4f4f5;fontFamily=Arial;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="7370" width="560" height="64" as="geometry" />
        </mxCell>
        <mxCell id="P14-story" value="&lt;b&gt;S11 / Q3-Q5 - Trust freshness and account ownership&lt;/b&gt;&lt;br&gt;&lt;br&gt;Q04 60seconds pass or a reported reset passes: Q2 -&gt; Q3 Out of date. Keep last observed values; do not invent replenishment.&lt;br&gt;&lt;br&gt;Q05 Failed refresh: retain only the same-binding snapshot, clearly stale; no snapshot -&gt; Q4 Unavailable with retry. Q06 Unsupported provider (OpenCode) -&gt; Q4 Not available, no hidden network/model work. Claude reuses P13-P16 through its saved native connection.&lt;br&gt;&lt;br&gt;Q07 Logout/disconnect/reconnect or revoked generation: discard old display/cache -&gt; Q5 Account unavailable. Late results never cross an account/session boundary.&lt;br&gt;&lt;br&gt;Retry returns through Q1. Spinner/disabled Refresh is per account; keyboard labels/status announcements remain available. Cache is bounded, memory-only and expires after10minutes." style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d9dee7;fontColor=#263547;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="710" y="6990" width="440" height="510" as="geometry" />
        </mxCell>
