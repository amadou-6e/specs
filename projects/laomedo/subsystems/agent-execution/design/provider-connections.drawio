        <mxCell id="row-P10" value="P10 · Connect with an API key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1">
