        <mxCell id="P03-heading" value="Connect Codex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="1542" width="550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="story-P03" value="&lt;b&gt;S02 / S08 · Choose a supported method&lt;/b&gt;&lt;br&gt;&lt;br&gt;As a user, I see only methods supported by this installed adapter, with subscription or API billing stated plainly.&lt;br&gt;&lt;br&gt;Illustration: Codex / ChatGPT plan. Claude native sign-in is eligibility-gated; OpenCode needs a supported upstream route (currently Go only in the local prototype). This screen does not promise route parity.&lt;br&gt;&lt;br&gt;No automatic API-billing fallback; no third-party password form." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="690" y="1520" width="450" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P03-hint" value="Choose how to connect." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="1585" width="520" height="25" as="geometry" />
        </mxCell>
        <mxCell id="P03-method" value="&lt;b&gt;Sign in with ChatGPT&lt;/b&gt;&lt;br&gt;Use your eligible ChatGPT plan." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="65" y="1630" width="555" height="75" as="geometry" />
        </mxCell>
        <mxCell id="P03-continue" value="Continue to sign in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#182230;strokeColor=#182230;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="410" y="1750" width="210" height="38" as="geometry" />
        </mxCell>
        <mxCell id="P03-back" value="← Back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="1758" width="120" height="25" as="geometry" />
        </mxCell>
        <mxCell id="row-P04" value="P04 · Finish signing in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1880" width="610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="screen-P04" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="1920" width="610" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P04-heading" value="Finish signing in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="1942" width="550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="story-P04" value="&lt;b&gt;S03 · Sign in safely&lt;/b&gt;&lt;br&gt;&lt;br&gt;As a user, I complete sign-in in the provider's official browser or native client and return to Laomedo.&lt;br&gt;&lt;br&gt;Laomedo verifies the matching attempt without a model turn. The native client retains credentials when it owns sign-in; Laomedo never extracts Claude subscription tokens.&lt;br&gt;&lt;br&gt;Cancel fences this attempt. Expired, duplicate or late callbacks cannot add an account. Do not launch sign-in again while checking." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="690" y="1920" width="450" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P04-body" value="Complete sign-in with the provider.&lt;br&gt;We'll update this page when it finishes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="2000" width="525" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P04-waiting" value="Waiting for sign-in..." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="65" y="2075" width="555" height="48" as="geometry" />
        </mxCell>
        <mxCell id="P04-cancel" value="Cancel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;fontColor=#182230;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="455" y="2150" width="165" height="38" as="geometry" />
        </mxCell>
        <mxCell id="row-P05" value="P05 · Personal Codex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2280" width="610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="screen-P05" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="2320" width="610" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P05-heading" value="Personal Codex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="2342" width="550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="story-P05" value="&lt;b&gt;S04 / S05 · Use and repair one connection&lt;/b&gt;&lt;br&gt;&lt;br&gt;As a user, I can rename a connection, inspect its account and method, or sign in again for this exact row.&lt;br&gt;&lt;br&gt;Agents explicitly choose a compatible saved connection. No global active-account fallback. Export removes the private local binding and import asks for rebinding.&lt;br&gt;&lt;br&gt;Connected means credential check passed; model access and usage limits are not proven. Runner offline remains distinct from signed out." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="690" y="2320" width="450" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P05-body" value="Codex · ChatGPT plan&lt;br&gt;person@example.test&lt;br&gt;&lt;br&gt;Connected · Credential checked&lt;br&gt;Model usage not yet confirmed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="2390" width="540" height="110" as="geometry" />
        </mxCell>
        <mxCell id="P05-rename" value="Rename" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="2524" width="110" height="25" as="geometry" />
        </mxCell>
        <mxCell id="P05-signin" value="Sign in again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;fontColor=#182230;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="2550" width="160" height="38" as="geometry" />
        </mxCell>
        <mxCell id="P05-disconnect" value="Disconnect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;fontColor=#182230;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="455" y="2550" width="165" height="38" as="geometry" />
        </mxCell>
        <mxCell id="row-P06" value="P06 · Sign-in failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2680" width="610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="screen-P06" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="2720" width="610" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P06-heading" value="Sign-in failed" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="2742" width="550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="story-P06" value="&lt;b&gt;S03 / S05 · Recover without losing my account&lt;/b&gt;&lt;br&gt;&lt;br&gt;As a user, I see a short failure message and can try again or go back. An expired attempt says &quot;Sign-in expired. Try again.&quot;&lt;br&gt;&lt;br&gt;Technical details are collapsed and sanitized. The previous committed account remains unchanged; no repeated browser launch or billing switch occurs automatically.&lt;br&gt;&lt;br&gt;Checking a connection uses its exact ID and generation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="690" y="2720" width="450" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P06-body" value="We couldn't finish signing you in.&lt;br&gt;Your saved connection hasn't changed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="2802" width="530" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P06-details" value="? Details" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="2885" width="200" height="25" as="geometry" />
        </mxCell>
        <mxCell id="P06-retry" value="Try again" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#182230;strokeColor=#182230;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="455" y="2950" width="165" height="38" as="geometry" />
        </mxCell>
        <mxCell id="P06-back" value="← Back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="2958" width="120" height="25" as="geometry" />
        </mxCell>
        <mxCell id="row-P07" value="P07 · Use another connection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="3080" width="610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="screen-P07" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="3120" width="610" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P07-heading" value="Use another connection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="3142" width="550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="story-P07" value="&lt;b&gt;S06 · Avoid accidental account replacement&lt;/b&gt;&lt;br&gt;&lt;br&gt;As a user, reconnecting with the wrong account does not overwrite my saved connection. I can add it as a new connection instead.&lt;br&gt;&lt;br&gt;Duplicate variant: &quot;This account is already connected&quot; + View connection. Match verified type, route, principal and workspace only. No merge or replacement.&lt;br&gt;&lt;br&gt;API keys without verified identity remain explicitly labelled independent connections." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="690" y="3120" width="450" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P07-body" value="You signed in to a different account.&lt;br&gt;Your existing connection hasn't changed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="3205" width="530" height="60" as="geometry" />
        </mxCell>
        <mxCell id="P07-add" value="Add as new connection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#182230;strokeColor=#182230;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="385" y="3350" width="235" height="38" as="geometry" />
        </mxCell>
        <mxCell id="P07-back" value="← Back" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="3358" width="120" height="25" as="geometry" />
        </mxCell>
        <mxCell id="row-P08" value="P08 · Disconnect provider?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="3480" width="610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="screen-P08" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="3520" width="610" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P08-heading" value="Disconnect provider?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="3542" width="550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="story-P08" value="&lt;b&gt;S07 · Disconnect just this connection&lt;/b&gt;&lt;br&gt;&lt;br&gt;As a user, I confirm which connection is removed and see the affected active-run count.&lt;br&gt;&lt;br&gt;New dispatch stops immediately. Existing authentication policy cancels or quarantines active controllers and preserves partial evidence. Other rows and ordinary host CLI login stay intact.&lt;br&gt;&lt;br&gt;Disconnecting stays visible until stop and cleanup are confirmed. Failure shows &quot;Could not finish disconnecting&quot; + Retry cleanup. No claim of global provider logout." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="690" y="3520" width="450" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P08-body" value="Disconnect Personal Codex?&lt;br&gt;&lt;br&gt;1 active run will be stopped or quarantined.&lt;br&gt;Your other connections won't be changed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="3595" width="530" height="110" as="geometry" />
        </mxCell>
        <mxCell id="P08-cancel" value="Cancel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;fontColor=#182230;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="270" y="3750" width="160" height="38" as="geometry" />
        </mxCell>
        <mxCell id="P08-confirm" value="Disconnect" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#182230;strokeColor=#182230;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="455" y="3750" width="165" height="38" as="geometry" />
        </mxCell>
        <mxCell id="row-P09" value="P09 · Sign-in unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="3880" width="610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="screen-P09" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="3920" width="610" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P09-heading" value="Sign-in unavailable" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="3942" width="550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="story-P09" value="&lt;b&gt;S02 · Understand a missing method&lt;/b&gt;&lt;br&gt;&lt;br&gt;As a user, I am told when a provider method is unavailable in this setup and can choose another supported method or go back.&lt;br&gt;&lt;br&gt;Example: native integration not installed, route unsupported or eligibility review incomplete. No active sign-in button is shown for an unavailable route.&lt;br&gt;&lt;br&gt;No borrowing a host token to make the screen appear successful." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;spacing=20;" vertex="1" parent="1">
          <mxGeometry x="690" y="3920" width="450" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P09-body" value="This sign-in method isn't available in this setup.&lt;br&gt;&lt;br&gt;Choose a supported method to continue." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="4005" width="530" height="90" as="geometry" />
        </mxCell>
        <mxCell id="P09-back" value="Choose another method" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;fontColor=#182230;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="385" y="4150" width="235" height="38" as="geometry" />
        </mxCell>
        <mxCell id="row-P10" value="P10 · Connect with an API key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=17;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="4280" width="610" height="25" as="geometry" />
        </mxCell>
        <mxCell id="screen-P10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="4320" width="610" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P10-heading" value="Connect with an API key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=none;fontColor=#182230;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="65" y="4342" width="550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="story-P10" value="&lt;b&gt;S08 · Choose API billing explicitly&lt;/b&gt;&lt;br&gt;&lt;br&gt;As a user, I can deliberately supply a supported API key, with API billing clearly labelled before submission.&lt;br&gt;&lt;br&gt;The field is masked, never prefilled from the machine, and cleared on submit, Back and unmount. The server verifies credentials without running a model; failure does not restore the secret.&lt;br&gt;&lt;br&gt;Provider passwords and subscription session tokens are never requested here." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;spacing=20;" vertex="1" parent="1">
