        <mxCell id="P10-update-confirm" value="I understand and want to replace this connection's key." style="rounded=1;arcSize=8;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#fafafa;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=middle;spacing=8;strokeColor=none;fillColor=none;" vertex="1" parent="1">
