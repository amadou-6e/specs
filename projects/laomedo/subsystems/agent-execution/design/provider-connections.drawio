          <mxGeometry x="50" y="8200" width="280" height="38" as="geometry" />
        </mxCell>
        <mxCell id="P16-heading" value="&lt;b&gt;Subscription limits&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontColor=#f4f4f5;fontFamily=Arial;fontSize=14;" vertex="1" parent="1">
