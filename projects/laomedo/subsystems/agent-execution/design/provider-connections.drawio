        <mxCell id="P13-secondary" value="7-day window &lt;b&gt;58% remaining&lt;/b&gt; &amp;nbsp; Resets Nov23,18:00" style="text;html=1;whiteSpace=wrap;overflow=hidden;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontColor=#f4f4f5;fontFamily=Arial;fontSize=14;" vertex="1" parent="1">
