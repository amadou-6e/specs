        </mxCell>
        <mxCell id="P16-story" value="&lt;b&gt;S10 / Q2 - Narrow320px panel&lt;/b&gt;&lt;br&gt;&lt;br&gt;Use the same hierarchy and controls; preserve account/refresh alignment. Window name and remaining text wrap without clipping; reset/last-check text is below the bar. Long provider labels wrap. The list scrolls vertically.&lt;br&gt;&lt;br&gt;Q1-Q5 follow P14 in the same flow. Native reads are bounded initialization/read operations in a temporary process; close it and verify cleanup before publication. No native session/thread/prompt is started.&lt;br&gt;&lt;br&gt;Parent implementation/specification remain separate integration and merge gates." style="rounded=1;absoluteArcSize=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d9dee7;fontColor=#263547;align=left;verticalAlign=top;spacing=16;fontFamily=Arial;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="710" y="8150" width="440" height="510" as="geometry" />
        </mxCell>
        <mxCell id="P04-device-code" value="ABCD-1234" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#27272a;strokeColor=#3f3f46;fontColor=#fafafa;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;arcSize=8;absoluteArcSize=1;align=center;fontSize=24;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="2045" width="555" height="44" as="geometry" />
        </mxCell>
        <mxCell id="P04-continue" value="Continue to ChatGPT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#182230;fontColor=#fafafa;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=0;arcSize=8;absoluteArcSize=1;fontColor=#18181b;" vertex="1" parent="1">
          <mxGeometry x="65" y="2110" width="555" height="38" as="geometry" />
        </mxCell>
