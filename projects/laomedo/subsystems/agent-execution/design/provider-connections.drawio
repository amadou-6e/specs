        <mxCell id="P17-heading" value="Use this ChatGPT account?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=none;fontColor=#fafafa;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="8842.0" width="550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="story-P17" value="&lt;b&gt;S03 - Keep my graph selections&lt;/b&gt;&lt;br&gt;&lt;br&gt;As an existing user, I can upgrade my Codex connection without rebuilding my graphs.&lt;br&gt;&lt;br&gt;Laomedo shows the account verified by the native client. Matching email does not prove it is the same identity as my older login.&lt;br&gt;&lt;br&gt;Replace connection saves the new native login under the existing connection selector and advances its generation. Existing graph selections stay intact; old retained sessions cannot resume under the new login.&lt;br&gt;&lt;br&gt;Back discards the new login and preserves the old one. Nothing is replaced before confirmation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;spacing=20;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="8820.0" width="450" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P17-body" value="Replace the saved Codex login with this verified account.&lt;br&gt;Your graph selections will stay the same." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=none;fontColor=#fafafa;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="8888.0" width="525" height="48" as="geometry" />
