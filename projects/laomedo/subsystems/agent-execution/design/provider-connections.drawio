        <mxCell id="P10-heading" value="Connect with an API key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=none;fontColor=#fafafa;fontFamily=Helvetica;fontSize=20;align=left;verticalAlign=top;spacing=14;fontStyle=1;rounded=0;spacing=0;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="65" y="4342" width="550" height="30" as="geometry" />
        </mxCell>
        <mxCell id="story-P10" value="&lt;b&gt;S08 - Choose API billing explicitly&lt;/b&gt;&lt;br&gt;&lt;br&gt;As a user, I deliberately supply a supported API key, with API billing identified before connecting.&lt;br&gt;&lt;br&gt;Use a masked field with the API key placeholder, no visible field title, and a persistent accessible name. Never prefill from host credentials.&lt;br&gt;&lt;br&gt;Clear the secret on submit, Back or unmount. Verify without a model request; failure never restores the secret.&lt;br&gt;&lt;br&gt;No provider password or subscription session token is requested.&lt;br&gt;&lt;br&gt;The update variant below requires explicit confirmation when account identity cannot be verified." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#d0d7de;fontColor=#182230;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;spacing=20;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="4320" width="450" height="320" as="geometry" />
        </mxCell>
        <mxCell id="P10-body" value="Uses API billing for this provider." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=none;fontColor=#fafafa;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1">
