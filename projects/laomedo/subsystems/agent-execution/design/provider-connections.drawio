          <mxGeometry x="30" y="5770" width="630" height="450" as="geometry" />
        </mxCell>
        <mxCell id="P12-title" value="P12 - Finish connecting Claude Code" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#fafafa;fontSize=14;fontSize=22;fontStyle=1;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="5800" width="560" height="35" as="geometry" />
        </mxCell>
        <mxCell id="P12-body" value="Sign in with Claude, then paste the completion code below." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#fafafa;fontSize=14;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="5850" width="560" height="45" as="geometry" />
        </mxCell>
        <mxCell id="P12-authorize" value="Continue to Claude &amp;#8599;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#fafafa;fillColor=#fafafa;fontColor=#18181b;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="5920" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="P12-code" value="Completion code &amp;#8226;&amp;#8226;&amp;#8226;&amp;#8226;&amp;#8226;&amp;#8226;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#fafafa;align=left;spacingLeft=12;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="5985" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="P12-finish" value="Finish sign-in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#fafafa;fillColor=#fafafa;fontColor=#18181b;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="6050" width="560" height="40" as="geometry" />
        </mxCell>
        <mxCell id="P12-nav" value="&amp;#8592; &amp;nbsp; &amp;#10227;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#fafafa;fontSize=14;fontSize=20;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="6160" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="P12-story" value="&lt;b&gt;P12 - User story&lt;/b&gt;&lt;br&gt;&lt;br&gt;As a user, I connect a Claude subscription through the official client without copying local login files.&lt;br&gt;&lt;br&gt;1. Press Continue to Claude.&lt;br&gt;2. Complete native sign-in.&lt;br&gt;3. Paste its one-use code and press Finish sign-in.&lt;br&gt;&lt;br&gt;Laomedo verifies account identity and returns to the connection. Back cancels; Refresh only checks progress. Failed reconnect preserves the existing account. No model turn is submitted." style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=18;fillColor=#ffffff;strokeColor=#dddddd;fontColor=#222222;fontSize=15;arcSize=6;" vertex="1" parent="1">
          <mxGeometry x="710" y="5800" width="440" height="400" as="geometry" />
        </mxCell>
