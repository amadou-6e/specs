          <mxGeometry as="geometry" x="60" y="5435" width="560" height="40" />
        </mxCell>
        <mxCell id="P11-disclosure" value="Saving stores the key locally. It does not verify your account or send a model request." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=none;fontColor=#fafafa;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;rounded=0;spacing=0;arcSize=8;absoluteArcSize=1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="5485" width="560" height="55" />
        </mxCell>
        <mxCell id="P11-save" value="Save connection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#182230;fontColor=#fafafa;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=14;fontColor=#ffffff;align=center;verticalAlign=middle;spacing=0;arcSize=8;absoluteArcSize=1;fontColor=#18181b;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="5555" width="560" height="40" />
        </mxCell>
        <mxCell id="P11-story" value="&lt;b&gt;S09 - Connect OpenCode Go&lt;/b&gt;&lt;br&gt;&lt;br&gt;Choose OpenCode, then supply a Go subscription key and a local connection name. Open OpenCode Console goes to the provider in a new tab; Laomedo never collects its password.&lt;br&gt;&lt;br&gt;Save stores a private key revision and clears the secret field. The row says Key saved; account identity and entitlement remain unverified. Exact repeated keys open the existing connection; different keys cannot prove whether accounts match.&lt;br&gt;&lt;br&gt;Use this connection only for OpenCode. Select it on a node or as this graph's OpenCode default. No fallback to Console or other providers. Disconnect fences dispatch and waits for owned cleanup before erasing the key.&lt;br&gt;&lt;br&gt;Go key replacement is not offered in this increment; add a new key connection explicitly, then remove the old one.&lt;br&gt;&lt;br&gt;P11 is the OpenCode Go variant of key-entry state P10. Back cancels entry and clears the key; Refresh never submits a key." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=15;fontColor=#172033;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="710" y="5240" width="440" height="400" />
        </mxCell>
        <mxCell id="P11-nav-back" value="←" style="text;html=1;align=center;verticalAlign=middle;fillColor=none;strokeColor=none;fontColor=#fafafa;fontSize=24;fontFamily=Helvetica;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="5610" width="24" height="24" />
        </mxCell>
