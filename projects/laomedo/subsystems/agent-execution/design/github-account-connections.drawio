          <mxGeometry as="geometry" x="45" y="135" width="520" height="50" />
        </mxCell>
        <mxCell id="setup-description" value="Register a GitHub App with Contents: read-only.&lt;br/&gt;Then install it on only the intended repositories.&lt;br/&gt;Webhooks are not needed. Copy the callback exactly." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="195" width="520" height="100" />
