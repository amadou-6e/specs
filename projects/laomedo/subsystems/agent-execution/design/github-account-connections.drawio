        </mxCell>
        <mxCell id="node-operation" value="Operation&lt;br/&gt;[ existing operation input ]" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#F1F5F9;strokeColor=#94A3B8;" vertex="1" parent="1">
