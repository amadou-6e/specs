r=#fafafa;strokeColor=#fafafa;fontColor=#18181b;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="475" y="350" width="330" height="48" as="geometry"/></mxCell><mxCell id="row1-1" value="Callback URL - select and copy" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;rounded=1;fillColor=#27272a;strokeColor=#52525b;" vertex="1" parent="1"><mxGeometry x="475" y="414" width="330" height="48" as="geometry"/></mxCell><mxCell id="row1-2" value="Contents: read-only. Expiring user tokens." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="475" y="478" width="330" height="85" as="geometry"/></mxCell><mxCell id="number1" value="02" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#60a5fa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="455" y="128" width="50" height="28" as="geometry"/></mxCell><mxCell id="edge1" value="" style="endArrow=block;strokeColor=#60a5fa;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830" y="460" as="sourcePoint"/><mxPoint x="865" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="card2" value="" style="rounded=1;arcSize=4;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="870" y="160" width="370" height="610" as="geometry"/></mxCell><mxCell id="heading2" value="Enter App credentials" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="185" width="330" height="46" as="geometry"/></mxCell><mxCell id="desc2" value="Use the credentials from your registered GitHub App." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="890" y="242" width="330" height="85" as="geometry"/></mxCell><mxCell id="row2-0" value="Client ID" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;rounded=1;fillColor=#27272a;strokeColor=#52525b;" vertex="1" parent="1"><mxGeometry x="890" y="350" width="330" height="48" as="geometry"/></mxCell><mxCell id="row2-1" value="App slug" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;rounded=1;fillColor=#27272a;strokeColor=#52525b;" vertex="1" parent="1"><mxGeometry x="890" y="414" width="330" height="48" as="geometry"/></mxCell><mxCell id="row2-2" value="Client secret - masked" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;rounded=1;fillColor=#27272a;strokeColor=#52525b;" vertex="1" parent="1"><mxGeometry x="890" y="478" width="330" height="48" as="geometry"/></mxCell><mxCell id="row2-3" value="Save configuration" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#fafafa;fontColor=#18181b;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890" y="542" width="330" height="48" as="geometry"/></mxCell><mxCell id="number2" value="03" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#60a5fa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870" y="128" width="50" height="28" as="geometry"/></mxCell><mxCell id="edge2" value="" style="endArrow=block;strokeColor=#60a5fa;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1245" y="460" as="sourcePoint"/><mxPoint x="1280" y="460" as="targetPoint"/></mxGeometry></mxCell><mxCell id="card3" value="" style="rounded=1;arcSize=4;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="1285" y="160" width="370" height="610" as="geometry"/></mxCell><mxCell id="heading3" value="GitHub sign-in is ready" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1305" y="185" width="330" height="46" as="geometry"/></mxCell><mxCell id="desc3" value="Installation setup is complete. Users can now connect their own GitHub account." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="1305" y="242" width="330" height="85" as="geometry"/></mxCell><mxCell id="row3-0" value="Return to GitHub connections" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#fafafa;fontColor=#18181b;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1305" y="350" width="330" height="48" as="geometry"/></mxCell><mxCell id="row3-1" value="Then show Sign in with GitHub. Saving configuration does not sign anyone in." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="1305" y="414" width="330" height="85" as="geometry"/></mxCell><mxCell id="number3" value="04" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#60a5fa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1285" y="128" width="50" height="28" as="geometry"/></mxCell><mxCell id="notes" value="SEPARATE RESPONSIBILITIES - Installation operator registers/configures the App once. Each local profile separately signs in and chooses repository read consent. App setup must not appear as a competing login action.
OPEN FOR DISCUSSION - In the single-user local deployment, should missing setup expose Set up GitHub sign-in directly or through a separate installation settings entry? Optional token entry remains outside the primary browser sign-in flow. This draft does not invent an administrator role or change authorization policy." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fillColor=#1e293b;strokeColor=#334155;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40" y="810" width="1600" height="140" as="geometry"/></mxCell></root></mxGraphModel></diagram>

