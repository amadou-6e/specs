        </mxCell>
        <mxCell id="setup-copy" value="Set up a read-only GitHub App once.&lt;br/&gt;&lt;br/&gt;Laomedo needs its client ID, registered callback and a securely stored client secret.&lt;br/&gt;&lt;br/&gt;No existing gh or editor login is imported." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
