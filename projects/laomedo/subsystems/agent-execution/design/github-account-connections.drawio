        <mxCell id="account" value="Verified account: [ GitHub login ]&lt;br/&gt;Mode: browser sign-in or fine-grained token&lt;br/&gt;State: Ready&lt;br/&gt;&lt;br/&gt;Allowed repository reads:&lt;br/&gt;[ confirmed repository identity ]&lt;br/&gt;&lt;br/&gt;Expiry: show only when verified by GitHub." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
