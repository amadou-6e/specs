                <mxCell id="e2-body" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=0;fontSize=16;fontColor=#71717a;fontStyle=0;align=left;" value="Laomedo has stopped using this account.&#10;Some saved credentials could not be removed." vertex="1">
                    <mxGeometry height="84" width="520" x="390.0" y="10676.0" as="geometry" />
                </mxCell>
                <mxCell id="e2-primary" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e4e4e7;fontFamily=Helvetica;fontColor=#18181b;fontSize=15;fillColor=#18181b;strokeColor=#18181b;fontColor=#ffffff;fontStyle=1;" value="Retry cleanup" vertex="1">
                    <mxGeometry height="44" width="292" x="390.0" y="10804.0" as="geometry" />
                </mxCell>
                <mxCell id="e2-secondary" parent="1" style="rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#e4e4e7;fontFamily=Helvetica;fontColor=#18181b;fontSize=15;" value="Close" vertex="1">
                    <mxGeometry height="44" width="204" x="706.0" y="10804.0" as="geometry" />
                </mxCell>
                <mxCell id="screen-design-reference-note" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=0;fontSize=17;fontColor=#52525b;fontStyle=0;align=left;" value="DESIGN REFERENCES&#10;shadcn/ui login-01 and login-03: focused panels, content width, generous spacing.&#10;GitHub Primer ActionList: consistent identity rows, leading avatars and trailing actions.&#10;Reference links and original screenshots are recorded beside the workshop.&#10;These are editable design mockups, not a runtime implementation or full review claim." vertex="1">
                    <mxGeometry height="240" width="1500" x="1400" y="10710" as="geometry" />
                </mxCell>
                <mxCell id="user-story-5-screen-copy" parent="1" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#18181b;fontSize=17;align=left;verticalAlign=top;spacing=18;" value="US05 - Recover access&#10;&#10;As a user, I want a clear explanation and the appropriate recovery action when access fails, so I can continue with minimal effort.&#10;&#10;Laomedo does the work: Laomedo preserves my selections and performs safe automatic recovery where possible. An offline check does not force a new login. It asks me to authorize again only when needed, for the correct saved account." vertex="1">
                    <mxGeometry height="260" width="1500" x="1400" y="9440" as="geometry" />
                </mxCell><mxCell id="user-story-6-screen-copy" parent="1" style="rounded=1;arcSize=5;html=1;whiteSpace=wrap;fillColor=#f8fafc;strokeColor=#cbd5e1;fontColor=#18181b;fontSize=17;align=left;verticalAlign=top;spacing=18;" value="US06 - Disconnect an account&#10;&#10;As a user, I want to disconnect a selected GitHub connection, so Laomedo stops using its access.&#10;&#10;Laomedo does the work: Laomedo blocks further private reads, clears private views and removes its stored credentials. It reports incomplete cleanup honestly and does not claim to revoke GitHub consent." vertex="1">
                    <mxGeometry height="260" width="1500" x="1400" y="10380" as="geometry" />
                </mxCell><mxCell id="d-advanced" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=0;fontSize=14;fontColor=#52525b;fontStyle=0;align=center;" value="Advanced: use a personal access token" vertex="1">
                    <mxGeometry height="28" width="520" x="390.0" y="8984.0" as="geometry" />
                </mxCell></root>
