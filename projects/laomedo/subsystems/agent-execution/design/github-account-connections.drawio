                <mxCell id="e2-title" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=0;fontSize=27;fontColor=#18181b;fontStyle=1;align=left;" value="Disconnected" vertex="1">
