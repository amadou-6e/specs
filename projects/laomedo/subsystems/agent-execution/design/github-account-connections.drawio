  <diagram id="manager" name="GC01-GC03 - Connection manager">
    <mxGraphModel dx="1200" dy="900" grid="1" page="1" pageWidth="1200" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="GitHub connections - app settings, outside the graph&lt;br/&gt;&lt;b&gt;PROPOSED / NOT IMPLEMENTED - specs #410 / Laomedo #251&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1140" height="80" />
        </mxCell>
        <mxCell id="setup" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="125" width="360" height="570" />
        </mxCell>
        <mxCell id="pending" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="420" y="125" width="360" height="570" />
        </mxCell>
        <mxCell id="ready" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="810" y="125" width="360" height="570" />
        </mxCell>
        <mxCell id="setup-title" value="&lt;b&gt;GC01 - No app configured&lt;/b&gt;&lt;br/&gt;GitHub connections" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="140" width="330" height="80" />
        </mxCell>
        <mxCell id="setup-copy" value="Set up a read-only GitHub App once.&lt;br/&gt;&lt;br/&gt;Laomedo needs its client ID, registered callback and a securely stored client secret.&lt;br/&gt;&lt;br/&gt;No existing gh or editor login is imported." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="45" y="230" width="330" height="210" />
        </mxCell>
        <mxCell id="setup-link" value="View app setup" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#EFF6FF;strokeColor=#94A3B8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="480" width="300" height="42" />
        </mxCell>
        <mxCell id="setup-token" value="Use a token instead" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#EFF6FF;strokeColor=#94A3B8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="540" width="300" height="42" />
        </mxCell>
        <mxCell id="setup-close" value="Close" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#EFF6FF;strokeColor=#94A3B8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="60" y="610" width="300" height="42" />
        </mxCell>
        <mxCell id="pending-title" value="&lt;b&gt;GC03 - Waiting for GitHub&lt;/b&gt;&lt;br/&gt;GitHub connections" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="435" y="140" width="330" height="80" />
        </mxCell>
        <mxCell id="pending-copy" value="[progress indicator]&lt;br/&gt;&lt;br/&gt;Complete sign-in in your browser.&lt;br/&gt;&lt;br/&gt;Cancelling stops this attempt. It does not remove an existing connection or revoke consent at GitHub." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="435" y="230" width="330" height="225" />
        </mxCell>
        <mxCell id="pending-cancel" value="Cancel sign-in" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#EFF6FF;strokeColor=#94A3B8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="450" y="540" width="300" height="42" />
        </mxCell>
        <mxCell id="ready-title" value="&lt;b&gt;GC01 - Confirm access&lt;/b&gt;&lt;br/&gt;Verified GitHub account" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="825" y="140" width="330" height="80" />
        </mxCell>
        <mxCell id="ready-copy" value="Account: verified login from GitHub&lt;br/&gt;&lt;br/&gt;Repositories:&lt;br/&gt;[ ] accessible repository choice&lt;br/&gt;[ ] accessible repository choice&lt;br/&gt;&lt;br/&gt;Select only repositories Laomedo may read.&lt;br/&gt;This does not permit Agent runs or writes." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="825" y="230" width="330" height="225" />
        </mxCell>
        <mxCell id="ready-save" value="Allow selected repository reads" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#EFF6FF;strokeColor=#94A3B8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="540" width="300" height="42" />
        </mxCell>
        <mxCell id="ready-close" value="Cancel" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#EFF6FF;strokeColor=#94A3B8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="840" y="610" width="300" height="42" />
        </mxCell>
        <mxCell id="manager-note" value="Entry: Settings - GitHub connections. The configured/ready list shows account, mode and state, selected repositories, Edit access, Reconnect and Disconnect. Closing the panel does not disconnect a ready account. All actions are owner/session bound." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="735" width="1140" height="110" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="source" name="GC05-GC07 - Private Skill selection">
    <mxGraphModel dx="1200" dy="900" grid="1" page="1" pageWidth="1200" pageHeight="900">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Skill Source - explicit private connection, immutable selection&lt;br/&gt;&lt;b&gt;PROPOSED / NOT IMPLEMENTED - specs #410 / Laomedo #251&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1140" height="80" />
        </mxCell>
        <mxCell id="node" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="125" width="360" height="630" />
        </mxCell>
        <mxCell id="node-title" value="&lt;b&gt;Skill&lt;/b&gt;&lt;br/&gt;Use and edit versioned skill files." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="140" width="330" height="80" />
        </mxCell>
        <mxCell id="node-source" value="Source&lt;br/&gt;[ HTTPS repository URL ]" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#F1F5F9;strokeColor=#94A3B8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="230" width="330" height="70" />
        </mxCell>
        <mxCell id="node-skill" value="Skill&lt;br/&gt;[ searchable discovered choices ]" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#F1F5F9;strokeColor=#94A3B8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="315" width="330" height="70" />
        </mxCell>
        <mxCell id="node-operation" value="Operation&lt;br/&gt;[ existing operation input ]" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#F1F5F9;strokeColor=#94A3B8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="400" width="330" height="65" />
        </mxCell>
        <mxCell id="node-advanced" value="v Advanced settings&lt;br/&gt;&lt;br/&gt;Connection [ Anonymous / selected account ]&lt;br/&gt;Revision [ exact discovered revision ]&lt;br/&gt;Base Commit [ existing control ]" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#F1F5F9;strokeColor=#94A3B8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="480" width="330" height="145" />
        </mxCell>
        <mxCell id="node-open" value="Skill files" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#EFF6FF;strokeColor=#94A3B8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="670" width="300" height="42" />
        </mxCell>
        <mxCell id="source-private" value="&lt;b&gt;GC05 - Private source selected&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;The backend derives owner/session and current generation. A saved graph contains only the opaque connection reference and existing source/Skill/revision pins.&lt;br/&gt;&lt;br/&gt;Public anonymous and allowed local sources remain available; a private failure never silently switches identity." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="455" y="140" width="690" height="215" />
        </mxCell>
        <mxCell id="locked" value="&lt;b&gt;GC06 - Private view locked&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Reconnect to verify access to this Skill.&lt;br/&gt;Source text and exact pin stay selected.&lt;br/&gt;&lt;br/&gt;File contents, binary previews and history are hidden after disconnect. Already delivered bytes cannot be recalled." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="455" y="400" width="690" height="190" />
        </mxCell>
        <mxCell id="locked-action" value="Manage GitHub connections" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#EFF6FF;strokeColor=#94A3B8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="650" y="620" width="300" height="42" />
        </mxCell>
        <mxCell id="source-note" value="GC07 - Missing or refused access: &quot;Access to this repository could not be confirmed.&quot; Technical details retain only the safe machine code. A GitHub 404 never labels a repository private or nonexistent. Connection refresh repeats reads only." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="785" width="1100" height="90" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
