        <mxCell id="setup-and-ready--notice" value="Changing app credentials, read consent or connection identity is explicit. Disconnect fences old requests before deleting local credentials, hides private views and reports removal failures. It does not claim that GitHub consent was revoked. No existing app registration or credential is borrowed." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="5875.0" width="1140" height="100" />
        </mxCell>
        <mxCell id="setup-and-ready--ready-install" value="Install / manage app repositories" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;fillColor=#EFF6FF;strokeColor=#94A3B8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1" actionRef="N05">
          <mxGeometry as="geometry" x="3095.0" y="5495.0" width="500" height="40" />
        </mxCell>
      <mxCell id="attempt-transitions--title" value="&lt;b&gt;Pending request transitions and navigation&lt;/b&gt;&lt;br/&gt;PROPOSED / NOT IMPLEMENTED - each row is an explicit transition" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="6820.0" width="1140" height="75" />
        </mxCell>
        <mxCell id="attempt-transitions--invariant" value="A pending request is separate from a persisted connection. Every attempt captures owner/session, attempt ID, optional replacement connection and expected generation. Until P05 commits, any previous Ready connection stays unchanged." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="6905.0" width="1140" height="85" />
        </mxCell>
        <mxCell id="attempt-transitions--P01" value="&lt;b&gt;P01&lt;/b&gt;  Idle -&gt; C02 Authorizing: Connect GitHub; require configured app and supported owner session." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7010.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--P02" value="&lt;b&gt;P02&lt;/b&gt;  Idle -&gt; C06 Token entry -&gt; Verifying: submit deliberate token; clear input, no ambient fallback." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7054.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--P03" value="&lt;b&gt;P03&lt;/b&gt;  C02 Authorizing -&gt; Verifying: exact callback, matching state/PKCE/session, one-use claim." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7098.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--P04" value="&lt;b&gt;P04&lt;/b&gt;  Verifying -&gt; C03 Awaiting consent: verified principal; show repositories or C11 verified-empty state." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7142.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--P05" value="&lt;b&gt;P05&lt;/b&gt;  C03 -&gt; C10 Ready: explicit selected-repository consent; commit vault and metadata atomically." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7186.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--P06" value="&lt;b&gt;P06&lt;/b&gt;  C02/C03/C06/C11 -&gt; Idle: Cancel; discard provisional request/secrets only, preserve previous Ready." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7230.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--P07" value="&lt;b&gt;P07&lt;/b&gt;  C02 callback declined OR Verifying token/wrong-account refused -&gt; E02; preserve previous Ready." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7274.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--P08" value="&lt;b&gt;P08&lt;/b&gt;  C02 -&gt; E03: expired or replayed callback; invalidate attempt, preserve previous Ready." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7318.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--P09" value="&lt;b&gt;P09&lt;/b&gt;  Stale concurrent attempt -&gt; E03: expected generation changed; it cannot replace newer Ready." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7362.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--P10" value="&lt;b&gt;P10&lt;/b&gt;  Pending/exchanging -&gt; C08 after restart/crash: invalidate or require new sign-in; no exchange replay." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7406.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--navtitle" value="&lt;b&gt;Navigation controls (state IDs refer to cards on the other pages)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7470.0" width="1140" height="45" />
        </mxCell>
        <mxCell id="attempt-transitions--N01" value="&lt;b&gt;N01&lt;/b&gt;  C01 View app setup -&gt; C09. C09 Cancel -&gt; C01, no settings or registration effect." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7520.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--N02" value="&lt;b&gt;N02&lt;/b&gt;  C09 Save app credentials -&gt; C12 configured Connect GitHub control; E01 on vault failure." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7564.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--N03" value="&lt;b&gt;N03&lt;/b&gt;  C04 Skill files -&gt; authorized exact files or C05 locked viewer; never public fallback." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7608.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--N04" value="&lt;b&gt;N04&lt;/b&gt;  C05 Manage GitHub connections -&gt; C10 owned connection manager; preserve Source/pins." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7652.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--N05" value="&lt;b&gt;N05&lt;/b&gt;  C03/C10/C11 Install / manage -&gt; configured app-specific GitHub install URL; refresh explicitly on return." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7696.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--N06" value="&lt;b&gt;N06&lt;/b&gt;  C11 Refresh repository list -&gt; Verifying -&gt; C03/C11 or safe access error; no automatic consent." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7740.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--N07" value="&lt;b&gt;N07&lt;/b&gt;  C10 Edit repository access -&gt; C03 for that connection; existing consent unchanged until confirm." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7784.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--N08" value="&lt;b&gt;N08&lt;/b&gt;  C10 Connect another account -&gt; new P01 request with independent connection ID; existing Ready retained." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7828.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--navnote" value="Close on a ready manager closes only the panel. Token Cancel clears the input. Pending has Cancel sign-in only. The C12 primary is Connect GitHub; Use a token instead remains available." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="8155.0" width="1140" height="75" />
        </mxCell>
        <mxCell id="attempt-transitions--N09" value="&lt;b&gt;N09&lt;/b&gt;  E01/E04/E05 Open setup instructions -&gt; H01 with vault/removal/app-login section selected; close returns to error." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7880.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--N10" value="&lt;b&gt;N10&lt;/b&gt;  E02 Use a different credential -&gt; C06 for a token attempt or P01 for browser reconnect; no account fallback." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7924.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--N11" value="&lt;b&gt;N11&lt;/b&gt;  E03/C08 Start a new sign-in -&gt; fresh P01; invalidate old attempt first, keep unrelated Ready records." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="7968.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--N12" value="&lt;b&gt;N12&lt;/b&gt;  E01-E05 Dismiss -&gt; close notification only; keep locked/fenced state and do not restart work." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="8012.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--N13" value="&lt;b&gt;N13&lt;/b&gt;  E04 Retry credential removal -&gt; retry local vault deletion for already fenced generation; success closes E04." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="8056.0" width="1140" height="44" />
        </mxCell>
        <mxCell id="attempt-transitions--N14" value="&lt;b&gt;N14&lt;/b&gt;  C11 Cancel -&gt; P06, discard pending consent and temporary token; preserve prior ready connection." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="8100.0" width="1140" height="44" />
        </mxCell>
      <mxCell id="connection-transitions--title" value="&lt;b&gt;Persisted connection and private read transitions&lt;/b&gt;&lt;br/&gt;PROPOSED / NOT IMPLEMENTED - one lifecycle per selected connection" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="6820.0" width="1140" height="80" />
        </mxCell>
        <mxCell id="connection-transitions--R01" value="&lt;b&gt;R01&lt;/b&gt;  C10 Ready -&gt; Verify access -&gt; release private read only for current owner/session/generation/repository." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="6925.0" width="1140" height="65" />
        </mxCell>
        <mxCell id="connection-transitions--R02" value="&lt;b&gt;R02&lt;/b&gt;  Access verification fails/offline -&gt; C05 locked; preserve pins, never serve warm-cache authorization." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="6990.0" width="1140" height="65" />
        </mxCell>
        <mxCell id="connection-transitions--R03" value="&lt;b&gt;R03&lt;/b&gt;  Ready/C07 -&gt; replacement pending request: Reconnect/rotate; old record remains until P05 or verified expiry." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="7055.0" width="1140" height="65" />
        </mxCell>
        <mxCell id="connection-transitions--R04" value="&lt;b&gt;R04&lt;/b&gt;  Ready -&gt; C03 Edit access -&gt; Ready on confirmed new consent/generation; Cancel preserves prior consent." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="7120.0" width="1140" height="65" />
        </mxCell>
        <mxCell id="connection-transitions--R05" value="&lt;b&gt;R05&lt;/b&gt;  Ready -&gt; C07 Reauthorization required on verified expiry/revocation; hide private queries." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="7185.0" width="1140" height="65" />
        </mxCell>
        <mxCell id="connection-transitions--R06" value="&lt;b&gt;R06&lt;/b&gt;  Refresh in progress -&gt; C08 on crash/unknown refresh; no consumed-token replay; reconnect explicitly." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="7250.0" width="1140" height="65" />
        </mxCell>
        <mxCell id="connection-transitions--R07" value="&lt;b&gt;R07&lt;/b&gt;  C10 manager (including a connection in C07/C08) -&gt; Disconnected: fence generation first, clear private queries, then remove vault entries." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="7315.0" width="1140" height="65" />
        </mxCell>
        <mxCell id="connection-transitions--R08" value="&lt;b&gt;R08&lt;/b&gt;  Vault deletion incomplete -&gt; E04: access stays fenced; report partial removal, never return to Ready." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="7380.0" width="1140" height="65" />
        </mxCell>
        <mxCell id="connection-transitions--invariant" value="Every direct private route verifies its owner/session in the native Windows app backend. Existing public source/operation services cannot dispatch private requests. An in-flight response rechecks generation before release. Rotation/disconnect cannot erase previously delivered bytes or establish provider-side revocation." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="7490.0" width="1140" height="110" />
        </mxCell>
