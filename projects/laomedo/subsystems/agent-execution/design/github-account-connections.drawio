        <mxCell id="limits" value="GC10 - Loopback single-owner Windows only. Under unsupported app authentication, private controls refuse and link to setup instructions; public/local browsing continues. No running login setting is changed automatically. Concurrent browser-profile use is not claimed until tested." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
