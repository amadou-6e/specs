s, amadou/private-specs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1684" y="752" width="1090" height="35" as="geometry" /></mxCell><mxCell id="edit" value="Change repositories" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#f4f4f5;strokeColor=#f4f4f5;fontColor=#18181b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1684" y="813" width="280" height="42" as="geometry" /></mxCell><mxCell id="detail-reconnect" value="Reconnect" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1984" y="813" width="210" height="42" as="geometry" /></mxCell><mxCell id="disconnect" value="Disconnect locally" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="2214" y="813" width="250" height="42" as="geometry" /></mxCell><mxCell id="screen-c" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#17171c;" vertex="1" parent="1"><mxGeometry x="1660" y="940" width="1150" height="330" as="geometry" /></mxCell><mxCell id="screen-c-heading" value="C  Choose repository access" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1684" y="958" width="1102" height="35" as="geometry" /></mxCell><mxCell id="screen-c-subtitle" value="Verified GitHub account: @amadou. Select repositories explicitly." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=15;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="1684" y="1001" width="1102" height="38" as="geometry" /></mxCell><mxCell id="repo-choice" value="[ ] amadou/my-skills&#10;[ ] amadou/private-specs" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="1684" y="1050" width="1102" height="85" as="geometry" /></mxCell><mxCell id="confirm" value="Allow selected reads" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#f4f4f5;strokeColor=#f4f4f5;fontColor=#18181b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1684" y="1165" width="290" height="44" as="geometry" /></mxCell><mxCell id="consent-cancel" value="Cancel" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1994" y="1165" width="150" height="44" as="geometry" /></mxCell><mxCell id="install-link" value="Manage App repositories on GitHub   |   Refresh repositories" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="2160" y="1165" width="610" height="44" as="geometry" /></mxCell><mxCell id="map-a" value="Screen A" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=14;labelBackgroundColor=#101014;dashed=1;strokeColor=#3b82f6;endArrow=open;opacity=45;exitX=1;exitY=0;entryX=0;entryY=0;" edge="1" parent="1" source="list" target="screen-a"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="270" /></Array></mxGeometry></mxCell><mxCell id="map-b" value="Screen B" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=14;labelBackgroundColor=#101014;dashed=1;strokeColor=#3b82f6;endArrow=open;opacity=45;exitX=1;exitY=0;entryX=0;entryY=0;" edge="1" parent="1" source="detail" target="screen-b"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="620" /></Array></mxGeometry></mxCell><mxCell id="map-c" value="Screen C" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=14;labelBackgroundColor=#101014;dashed=1;strokeColor=#3b82f6;endArrow=open;opacity=45;exitX=1;exitY=0;entryX=0;entryY=0;" edge="1" parent="1" source="consent" target="screen-c"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1550" y="920" /></Array></mxGeometry></mxCell><mxCell id="secondary-heading" value="03  Setup and recovery - used only when needed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="1400" width="2750" height="45" as="geometry" /></mxCell><mxCell id="screen-d" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#17171c;" vertex="1" parent="1"><mxGeometry x="50" y="1470" width="1430" height="315" as="geometry" /></mxCell><mxCell id="screen-d-heading" value="D  Installation-wide GitHub App setup" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="74" y="1488" width="1382" height="35" as="geometry" /></mxCell><mxCell id="screen-d-subtitle" value="One-time host setup. Does not create or sign in an account connection." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=15;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="74" y="1531" width="1382" height="38" as="geometry" /></mxCell><mxCell id="register" value="Register GitHub App" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#f4f4f5;strokeColor=#f4f4f5;fontColor=#18181b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="74" y="1580" width="320" height="45" as="geometry" /></mxCell><mxCell id="setup-guidance" value="Contents read-only; expiring user tokens. Install on intended repositories.&#10;Callback: copy the exact read-only value shown by this installation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=15;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="414" y="1575" width="1020" height="65" as="geometry" /></mxCell><mxCell id="client" value="Client ID" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="74" y="1670" width="350" height="40" as="geometry" /></mxCell><mxCell id="slug" value="App slug" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="444" y="1670" width="300" height="40" as="geometry" /></mxCell><mxCell id="secret" value="Client secret - masked" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="764" y="1670" width="390" height="40" as="geometry" /></mxCell><mxCell id="save-app" value="Save configuration" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#f4f4f5;strokeColor=#f4f4f5;fontColor=#18181b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1174" y="1670" width="280" height="40" as="geometry" /></mxCell><mxCell id="setup-return" value="Save succeeds &gt; return to A. Add connection is now available. Cancel changes nothing. Token entry remains a deliberate secondary method." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="74" y="1730" width="1380" height="38" as="geometry" /></mxCell><mxCell id="screen-e" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#17171c;" vertex="1" parent="1"><mxGeometry x="1660" y="1470" width="1150" height="315" as="geometry" /></mxCell><mxCell id="screen-e-heading" value="E  Recovery message" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1684" y="1488" width="1102" height="35" as="geometry" /></mxCell><mxCell id="screen-e-subtitle" value="One concise message, one primary recovery action, and Dismiss." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=15;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="1684" y="1531" width="1102" height="38" as="geometry" /></mxCell><mxCell id="error-title" value="This sign-in attempt has ended" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1684" y="1590" width="1090" height="36" as="geometry" /></mxCell><mxCell id="error-copy" value="Your saved connections have not changed. Start a new sign-in to continue." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=16;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="1684" y="1635" width="1090" height="40" as="geometry" /></mxCell><mxCell id="retry" value="Start a new sign-in" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#f4f4f5;strokeColor=#f4f4f5;fontColor=#18181b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1684" y="1710" width="300" height="44" as="geometry" /></mxCell><mxCell id="dismiss" value="Dismiss" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="2004" y="1710" width="170" height="44" as="geometry" /></mxCell><mxCell id="map-d" value="Screen D" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=14;labelBackgroundColor=#101014;dashed=1;strokeColor=#3b82f6;endArrow=open;opacity=45;exitX=0.5;exitY=1;entryX=0.2;entryY=0;exitX=0;exitY=0.5;entryX=0.1;entryY=0;" edge="1" parent="1" source="setup" target="screen-d"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="30" y="1082" /><mxPoint x="30" y="1440" /><mxPoint x="190" y="1440" /></Array></mxGeometry></mxCell><mxCell id="map-e" value="Screen E" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=14;labelBackgroundColor=#101014;dashed=1;strokeColor=#3b82f6;endArrow=open;opacity=45;exitX=1;exitY=0.5;entryX=0;entryY=0;" edge="1" parent="1" source="failure" target="screen-e"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1570" y="1082" /><mxPoint x="1570" y="1470" /></Array></mxGeometry></mxCell><mxCell id="coverage-title" value="04  Recovery and variant map - references resolve to Screens A-F" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="2150.0" width="2750" height="45" as="geometry" /></mxCell><mxCell id="variant0" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#19191f;" vertex="1" parent="1"><mxGeometry x="50" y="2220.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title0" value="Empty list / no App" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="2230.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy0" value="A: no saved entries &gt; Add (browser). Missing App setup &gt; D; token alternative F stays available. Setup success enables browser Add, never read consent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#d4d4d8;" vertex="1" parent="1"><mxGeometry x="64" y="2266.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids0" value="C01, C09, C12; N01-N02, N17" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=12;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="64" y="2358.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant1" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#19191f;" vertex="1" parent="1"><mxGeometry x="750" y="2220.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title1" value="Pending / cancel / stale attempt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="764" y="2230.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy1" value="GitHub pending is separate from saved entries. Cancel clears provisional secrets only. Expired, replayed or stale generation &gt; E, fresh sign-in." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#d4d4d8;" vertex="1" parent="1"><mxGeometry x="764" y="2266.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids1" value="C02, C08, E03; P01, P03, P06, P08-P10; N11" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=12;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="764" y="2358.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant2" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#19191f;" vertex="1" parent="1"><mxGeometry x="1450" y="2220.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title2" value="Wrong account / token entry" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1464" y="2230.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy2" value="Reconnect requires the expected account. Browser entry &gt; GitHub; token entry &gt; F replaces its token. Verify and confirm before updating the same entry. Clear masked input on submit/cancel." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#d4d4d8;" vertex="1" parent="1"><mxGeometry x="1464" y="2266.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids2" value="C06, E02; P02, P07; N10" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=12;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="1464" y="2358.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant3" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#19191f;" vertex="1" parent="1"><mxGeometry x="2150" y="2220.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title3" value="Consent / empty access" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2164" y="2230.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy3" value="C: none selected by default. Empty list shows Manage App repositories, Refresh and Cancel. Refresh verifies again; no automatic consent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#d4d4d8;" vertex="1" parent="1"><mxGeometry x="2164" y="2266.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids3" value="C03, C11; P04-P05; N05-N08, N14" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=12;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="2164" y="2358.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant4" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#19191f;" vertex="1" parent="1"><mxGeometry x="50" y="2425.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title4" value="Expired / renamed / offline" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="2435.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy4" value="B: reconnect explicitly on verified expiry or rename/transfer. Offline reads stay locked; do not assert revocation. Preserve pins; no public or account fallback." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#d4d4d8;" vertex="1" parent="1"><mxGeometry x="64" y="2471.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids4" value="C05, C07; R01-R05; SC04, SC06" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=12;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="64" y="2563.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant5" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#19191f;" vertex="1" parent="1"><mxGeometry x="750" y="2425.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title5" value="Disconnect / cleanup failure" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="764" y="2435.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy5" value="Fence reads, clear private views, then remove local credentials. E: removal incomplete &gt; Retry removal. Never say GitHub consent was revoked." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#d4d4d8;" vertex="1" parent="1"><mxGeometry x="764" y="2471.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids5" value="E04; R07-R08; N13" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=12;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="764" y="2563.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant6" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#19191f;" vertex="1" parent="1"><mxGeometry x="1450" y="2425.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title6" value="Crash / lost refresh" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1464" y="2435.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy6" value="Unknown refresh outcome &gt; B reconnect, no consumed-token replay. Broker restart invalidates pending only; unrelated ready connections stay unchanged." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#d4d4d8;" vertex="1" parent="1"><mxGeometry x="1464" y="2471.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids6" value="C08; P10; R03, R06; N11" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=12;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="1464" y="2563.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant7" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#19191f;" vertex="1" parent="1"><mxGeometry x="2150" y="2425.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title7" value="Vault / unsupported setup" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2164" y="2435.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy7" value="E: no connection saved on vault failure. Unsupported app session &gt; setup instructions; no plaintext fallback or automatic auth-setting change." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#d4d4d8;" vertex="1" parent="1"><mxGeometry x="2164" y="2471.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids7" value="E01, E05, H01; N09, N15" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=12;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="2164" y="2563.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant8" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#19191f;" vertex="1" parent="1"><mxGeometry x="50" y="2630.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title8" value="Private Skill source / viewer" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="2640.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy8" value="Source keeps explicit Anonymous/account choice and immutable pins. Failed access locks files/history. Manage connections opens A/B; never dispatch an Agent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#d4d4d8;" vertex="1" parent="1"><mxGeometry x="64" y="2676.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids8" value="C04-C05; N03-N04; R01-R02" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=12;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="64" y="2768.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant9" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#19191f;" vertex="1" parent="1"><mxGeometry x="750" y="2630.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title9" value="App-session recovery" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="764" y="2640.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy9" value="Missing private lease with valid app login &gt; Sign in again (Laomedo). Confirm logout then normal login; failure &gt; Retry sign-out. Keep GitHub entry and pins." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#d4d4d8;" vertex="1" parent="1"><mxGeometry x="764" y="2676.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids9" value="C13-C14; N18-N20" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=12;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="764" y="2768.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant10" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#19191f;" vertex="1" parent="1"><mxGeometry x="1450" y="2630.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title10" value="Dismiss / close / late responses" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1464" y="2640.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy10" value="Dismiss hides the message only; never retries or unlocks. Close changes no connection. Owner/session/generation rechecked before bytes; stale reply cannot reopen views." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#d4d4d8;" vertex="1" parent="1"><mxGeometry x="1464" y="2676.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids10" value="N12, N16; R01-R02, R07-R08" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=12;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="1464" y="2768.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant11" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#19191f;" vertex="1" parent="1"><mxGeometry x="2150" y="2630.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title11" value="Open decisions / draft scope" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2164" y="2640.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy11" value="Account labels shown; custom names and duplicate-account policy unresolved. Connection selection in source picker vs settings unresolved. Operator entry placement unresolved." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#d4d4d8;" vertex="1" parent="1"><mxGeometry x="2164" y="2676.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids11" value="All screens proposed; no runtime acceptance" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=12;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="2164" y="2768.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="footer" value="DRAFT FOR DISCUSSION - Read graph 01, inspect screens 02, consult variants 03/04 only as needed. Prior studies are in Git history. No credentials or real authorization state." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="50" y="2850.0" width="2800" height="40" as="geometry" /></mxCell><mxCell id="ui-token" value="Use a token instead" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="2270" y="308" width="235" height="34" as="geometry" /></mxCell><mxCell id="token" value="F  Token entry&#10;No App required" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;strokeColor=#60a5fa;" vertex="1" parent="1"><mxGeometry x="530" y="1170" width="270" height="75" as="geometry" /></mxCell><mxCell id="token-choice" value="Use a token instead" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=13;labelBackgroundColor=#101014;exitX=1;exitY=0.8;entryX=0;entryY=0.5;" edge="1" parent="1" source="list" target="token"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="510" y="400" /><mxPoint x="510" y="1207" /></Array></mxGeometry></mxCell><mxCell id="verify-token" value="Verify token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=13;labelBackgroundColor=#101014;exitX=1;exitY=0.5;entryX=0.5;entryY=1;" edge="1" parent="1" source="token" target="verify"><mxGeometry relative="1" as="geometry" x="-0.85" y="0"><Array as="points"><mxPoint x="830" y="1207" /><mxPoint x="830" y="620" /><mxPoint x="995" y="620" /></Array><mxPoint x="30" y="-15" as="offset" /></mxGeometry></mxCell><mxCell id="token-cancel" value="Cancel - no change" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=13;labelBackgroundColor=#101014;dashed=1;exitX=0;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="token" target="list"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="480" y="1270" /><mxPoint x="90" y="1270" /><mxPoint x="90" y="270" /><mxPoint x="280" y="270" /></Array></mxGeometry></mxCell><mxCell id="edit-access" value="Change repositories" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=13;labelBackgroundColor=#101014;dashed=1;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail" target="consent"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1430" y="332" /><mxPoint x="1430" y="470" /><mxPoint x="1350" y="470" /></Array></mxGeometry></mxCell><mxCell id="disconnect-return" value="Disconnect locally" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=13;labelBackgroundColor=#101014;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail" target="list"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1225" y="265" /><mxPoint x="350" y="265" /></Array></mxGeometry></mxCell><mxCell id="disconnect-incomplete" value="Cleanup incomplete" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=13;labelBackgroundColor=#101014;dashed=1;exitX=1;exitY=0.7;entryX=0.5;entryY=0;" edge="1" parent="1" source="detail" target="failure"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1470" y="350" /><mxPoint x="1470" y="975" /><mxPoint x="1060" y="975" /></Array></mxGeometry></mxCell><mxCell id="setup-ready" value="Saved - return" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=13;labelBackgroundColor=#101014;dashed=1;exitX=0;exitY=0.7;entryX=0.5;entryY=1;" edge="1" parent="1" source="setup" target="list"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="1080" /><mxPoint x="150" y="400" /><mxPoint x="350" y="400" /></Array></mxGeometry></mxCell><mxCell id="dismiss-return" value="Dismiss" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=13;labelBackgroundColor=#101014;dashed=1;exitX=0;exitY=0.8;entryX=0.1;entryY=0;" edge="1" parent="1" source="failure" target="list"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="850" y="1150" /><mxPoint x="75" y="1150" /><mxPoint x="75" y="250" /><mxPoint x="245" y="250" /></Array></mxGeometry></mxCell><mxCell id="retry-flow" value="New browser attempt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=13;labelBackgroundColor=#101014;dashed=1;exitX=0;exitY=0.3;entryX=0.5;entryY=0;" edge="1" parent="1" source="failure" target="github"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="810" y="1070" /><mxPoint x="810" y="465" /><mxPoint x="665" y="465" /></Array></mxGeometry></mxCell><mxCell id="screen-f" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#17171c;" vertex="1" parent="1"><mxGeometry x="50" y="1830" width="1430" height="270" as="geometry" /></mxCell><mxCell id="token-heading" value="F  Use a fine-grained token" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="74" y="1848" width="1380" height="36" as="geometry" /></mxCell><mxCell id="token-explanation" value="Alternative to browser sign-in. Available even when no GitHub App is configured." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=15;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="74" y="1895" width="1380" height="35" as="geometry" /></mxCell><mxCell id="masked-token" value="Fine-grained token  |  [masked input]" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="74" y="1950" width="850" height="44" as="geometry" /></mxCell><mxCell id="token-submit" value="Verify token" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;fillColor=#f4f4f5;strokeColor=#f4f4f5;fontColor=#18181b;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="944" y="1950" width="235" height="44" as="geometry" /></mxCell><mxCell id="token-back" value="Cancel" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#1c1c22;strokeColor=#3f3f49;fontColor=#e4e4e7;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1199" y="1950" width="250" height="44" as="geometry" /></mxCell><mxCell id="token-contract" value="Clear the field on submit or cancel. Never store it in a graph. Verify &gt; C (explicit repository consent) or E (classic, invalid, expired or wrong-account token). Cancel preserves all saved connections." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#e4e4e7;fontSize=16;spacing=4;fontSize=14;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="74" y="2020" width="1380" height="55" as="geometry" /></mxCell><mxCell id="map-f" value="Screen F" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=13;labelBackgroundColor=#101014;dashed=1;strokeColor=#3b82f6;endArrow=open;opacity=45;exitX=0;exitY=1;entryX=0.3;entryY=0;exitX=1;exitY=1;entryX=1;entryY=0.2;" edge="1" parent="1" source="token" target="screen-f"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="800" y="1290" /><mxPoint x="1515" y="1290" /><mxPoint x="1515" y="1884" /></Array></mxGeometry></mxCell><mxCell id="replace-token" value="Replace token - same entry/account" style="edgeStyle=orthogonalEdgeStyle;rounded=1;dashed=1;endArrow=block;strokeColor=#71717a;fontColor=#d4d4d8;fontSize=13;labelBackgroundColor=#101014;exitX=1;exitY=0.9;entryX=1;entryY=0.7;" edge="1" parent="1" source="detail" target="token"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1590" y="365" /><mxPoint x="1590" y="1270" /><mxPoint x="825" y="1270" /><mxPoint x="825" y="1220" /></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>