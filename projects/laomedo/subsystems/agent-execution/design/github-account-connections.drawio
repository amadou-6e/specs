                <mxCell id="e1-body" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=0;fontSize=16;fontColor=#71717a;fontStyle=0;align=left;" value="Your account and repository choices are kept.&#10;Continue on GitHub to try again." vertex="1">
