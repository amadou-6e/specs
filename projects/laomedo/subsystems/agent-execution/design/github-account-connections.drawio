<diagram id="signin-workshop" name="Workshop - Sign in with GitHub"><mxGraphModel grid="1" page="1" pageWidth="1720" pageHeight="1000" background="#09090b"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Workshop - Sign in with GitHub" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1550" height="50" as="geometry"/></mxCell><mxCell id="subtitle" value="DESIGN WORKSHOP - Proposed, not accepted - Edit the screens and transitions together" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1550" height="34" as="geometry"/></mxCell><mxCell id="card0" value="" style="rounded=1;arcSize=4;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="40" y="160" width="370" height="610" as="geometry"/></mxCell><mxCell id="heading0" value="GitHub connections" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="185" width="330" height="46" as="geometry"/></mxCell><mxCell id="desc0" value="Connect an account to browse private skills in the repositories you choose." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="60" y="242" width="330" height="85" as="geometry"/></mxCell><mxCell id="row0-0" value="Sign in with GitHub" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#fafafa;fontColor=#18181b;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="330" height="48" as="geometry"/></mxCell><mxCell id="row0-1" value="No App registration or credentials in this flow." style="text;ht