        <mxCell id="help--help-vault" value="&lt;b&gt;help-vault&lt;/b&gt;  Vault: use the supported Windows credential store. A missing backend saves nothing; do not fall back to a plaintext file." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="8630.0" width="1140" height="110" />
        </mxCell>
        <mxCell id="help--help-removal" value="&lt;b&gt;help-removal&lt;/b&gt;  Credential removal: private access is already blocked. Retry removes only the selected Laomedo-owned vault entries; never unrelated credentials." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="8770.0" width="1140" height="110" />
        </mxCell>
        <mxCell id="help--help-login" value="&lt;b&gt;help-login&lt;/b&gt;  App login: private access requires normal Laomedo sign-in and the configured local owner. Auto-login previews remain public/local only; no service setting changes automatically." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="2480.0" y="8910.0" width="1140" height="110" />
        </mxCell>
        <mxCell id="help--N15" value="&lt;b&gt;N15&lt;/b&gt; Close instructions -&gt; return to the originating E01/E04/E05 state; no configuration, credential or connection effect." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
