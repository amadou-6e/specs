  <diagram id="help" name="Setup instructions and recovery targets">
    <mxGraphModel dx="1200" dy="900" grid="1" page="1" pageWidth="1200" pageHeight="960">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="help-title" value="&lt;b&gt;H01 - Local setup instructions&lt;/b&gt;&lt;br&gt;PROPOSED / NOT IMPLEMENTED" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="30" width="1140" height="60" />
        </mxCell>
        <mxCell id="help-vault" value="&lt;b&gt;help-vault&lt;/b&gt;  Vault: use the supported Windows credential store. A missing backend saves nothing; do not fall back to a plaintext file." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="130" width="1140" height="110" />
        </mxCell>
        <mxCell id="help-removal" value="&lt;b&gt;help-removal&lt;/b&gt;  Credential removal: private access is already blocked. Retry removes only the selected Laomedo-owned vault entries; never unrelated credentials." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="270" width="1140" height="110" />
        </mxCell>
        <mxCell id="help-login" value="&lt;b&gt;help-login&lt;/b&gt;  App login: private access requires normal Laomedo sign-in and the configured local owner. Auto-login previews remain public/local only; no service setting changes automatically." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="410" width="1140" height="110" />
        </mxCell>
        <mxCell id="N15" value="&lt;b&gt;N15&lt;/b&gt; Close instructions -&gt; return to the originating E01/E04/E05 state; no configuration, credential or connection effect." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="650" width="1140" height="70" />
        </mxCell>
        <mxCell id="N16" value="&lt;b&gt;N16&lt;/b&gt;  C01/C12/C07/C08/C10/C13/C14 Close -&gt; close panel only, no disconnect or retry; persistent state stays unchanged." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="730" width="1140" height="44" />
        </mxCell>
        <mxCell id="N17" value="&lt;b&gt;N17&lt;/b&gt;  C09 Open GitHub App registration -&gt; fixed https://github.com/settings/apps/new with reviewed read-only configuration; owner submits explicitly." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="790" width="1140" height="60" />
        </mxCell>
        <mxCell id="help-close-button" value="Close instructions" style="rounded=1;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=center;verticalAlign=middle;fillColor=#EFF6FF;strokeColor=#94A3B8;" vertex="1" parent="1" actionRef="N15">
          <mxGeometry x="40" y="550" width="220" height="38" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
