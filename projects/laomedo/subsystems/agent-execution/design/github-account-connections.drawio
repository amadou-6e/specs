        <mxCell id="viewer-shell-note" value="Skill-files viewer state C05; file buffers and history are cleared on lock. Manage connections opens C10." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="455" y="705" width="690" height="65" />
