        <mxCell id="retry-cleanup" value="Retry removal" style="edgeStyle=none;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;entryPerimeter=0;strokeColor=#64748b;strokeWidth=1.5;endArrow=classic;startArrow=none;dashed=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontSize=13;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cleanup-error" target="list">
