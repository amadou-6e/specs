        <mxCell id="notice" value="Changing app credentials, read consent or connection identity is explicit. Disconnect fences old requests before deleting local credentials, hides private views and reports removal failures. It does not claim that GitHub consent was revoked. No existing app registration or credential is borrowed." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
