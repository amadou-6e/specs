<?xml version="1.0" encoding="utf-8"?>
<mxfile host="app.diagrams.net"><diagram id="github-connections" name="GitHub connections"><mxGraphModel grid="0" page="0" pageWidth="4300" pageHeight="6500" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="GitHub connections - one task, two sign-in methods" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=32;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="4000" height="50" as="geometry" /></mxCell><mxCell id="goal" value="Add a connection, choose a method, verify the account, choose repositories, then save. Existing entries keep their identity through edits and recovery." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=19;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="4100" height="45" as="geometry" /></mxCell><mxCell id="legend" value="Screens match by A / B / M / F / C / D / E1 / E2. Arrows show transitions only. Dashed GitHub node = external page; grey nodes = service steps." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=16;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="50" y="155" width="4100" height="38" as="geometry" /></mxCell><mxCell id="graph-title" value="01  Task flow - start at green START" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="210" width="2700" height="45" as="geometry" /></mxCell><mxCell id="attempt-context" value="ATTEMPT CONTEXT - carried through verification, consent, saving and retry&#10;NEW: add a connection. EXISTING: selected connection + expected account + generation.&#10;The chosen method is retained. A retry never changes account or creates a different entry silently. Cancel returns to A (new) or B (existing)." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#eff6ff;align=left;spacingLeft=16;fontSize=17;" vertex="1" parent="1"><mxGeometry x="60" y="1110" width="2800" height="155" as="geometry" /></mxCell><mxCell id="decision-note" value="OPEN OWNER DECISIONS: duplicate accounts, optional connection names, disconnect confirmation and saving zero repositories. None is decided by this workshop." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="60" y="1300" width="2800" height="75" as="geometry" /></mxCell><mxCell id="coverage-title" value="04  Variant and contract map - not additional screens" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="2760.0" width="4100" height="45" as="geometry" /></mxCell><mxCell id="variant0" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="50" y="2830.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title0" value="Empty list / no App" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="2840.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy0" value="A empty: one Add connection action opens M. Both methods belong to Add. Browser unavailable is a disabled option with explicit D setup link; token remains available." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="64" y="2876.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids0" value="C01, C09, C12; N01-N02, N17" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="64" y="2968.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant1" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="750" y="2830.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title1" value="Pending / cancel / stale attempt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="764" y="2840.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy1" value="Pending attempts carry method and target. Cancel returns to origin without changes. Expired/replayed/stale attempts use E1; retries keep context." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="764" y="2876.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids1" value="C02, C08, E03; P01, P03, P06, P08-P10; N11" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="764" y="2968.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant2" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="1450" y="2830.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title2" value="Wrong account / token entry" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1464" y="2840.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy2" value="B routes by stored method: browser Sign in again; token Replace token. Enforce expected account. Failed token retries F, not GitHub. Clear masked input on submit/cancel." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="1464" y="2876.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids2" value="C06, E02; P02, P07; N10" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="1464" y="2968.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant3" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="2150" y="2830.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title3" value="Consent / empty access" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2164" y="2840.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy3" value="C uses verified current repositories. New saves a new entry; edit/reconnect updates the selected entry. Empty access exposes install/refresh only for browser; zero-selection save policy remains open." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="2164" y="2876.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids3" value="C03, C11; P04-P05; N05-N08, N14" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="2164" y="2968.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant4" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="50" y="3035.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title4" value="Expired / renamed / offline" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="3045.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy4" value="Expired or renamed/transferred: reconnect deliberately. Offline/rate-limited access check: E1 Check access again or Back, never forced reauthorization. Pins remain; no public/account fallback." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="64" y="3081.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids4" value="C05, C07; R01-R05; SC04, SC06" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="64" y="3173.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant5" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="750" y="3035.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title5" value="Disconnect / cleanup failure" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="764" y="3045.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy5" value="Disconnect fences reads before local removal. Incomplete deletion uses E2 Retry removal / Close. Close returns to A with access still blocked; no provider-revocation claim." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="764" y="3081.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids5" value="E04; R07-R08; N13" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="764" y="3173.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant6" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="1450" y="3035.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title6" value="Crash / lost refresh" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1464" y="3045.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy6" value="Unknown refresh outcome &gt; B reconnect, no consumed-token replay. Broker restart invalidates pending only; unrelated ready connections stay unchanged." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="1464" y="3081.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids6" value="C08; P10; R03, R06; N11" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="1464" y="3173.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant7" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="2150" y="3035.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title7" value="Vault / unsupported setup" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2164" y="3045.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy7" value="E: no connection saved on vault failure. Unsupported app session &gt; setup instructions; no plaintext fallback or automatic auth-setting change." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="2164" y="3081.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids7" value="E01, E05, H01; N09, N15" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="2164" y="3173.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant8" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="50" y="3240.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title8" value="Private Skill source / viewer" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="3250.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy8" value="Public Anonymous remains distinct from selecting an account in a Skill node. These controls browse private data only, not Agent execution. Pins remain exact and private reads revalidate." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="64" y="3286.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids8" value="C04-C05; N03-N04; R01-R02" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="64" y="3378.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant9" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="750" y="3240.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title9" value="App-session recovery" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="764" y="3250.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy9" value="Missing private lease with valid app login &gt; Sign in again (Laomedo). Confirm logout then normal login; failure &gt; Retry sign-out. Keep GitHub entry and pins." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="764" y="3286.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids9" value="C13-C14; N18-N20" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="764" y="3378.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant10" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="1450" y="3240.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title10" value="Dismiss / close / late responses" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1464" y="3250.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy10" value="Dismiss hides the message only; never retries or unlocks. Close changes no connection. Owner/session/generation rechecked before bytes; stale reply cannot reopen views." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="1464" y="3286.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids10" value="N12, N16; R01-R02, R07-R08" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="1464" y="3378.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant11" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="2150" y="3240.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title11" value="Open decisions / draft scope" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2164" y="3250.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy11" value="Unresolved owner policy: duplicate accounts, optional names, disconnect confirmation, empty selection saving and where source-picker selection belongs. No policy is inferred from cleanup." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="2164" y="3286.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids11" value="All screens proposed; no runtime acceptance" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="2164" y="3378.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="footer" value="DRAFT - Method, target and recovery remain explicit. No real authentication or implementation acceptance is established by this design." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="50" y="3460.0" width="4100" height="40" as="geometry" /></mxCell><mxCell id="github" value="GitHub authorization&#10;External GitHub page" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#18181b;fontSize=15;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="812.0" y="443.556" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="attempt-error" value="E1 - Attempt problem" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#ffffff;strokeColor=#b91c1c;fontColor=#18181b;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1972.0" y="573.27" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="cleanup-error" value="E2 - Removal incomplete" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#ffffff;strokeColor=#b91c1c;fontColor=#18181b;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="812.0" y="812.056" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="origin" value="Return to origin&#10;New: A / existing: B" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#18181b;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="2272.0" y="292.0" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="setup" value="D - Installation setup" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#18181b;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="812.0" y="313.556" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="save" value="Save verified access" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#18181b;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1682.0" y="696.056" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="verify" value="Verify account / repositories&#10;Expected account on reconnect" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#18181b;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1102.0" y="580.056" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="consent" value="C - Choose repositories" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#18181b;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="1392.0" y="522.556" width="230" height="95" as="geometry" />
        </mxCell>
        <mxCell id="detail" value="B - Connection details" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#18181b;fontSize=15;" vertex="1" parent="1">
