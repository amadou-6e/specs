      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Skill Source - explicit private connection, immutable selection&lt;br/&gt;&lt;b&gt;PROPOSED / NOT IMPLEMENTED - specs #410 / Laomedo #251&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
