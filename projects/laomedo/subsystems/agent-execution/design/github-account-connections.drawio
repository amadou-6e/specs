          <mxGeometry as="geometry" x="840.0" y="3880.0" width="300" height="42" />
        </mxCell>
        <mxCell id="manager--configured-state" value="C12 is the configured variant of C01. Its Connect GitHub button owns P01; N02 returns here after secure app setup." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
