        </mxCell>
        <mxCell id="node-advanced" value="v Advanced settings&lt;br/&gt;&lt;br/&gt;Connection [ Anonymous / selected account ]&lt;br/&gt;Revision [ exact discovered revision ]&lt;br/&gt;Base Commit [ existing control ]" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#F1F5F9;strokeColor=#94A3B8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="55" y="480" width="330" height="145" />
        </mxCell>
        <mxCell id="node-open" value="Skill files" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#EFF6FF;strokeColor=#94A3B8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="670" width="300" height="42" />
        </mxCell>
        <mxCell id="source-private" value="&lt;b&gt;GC05 - Private source selected&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;The backend derives owner/session and current generation. A saved graph contains only the opaque connection reference and existing source/Skill/revision pins.&lt;br/&gt;&lt;br/&gt;Public anonymous and allowed local sources remain available; a private failure never silently switches identity." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="455" y="140" width="690" height="215" />
        </mxCell>
        <mxCell id="locked" value="&lt;b&gt;C05 - Skill files: private access locked&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Reconnect to verify access to this Skill.&lt;br/&gt;Source text and exact pin stay selected.&lt;br/&gt;&lt;br/&gt;File contents, binary previews and history stay hidden after disconnect." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="455" y="400" width="690" height="190" />
        </mxCell>
        <mxCell id="locked-action" value="Manage GitHub connections" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#EFF6FF;strokeColor=#94A3B8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="675" y="625" width="300" height="42" />
        </mxCell>
        <mxCell id="source-note" value="GC07 - Missing or refused access: &quot;Access to this repository could not be confirmed.&quot; Technical details retain only the safe machine code. A GitHub 404 never labels a repository private or nonexistent. Connection refresh repeats reads only." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="785" width="1100" height="90" />
