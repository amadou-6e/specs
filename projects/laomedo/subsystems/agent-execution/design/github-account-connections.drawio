          <mxGeometry as="geometry" x="60.0" y="3880.0" width="300" height="42" />
        </mxCell>
        <mxCell id="manager--setup-token" value="Use a token instead" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#EFF6FF;strokeColor=#94A3B8;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="1" actionRef="P02">
