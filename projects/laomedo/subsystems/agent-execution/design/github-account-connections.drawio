<?xml version="1.0" encoding="utf-8"?>
<mxfile host="app.diagrams.net"><diagram id="github-connections" name="GitHub connections"><mxGraphModel grid="1" page="1" pageWidth="4900" pageHeight="10000" background="#09090b"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="connection-state-map--title" value="GitHub connections - State graph" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1490.0" y="25.0" width="1300" height="45" as="geometry" /></mxCell><mxCell id="connection-state-map--intro" value="State graph first. Dashed connectors lead to screens below. One canvas; proposed design for discussion." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="1490.0" y="85.0" width="1250" height="35" as="geometry" /></mxCell><mxCell id="connection-state-map--list" value="S01 | Connections list&#10;Empty or saved connections" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;strokeColor=#60a5fa;" vertex="1" parent="1"><mxGeometry x="1520.0" y="180.0" width="270" height="100" as="geometry" /></mxCell><mxCell id="connection-state-map--details" value="S02 | Selected connection&#10;Account, access and actions" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;strokeColor=#60a5fa;" vertex="1" parent="1"><mxGeometry x="1890.0" y="180.0" width="270" height="100" as="geometry" /></mxCell><mxCell id="connection-state-map--add" value="S03 | Add connection&#10;Sign in with GitHub" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;strokeColor=#60a5fa;" vertex="1" parent="1"><mxGeometry x="1520.0" y="405.0" width="270" height="100" as="geometry" /></mxCell><mxCell id="connection-state-map--oauth" value="S04 | GitHub authorization&#10;External GitHub screen" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;strokeColor=#60a5fa;" vertex="1" parent="1"><mxGeometry x="1890.0" y="405.0" width="270" height="100" as="geometry" /></mxCell><mxCell id="connection-state-map--consent" value="S05 | Repository consent&#10;Verified account; none selected" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;strokeColor=#60a5fa;" vertex="1" parent="1"><mxGeometry x="2260.0" y="405.0" width="270" height="100" as="geometry" /></mxCell><mxCell id="connection-state-map--reconnect" value="S06 | Sign-in required&#10;Existing connection retained" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;strokeColor=#60a5fa;" vertex="1" parent="1"><mxGeometry x="2260.0" y="180.0" width="270" height="100" as="geometry" /></mxCell><mxCell id="connection-state-map--setup" value="S07 | Sign-in unavailable&#10;Installation setup required" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;strokeColor=#60a5fa;" vertex="1" parent="1"><mxGeometry x="1520.0" y="675.0" width="270" height="100" as="geometry" /></mxCell><mxCell id="connection-state-map--failure" value="S08 | Sign-in failed / cancelled&#10;No new connection saved" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;strokeColor=#60a5fa;" vertex="1" parent="1"><mxGeometry x="1890.0" y="675.0" width="270" height="100" as="geometry" /></mxCell><mxCell id="connection-state-map--e1" value="Select existing" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;fontColor=#cbd5e1;fontSize=13;labelBackgroundColor=#09090b;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="connection-state-map--list" target="connection-state-map--details"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="connection-state-map--e2" value="Add connection" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;fontColor=#cbd5e1;fontSize=13;labelBackgroundColor=#09090b;" edge="1" parent="1" source="connection-state-map--list" target="connection-state-map--add"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="connection-state-map--e3" value="Sign in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;fontColor=#cbd5e1;fontSize=13;labelBackgroundColor=#09090b;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="connection-state-map--add" target="connection-state-map--oauth"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="connection-state-map--e4" value="Verified callback" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;fontColor=#cbd5e1;fontSize=13;labelBackgroundColor=#09090b;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="connection-state-map--oauth" target="connection-state-map--consent"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="connection-state-map--e5" value="Save connection / new entry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;fontColor=#cbd5e1;fontSize=13;labelBackgroundColor=#09090b;exitX=1;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="connection-state-map--consent" target="connection-state-map--list"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2680.0" y="455.0" /><mxPoint x="2680.0" y="140.0" /><mxPoint x="1655.0" y="140.0" /></Array></mxGeometry></mxCell><mxCell id="connection-state-map--e6" value="Access expires or is refused" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;fontColor=#cbd5e1;fontSize=13;labelBackgroundColor=#09090b;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="connection-state-map--details" target="connection-state-map--reconnect"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="connection-state-map--e7" value="Reconnect this entry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;fontColor=#cbd5e1;fontSize=13;labelBackgroundColor=#09090b;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="connection-state-map--reconnect" target="connection-state-map--oauth"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="2395.0" y="335.0" /><mxPoint x="2025.0" y="335.0" /></Array></mxGeometry></mxCell><mxCell id="connection-state-map--e8" value="App not configured" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;fontColor=#cbd5e1;fontSize=13;labelBackgroundColor=#09090b;" edge="1" parent="1" source="connection-state-map--add" target="connection-state-map--setup"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="connection-state-map--e9" value="Cancel or failure" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;fontColor=#cbd5e1;fontSize=13;labelBackgroundColor=#09090b;" edge="1" parent="1" source="connection-state-map--oauth" target="connection-state-map--failure"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="connection-state-map--e10" value="Back to connections" style="edgeStyle=orthogonalEdgeStyle;rounded=1;endArrow=block;strokeColor=#64748b;fontColor=#cbd5e1;fontSize=13;labelBackgroundColor=#09090b;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="connection-state-map--failure" target="connection-state-map--list"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1860.0" y="800.0" /><mxPoint x="1470.0" y="800.0" /><mxPoint x="1470.0" y="230.0" /></Array></mxGeometry></mxCell><mxCell id="connection-state-map--rules" value="STATE RULES&#10;Existing entries remain while adding or reconnecting. Cancel creates no connection. Saving consent returns to the list. Reconnect updates the selected entry. App configuration is installation-wide, not an item in the connection collection.&#10;OPEN DECISIONS: names and duplicate-account handling; connection selection in settings versus a source picker. Screens show proposed labels, not accepted data-model fields." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=14;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="1490.0" y="815.0" width="1280" height="110" as="geometry" /></mxCell><mxCell id="connections-list-screen--frame" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="60.0" y="1200.0" width="1000" height="740" as="geometry" /></mxCell><mxCell id="connections-list-screen--title" value="GitHub connections" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100.0" y="1235.0" width="900" height="45" as="geometry" /></mxCell><mxCell id="connections-list-screen--subtitle" value="Choose a saved connection or add another GitHub account." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="100.0" y="1295.0" width="860" height="55" as="geometry" /></mxCell><mxCell id="connections-list-screen--add" value="+ Add connection" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;fillColor=#fafafa;fontColor=#18181b;strokeColor=#fafafa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="810.0" y="1240.0" width="210" height="44" as="geometry" /></mxCell><mxCell id="connections-list-screen--personalbg" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;fillColor=#202023;" vertex="1" parent="1"><mxGeometry x="100.0" y="1385.0" width="920" height="180" as="geometry" /></mxCell><mxCell id="connections-list-screen--personalavatar" value="P" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;fillColor=#334155;strokeColor=none;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="124.0" y="1411.0" width="48" height="48" as="geometry" /></mxCell><mxCell id="connections-list-screen--personalname" value="Personal" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="192.0" y="1407.0" width="420" height="28" as="geometry" /></mxCell><mxCell id="connections-list-screen--personalaccount" value="@amadou" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontColor=#a1a1aa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="192.0" y="1443.0" width="400" height="25" as="geometry" /></mxCell><mxCell id="connections-list-screen--personalstatus" value="Connected" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;align=right;fontSize=14;fontColor=#86efac;" vertex="1" parent="1"><mxGeometry x="750.0" y="1410.0" width="240" height="30" as="geometry" /></mxCell><mxCell id="connections-list-screen--personalrepos" value="2 repositories: my-skills, private-specs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=14;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="124.0" y="1497.0" width="600" height="40" as="geometry" /></mxCell><mxCell id="connections-list-screen--personalaction" value="View connection" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="780.0" y="1497.0" width="210" height="40" as="geometry" /></mxCell><mxCell id="connections-list-screen--workbg" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;fillColor=#202023;" vertex="1" parent="1"><mxGeometry x="100.0" y="1585.0" width="920" height="180" as="geometry" /></mxCell><mxCell id="connections-list-screen--workavatar" value="W" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;fillColor=#334155;strokeColor=none;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="124.0" y="1611.0" width="48" height="48" as="geometry" /></mxCell><mxCell id="connections-list-screen--workname" value="Work" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=19;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="192.0" y="1607.0" width="420" height="28" as="geometry" /></mxCell><mxCell id="connections-list-screen--workaccount" value="@work-account" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontColor=#a1a1aa;fontSize=14;" vertex="1" parent="1"><mxGeometry x="192.0" y="1643.0" width="400" height="25" as="geometry" /></mxCell><mxCell id="connections-list-screen--workstatus" value="Sign-in required" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;align=right;fontSize=14;fontColor=#fcd34d;" vertex="1" parent="1"><mxGeometry x="750.0" y="1610.0" width="240" height="30" as="geometry" /></mxCell><mxCell id="connections-list-screen--workrepos" value="Last selection: team/skills" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=14;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="124.0" y="1697.0" width="600" height="40" as="geometry" /></mxCell><mxCell id="connections-list-screen--workaction" value="Reconnect" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="780.0" y="1697.0" width="210" height="40" as="geometry" /></mxCell><mxCell id="connections-list-screen--empty" value="EMPTY STATE: replace the rows with &quot;No GitHub connections yet&quot; and one Add connection button. Connection labels are proposals; never show a credential." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=14;fontColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="100.0" y="1820.0" width="900" height="75" as="geometry" /></mxCell><mxCell id="connection-details-screen--frame" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1260.0" y="1200.0" width="1000" height="740" as="geometry" /></mxCell><mxCell id="connection-details-screen--title" value="Personal" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300.0" y="1235.0" width="900" height="45" as="geometry" /></mxCell><mxCell id="connection-details-screen--subtitle" value="@amadou - Connected" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="1300.0" y="1295.0" width="860" height="55" as="geometry" /></mxCell><mxCell id="connection-details-screen--repos" value="Repository read access&#10;my-skills&#10;private-specs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1300.0" y="1390.0" width="860" height="100" as="geometry" /></mxCell><mxCell id="connection-details-screen--policy" value="This connection can read the selected repositories. It cannot write to them." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1300.0" y="1540.0" width="860" height="100" as="geometry" /></mxCell><mxCell id="connection-details-screen--edit" value="Change repositories" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;fillColor=#fafafa;fontColor=#18181b;strokeColor=#fafafa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1300.0" y="1690.0" width="250" height="46" as="geometry" /></mxCell><mxCell id="connection-details-screen--disconnect" value="Disconnect" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="1575.0" y="1690.0" width="180" height="46" as="geometry" /></mxCell><mxCell id="connection-details-screen--recovery" value="S06 VARIANT: keep account and repository information; show Sign-in required and a Reconnect button. Reconnect targets this existing connection, not Add connection." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=14;fontColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="1300.0" y="1790.0" width="880" height="100" as="geometry" /></mxCell><mxCell id="add-connection-screen--frame" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="2460.0" y="1200.0" width="1000" height="740" as="geometry" /></mxCell><mxCell id="add-connection-screen--title" value="Add GitHub connection" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2500.0" y="1235.0" width="900" height="45" as="geometry" /></mxCell><mxCell id="add-connection-screen--subtitle" value="Sign in on GitHub, then choose which repositories this connection can read." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="2500.0" y="1295.0" width="860" height="55" as="geometry" /></mxCell><mxCell id="add-connection-screen--signin" value="Sign in with GitHub" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;fillColor=#fafafa;fontColor=#18181b;strokeColor=#fafafa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2500.0" y="1400.0" width="300" height="50" as="geometry" /></mxCell><mxCell id="add-connection-screen--cancel" value="Back to connections" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="2500.0" y="1475.0" width="300" height="44" as="geometry" /></mxCell><mxCell id="add-connection-screen--external" value="S04: GitHub owns the authorization screen. The successful verified callback opens S05.&#10;S08: cancellation or failure saves nothing; show a short message and Retry / Back.&#10;S07: if App setup is absent, show Sign-in unavailable and a separate installation setup link. No App registration form in this login screen." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=15;fontColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="2500.0" y="1585.0" width="870" height="190" as="geometry" /></mxCell><mxCell id="repository-consent-screen--frame" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="3660.0" y="1200.0" width="1000" height="740" as="geometry" /></mxCell><mxCell id="repository-consent-screen--title" value="Choose repositories" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3700.0" y="1235.0" width="900" height="45" as="geometry" /></mxCell><mxCell id="repository-consent-screen--subtitle" value="Verified GitHub account: @account. Nothing is selected by default." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="3700.0" y="1295.0" width="860" height="55" as="geometry" /></mxCell><mxCell id="repository-consent-screen--repo1" value="[ ] owner/private-skills" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="3700.0" y="1400.0" width="900" height="65" as="geometry" /></mxCell><mxCell id="repository-consent-screen--repo2" value="[ ] owner/another-repository" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="3700.0" y="1485.0" width="900" height="65" as="geometry" /></mxCell><mxCell id="repository-consent-screen--save" value="Save connection" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;fillColor=#fafafa;fontColor=#18181b;strokeColor=#fafafa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3700.0" y="1620.0" width="260" height="48" as="geometry" /></mxCell><mxCell id="repository-consent-screen--cancel" value="Cancel" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#e4e4e7;fontSize=16;" vertex="1" parent="1"><mxGeometry x="3990.0" y="1620.0" width="150" height="48" as="geometry" /></mxCell><mxCell id="repository-consent-screen--note" value="S05: save requires an explicit repository selection. New consent adds one list entry; reconnect replaces consent only for the selected existing entry. Actions here illustrate transitions, not live authorization." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e4e4e7;fontSize=16;spacing=0;fontSize=14;fontColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="3700.0" y="1750.0" width="880" height="110" as="geometry" /></mxCell><mxCell id="setup-workshop--title" value="Workshop - Installation setup" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=28;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="2224.0" width="1550" height="50" as="geometry" /></mxCell><mxCell id="setup-workshop--subtitle" value="DESIGN WORKSHOP - Proposed, not accepted - Edit the screens and transitions together" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#94a3b8;" vertex="1" parent="1"><mxGeometry x="40.0" y="2280.0" width="1550" height="34" as="geometry" /></mxCell><mxCell id="setup-workshop--card0" value="" style="rounded=1;arcSize=4;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="40.0" y="2360.0" width="370" height="610" as="geometry" /></mxCell><mxCell id="setup-workshop--heading0" value="GitHub connections" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="2385.0" width="330" height="46" as="geometry" /></mxCell><mxCell id="setup-workshop--desc0" value="GitHub sign-in is not configured on this installation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="60.0" y="2442.0" width="330" height="85" as="geometry" /></mxCell><mxCell id="setup-workshop--row0-0" value="Ask the person who manages this installation to enable GitHub sign-in." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="60.0" y="2550.0" width="330" height="85" as="geometry" /></mxCell><mxCell id="setup-workshop--row0-1" value="Set up GitHub sign-in" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#fafafa;fontColor=#18181b;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60.0" y="2651.0" width="330" height="48" as="geometry" /></mxCell><mxCell id="setup-workshop--row0-2" value="Setup is a separate route/panel, never inside the normal login form." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="60.0" y="2715.0" width="330" height="85" as="geometry" /></mxCell><mxCell id="setup-workshop--number0" value="01" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#60a5fa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="2328.0" width="50" height="28" as="geometry" /></mxCell><mxCell id="setup-workshop--edge0" value="" style="endArrow=block;strokeColor=#60a5fa;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="415.0" y="2660.0" as="sourcePoint" /><mxPoint x="450.0" y="2660.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="setup-workshop--card1" value="" style="rounded=1;arcSize=4;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="455.0" y="2360.0" width="370" height="610" as="geometry" /></mxCell><mxCell id="setup-workshop--heading1" value="Set up GitHub sign-in" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="475.0" y="2385.0" width="330" height="46" as="geometry" /></mxCell><mxCell id="setup-workshop--desc1" value="One-time installation configuration. Return to connections when complete." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="475.0" y="2442.0" width="330" height="85" as="geometry" /></mxCell><mxCell id="setup-workshop--row1-0" value="Register GitHub App (opens GitHub)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#fafafa;fontColor=#18181b;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="475.0" y="2550.0" width="330" height="48" as="geometry" /></mxCell><mxCell id="setup-workshop--row1-1" value="Callback URL - select and copy" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;rounded=1;fillColor=#27272a;strokeColor=#52525b;" vertex="1" parent="1"><mxGeometry x="475.0" y="2614.0" width="330" height="48" as="geometry" /></mxCell><mxCell id="setup-workshop--row1-2" value="Contents: read-only. Expiring user tokens." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="475.0" y="2678.0" width="330" height="85" as="geometry" /></mxCell><mxCell id="setup-workshop--number1" value="02" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#60a5fa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="455.0" y="2328.0" width="50" height="28" as="geometry" /></mxCell><mxCell id="setup-workshop--edge1" value="" style="endArrow=block;strokeColor=#60a5fa;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="830.0" y="2660.0" as="sourcePoint" /><mxPoint x="865.0" y="2660.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="setup-workshop--card2" value="" style="rounded=1;arcSize=4;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="870.0" y="2360.0" width="370" height="610" as="geometry" /></mxCell><mxCell id="setup-workshop--heading2" value="Enter App credentials" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890.0" y="2385.0" width="330" height="46" as="geometry" /></mxCell><mxCell id="setup-workshop--desc2" value="Use the credentials from your registered GitHub App." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="890.0" y="2442.0" width="330" height="85" as="geometry" /></mxCell><mxCell id="setup-workshop--row2-0" value="Client ID" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;rounded=1;fillColor=#27272a;strokeColor=#52525b;" vertex="1" parent="1"><mxGeometry x="890.0" y="2550.0" width="330" height="48" as="geometry" /></mxCell><mxCell id="setup-workshop--row2-1" value="App slug" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;rounded=1;fillColor=#27272a;strokeColor=#52525b;" vertex="1" parent="1"><mxGeometry x="890.0" y="2614.0" width="330" height="48" as="geometry" /></mxCell><mxCell id="setup-workshop--row2-2" value="Client secret - masked" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;rounded=1;fillColor=#27272a;strokeColor=#52525b;" vertex="1" parent="1"><mxGeometry x="890.0" y="2678.0" width="330" height="48" as="geometry" /></mxCell><mxCell id="setup-workshop--row2-3" value="Save configuration" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#fafafa;fontColor=#18181b;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="890.0" y="2742.0" width="330" height="48" as="geometry" /></mxCell><mxCell id="setup-workshop--number2" value="03" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#60a5fa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="870.0" y="2328.0" width="50" height="28" as="geometry" /></mxCell><mxCell id="setup-workshop--edge2" value="" style="endArrow=block;strokeColor=#60a5fa;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1245.0" y="2660.0" as="sourcePoint" /><mxPoint x="1280.0" y="2660.0" as="targetPoint" /></mxGeometry></mxCell><mxCell id="setup-workshop--card3" value="" style="rounded=1;arcSize=4;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="1285.0" y="2360.0" width="370" height="610" as="geometry" /></mxCell><mxCell id="setup-workshop--heading3" value="GitHub sign-in is ready" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1305.0" y="2385.0" width="330" height="46" as="geometry" /></mxCell><mxCell id="setup-workshop--desc3" value="Installation setup is complete. Users can now connect their own GitHub account." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="1305.0" y="2442.0" width="330" height="85" as="geometry" /></mxCell><mxCell id="setup-workshop--row3-0" value="Return to GitHub connections" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#fafafa;fontColor=#18181b;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1305.0" y="2550.0" width="330" height="48" as="geometry" /></mxCell><mxCell id="setup-workshop--row3-1" value="Then show Sign in with GitHub. Saving configuration does not sign anyone in." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="1305.0" y="2614.0" width="330" height="85" as="geometry" /></mxCell><mxCell id="setup-workshop--number3" value="04" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#60a5fa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1285.0" y="2328.0" width="50" height="28" as="geometry" /></mxCell><mxCell id="setup-workshop--notes" value="SEPARATE RESPONSIBILITIES - Installation operator registers/configures the App once. Each local profile separately signs in and chooses repository read consent. App setup must not appear as a competing login action. OPEN FOR DISCUSSION - In the single-user local deployment, should missing setup expose Set up GitHub sign-in directly or through a separate installation settings entry? Optional token entry remains outside the primary browser sign-in flow. This draft does not invent an administrator role or change authorization policy." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fillColor=#1e293b;strokeColor=#334155;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="40.0" y="3010.0" width="1600" height="140" as="geometry" /></mxCell><mxCell id="manager--title" value="GitHub connections - app settings, outside the graph&lt;br/&gt;&lt;b&gt;PROPOSED / NOT IMPLEMENTED - specs #410 / Laomedo #251&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="3420.0" width="1140" height="80" />
        </mxCell>
        <mxCell id="manager--setup" value="" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#CBD5E1;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30.0" y="3525.0" width="360" height="570" />
