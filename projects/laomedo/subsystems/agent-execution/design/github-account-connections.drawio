y="1160" width="200" height="44" as="geometry" /></mxCell><mxCell id="b-limit" value="Disconnect removes access from Laomedo; it does not revoke consent on GitHub." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="3074" y="1217" width="1090" height="36" as="geometry" /></mxCell><mxCell id="b-browser-variant" value="VARIANT - browser connection requiring sign-in" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#f8fafc;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="3074" y="1270" width="525" height="85" as="geometry" /></mxCell><mxCell id="b-signin" value="Sign in again" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3325" y="1305" width="250" height="36" as="geometry" /></mxCell><mxCell id="b-token-variant" value="VARIANT - token connection" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#f8fafc;align=left;spacingLeft=12;verticalAlign=top;spacingTop=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="3625" y="1270" width="525" height="85" as="geometry" /></mxCell><mxCell id="b-replace" value="Replace token" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3875" y="1305" width="250" height="36" as="geometry" /></mxCell><mxCell id="screen-c" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="3050" y="1440" width="1150" height="360" as="geometry" /></mxCell><mxCell id="c-heading" value="C  Choose repositories" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3074" y="1458" width="1102" height="36" as="geometry" /></mxCell><mxCell id="c-subtitle" value="Verified account: @amadou. Choose repository read access explicitly." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="3074" y="1502" width="1102" height="42" as="geometry" /></mxCell><mxCell id="c-repositories" value="[ ] amadou/my-skills&#10;[ ] amadou/private-specs" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="3074" y="1550" width="1102" height="82" as="geometry" /></mxCell><mxCell id="c-save" value="Save access" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3074" y="1660" width="250" height="44" as="geometry" /></mxCell><mxCell id="c-cancel" value="Cancel" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="3350" y="1660" width="150" height="44" as="geometry" /></mxCell><mxCell id="c-browser-management" value="Browser connections: Manage App repositories on GitHub | Refresh repositories" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="3074" y="1720" width="1090" height="42" as="geometry" /></mxCell><mxCell id="secondary" value="03  Secondary screens - setup is not account sign-in" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="1850" width="4100" height="45" as="geometry" /></mxCell><mxCell id="screen-d" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="50" y="1920" width="1150" height="315" as="geometry" /></mxCell><mxCell id="d-heading" value="D  Installation-wide GitHub App setup" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="74" y="1938" width="1102" height="36" as="geometry" /></mxCell><mxCell id="d-subtitle" value="Opened only through the setup link. Saving resumes M; it creates no account connection." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="74" y="1982" width="1102" height="42" as="geometry" /></mxCell><mxCell id="d-register" value="Register GitHub App" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="74" y="2035" width="320" height="45" as="geometry" /></mxCell><mxCell id="d-guide" value="Contents read-only; expiring user tokens.&#10;Copy the exact callback URL shown by this installation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="420" y="2030" width="740" height="62" as="geometry" /></mxCell><mxCell id="d-client" value="Client ID" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="74" y="2120" width="250" height="42" as="geometry" /></mxCell><mxCell id="d-slug" value="App slug" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="340" y="2120" width="230" height="42" as="geometry" /></mxCell><mxCell id="d-secret" value="Client secret - masked" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;align=left;spacingLeft=12;" vertex="1" parent="1"><mxGeometry x="585" y="2120" width="330" height="42" as="geometry" /></mxCell><mxCell id="d-save" value="Save configuration" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="935" y="2120" width="240" height="42" as="geometry" /></mxCell><mxCell id="d-return" value="Save &gt; M, retaining Add intent. Cancel &gt; M without changes. No ambient login or credentials imported." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="74" y="2180" width="850" height="36" as="geometry" /></mxCell><mxCell id="screen-f" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="50" y="2290" width="1150" height="300" as="geometry" /></mxCell><mxCell id="f-heading" value="F  Personal access token" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="74" y="2308" width="1102" height="36" as="geometry" /></mxCell><mxCell id="f-subtitle" value="Paste a fine-grained token created in GitHub settings. It lets Laomedo read permitted repositories." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="74" y="2352" width="1102" height="42" as="geometry" /></mxCell><mxCell id="f-field" value="Fine-grained personal access token  |  [masked input]" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="74" y="2405" width="1100" height="45" as="geometry" /></mxCell><mxCell id="f-verify" value="Verify token" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="74" y="2470" width="260" height="44" as="geometry" /></mxCell><mxCell id="f-cancel" value="Cancel" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="360" y="2470" width="150" height="44" as="geometry" /></mxCell><mxCell id="f-policy" value="Clear on submit/cancel; never stored in graphs. Verify &gt; C or E1. No GitHub App required. Cancel returns to A for new, B for existing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="74" y="2530" width="1100" height="45" as="geometry" /></mxCell><mxCell id="screen-e1" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="3050" y="1920" width="1150" height="315" as="geometry" /></mxCell><mxCell id="e1-heading" value="E1  Attempt problem - one variant at a time" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3074" y="1938" width="1102" height="36" as="geometry" /></mxCell><mxCell id="e1-subtitle" value="Recovery preserves the originating method and selected connection target." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="3074" y="1982" width="1102" height="42" as="geometry" /></mxCell><mxCell id="e1-title0" value="Browser sign-in failed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3074" y="2030" width="700" height="42" as="geometry" /></mxCell><mxCell id="e1-action0" value="Try browser again" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3830" y="2030" width="320" height="40" as="geometry" /></mxCell><mxCell id="e1-title1" value="Token could not be verified" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3074" y="2088" width="700" height="42" as="geometry" /></mxCell><mxCell id="e1-action1" value="Try token again" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3830" y="2088" width="320" height="40" as="geometry" /></mxCell><mxCell id="e1-title2" value="Save could not be confirmed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3074" y="2146" width="700" height="42" as="geometry" /></mxCell><mxCell id="e1-action2" value="Check connections first" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3830" y="2146" width="320" height="40" as="geometry" /></mxCell><mxCell id="e1-back" value="Back / Dismiss returns to A (new) or B (existing). An uncertain save is checked before retry; no automatic mutation retry." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=13;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="3074" y="2200" width="1100" height="35" as="geometry" /></mxCell><mxCell id="screen-e2" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="3050" y="2290" width="1150" height="300" as="geometry" /></mxCell><mxCell id="e2-heading" value="E2  Disconnected - removal incomplete" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3074" y="2308" width="1102" height="36" as="geometry" /></mxCell><mxCell id="e2-subtitle" value="New private reads are blocked. Local credential removal could not be confirmed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="3074" y="2352" width="1102" height="42" as="geometry" /></mxCell><mxCell id="e2-retry" value="Retry removal" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3074" y="2410" width="300" height="45" as="geometry" /></mxCell><mxCell id="e2-close" value="Close" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="3400" y="2410" width="150" height="45" as="geometry" /></mxCell><mxCell id="e2-copy" value="Retry only local credential removal for the fenced connection. Confirmed completion &gt; A; failure stays here. Close &gt; B, still disconnected. This never starts a GitHub sign-in." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="3074" y="2480" width="1100" height="70" as="geometry" /></mxCell><mxCell id="coverage-title" value="04  Variant and contract map - not additional screens" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="2660" width="4100" height="45" as="geometry" /></mxCell><mxCell id="variant0" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="50" y="2730.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title0" value="Empty list / no App" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="2740.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy0" value="A empty: one Add connection action opens M. Both methods belong to Add. Browser unavailable is a disabled option with explicit D setup link; token remains available." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="64" y="2776.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids0" value="C01, C09, C12; N01-N02, N17" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="64" y="2868.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant1" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="750" y="2730.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title1" value="Pending / cancel / stale attempt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="764" y="2740.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy1" value="Pending attempts carry method and target. Cancel returns to origin without changes. Expired/replayed/stale attempts use E1; retries keep context." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="764" y="2776.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids1" value="C02, C08, E03; P01, P03, P06, P08-P10; N11" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="764" y="2868.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant2" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="1450" y="2730.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title2" value="Wrong account / token entry" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1464" y="2740.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy2" value="B routes by stored method: browser Sign in again; token Replace token. Enforce expected account. Failed token retries F, not GitHub. Clear masked input on submit/cancel." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="1464" y="2776.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids2" value="C06, E02; P02, P07; N10" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="1464" y="2868.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant3" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="2150" y="2730.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title3" value="Consent / empty access" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2164" y="2740.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy3" value="C uses verified current repositories. New saves a new entry; edit/reconnect updates the selected entry. Empty access exposes install/refresh only for browser; zero-selection save policy remains open." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="2164" y="2776.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids3" value="C03, C11; P04-P05; N05-N08, N14" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="2164" y="2868.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant4" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="50" y="2935.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title4" value="Expired / renamed / offline" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="2945.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy4" value="B: reconnect explicitly on verified expiry or rename/transfer. Offline reads stay locked; do not assert revocation. Preserve pins; no public or account fallback." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="64" y="2981.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids4" value="C05, C07; R01-R05; SC04, SC06" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="64" y="3073.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant5" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="750" y="2935.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title5" value="Disconnect / cleanup failure" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="764" y="2945.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy5" value="Disconnect fences reads before removal. Incomplete local deletion uses E2 Retry removal / Close. Sign-in error recovery is never used. Provider consent is not claimed revoked." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="764" y="2981.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids5" value="E04; R07-R08; N13" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="764" y="3073.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant6" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="1450" y="2935.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title6" value="Crash / lost refresh" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1464" y="2945.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy6" value="Unknown refresh outcome &gt; B reconnect, no consumed-token replay. Broker restart invalidates pending only; unrelated ready connections stay unchanged." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="1464" y="2981.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids6" value="C08; P10; R03, R06; N11" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="1464" y="3073.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant7" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="2150" y="2935.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title7" value="Vault / unsupported setup" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2164" y="2945.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy7" value="E: no connection saved on vault failure. Unsupported app session &gt; setup instructions; no plaintext fallback or automatic auth-setting change." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="2164" y="2981.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids7" value="E01, E05, H01; N09, N15" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="2164" y="3073.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant8" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="50" y="3140.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title8" value="Private Skill source / viewer" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="3150.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy8" value="Public Anonymous remains distinct from selecting an account in a Skill node. These controls browse private data only, not Agent execution. Pins remain exact and private reads revalidate." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="64" y="3186.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids8" value="C04-C05; N03-N04; R01-R02" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="64" y="3278.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant9" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="750" y="3140.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title9" value="App-session recovery" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="764" y="3150.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy9" value="Missing private lease with valid app login &gt; Sign in again (Laomedo). Confirm logout then normal login; failure &gt; Retry sign-out. Keep GitHub entry and pins." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="764" y="3186.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids9" value="C13-C14; N18-N20" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="764" y="3278.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant10" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="1450" y="3140.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title10" value="Dismiss / close / late responses" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1464" y="3150.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy10" value="Dismiss hides the message only; never retries or unlocks. Close changes no connection. Owner/session/generation rechecked before bytes; stale reply cannot reopen views." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="1464" y="3186.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids10" value="N12, N16; R01-R02, R07-R08" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="1464" y="3278.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant11" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="2150" y="3140.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title11" value="Open decisions / draft scope" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2164" y="3150.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy11" value="Unresolved owner policy: duplicate accounts, optional names, disconnect confirmation, empty selection saving and where source-picker selection belongs. No policy is inferred from cleanup." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="2164" y="3186.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids11" value="All screens proposed; no runtime acceptance" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="2164" y="3278.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="footer" value="DRAFT - Method, target and recovery remain explicit. No real authentication or implementation acceptance is established by this design." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="50" y="3360" width="4100" height="40" as="geometry" /></mxCell><mxCell id="d-cancel" value="Cancel" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="970" y="2180" width="200" height="40" as="geometry" /></mxCell><mxCell id="m-state-caption" value="M shown: GitHub unavailable. Configured variant enables browser sign-in; both methods remain under Add." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="3074" y="945" width="1100" height="32" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>