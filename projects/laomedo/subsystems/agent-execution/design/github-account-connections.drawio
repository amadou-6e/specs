  <diagram id="attempt-transitions" name="Pending attempt and cross-page navigation">
    <mxGraphModel dx="1200" dy="1190" grid="1" page="1" pageWidth="1200" pageHeight="1190">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;Pending request transitions and navigation&lt;/b&gt;&lt;br/&gt;PROPOSED / NOT IMPLEMENTED - each row is an explicit transition" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1140" height="75" />
        </mxCell>
        <mxCell id="invariant" value="A pending request is separate from a persisted connection. Every attempt captures owner/session, attempt ID, optional replacement connection and expected generation. Until P05 commits, any previous Ready connection stays unchanged." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="105" width="1140" height="85" />
        </mxCell>
        <mxCell id="P01" value="&lt;b&gt;P01&lt;/b&gt;  Idle -&gt; C02 Authorizing: Connect GitHub; require configured app and supported owner session." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="210" width="1140" height="44" />
        </mxCell>
        <mxCell id="P02" value="&lt;b&gt;P02&lt;/b&gt;  Idle -&gt; C06 Token entry -&gt; Verifying: submit deliberate token; clear input, no ambient fallback." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="254" width="1140" height="44" />
        </mxCell>
        <mxCell id="P03" value="&lt;b&gt;P03&lt;/b&gt;  C02 Authorizing -&gt; Verifying: exact callback, matching state/PKCE/session, one-use claim." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="298" width="1140" height="44" />
        </mxCell>
        <mxCell id="P04" value="&lt;b&gt;P04&lt;/b&gt;  Verifying -&gt; C03 Awaiting consent: verified principal; show repositories or C11 verified-empty state." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="342" width="1140" height="44" />
        </mxCell>
        <mxCell id="P05" value="&lt;b&gt;P05&lt;/b&gt;  C03 -&gt; C10 Ready: explicit selected-repository consent; commit vault and metadata atomically." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="386" width="1140" height="44" />
        </mxCell>
        <mxCell id="P06" value="&lt;b&gt;P06&lt;/b&gt;  C02/C03/C06 -&gt; Idle: Cancel; discard only provisional state/secrets, preserve previous Ready." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="430" width="1140" height="44" />
        </mxCell>
        <mxCell id="P07" value="&lt;b&gt;P07&lt;/b&gt;  Verifying -&gt; E02: declined/wrong-account/token refusal; discard attempt, preserve previous Ready." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="474" width="1140" height="44" />
        </mxCell>
        <mxCell id="P08" value="&lt;b&gt;P08&lt;/b&gt;  C02 -&gt; E03: expired or replayed callback; invalidate attempt, preserve previous Ready." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="518" width="1140" height="44" />
        </mxCell>
        <mxCell id="P09" value="&lt;b&gt;P09&lt;/b&gt;  Stale concurrent attempt -&gt; E03: expected generation changed; it cannot replace newer Ready." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="562" width="1140" height="44" />
        </mxCell>
        <mxCell id="P10" value="&lt;b&gt;P10&lt;/b&gt;  Pending/exchanging -&gt; C08 after restart/crash: invalidate or require new sign-in; no exchange replay." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="606" width="1140" height="44" />
        </mxCell>
        <mxCell id="navtitle" value="&lt;b&gt;Navigation controls (state IDs refer to cards on the other pages)&lt;/b&gt;" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="670" width="1140" height="45" />
        </mxCell>
        <mxCell id="N01" value="&lt;b&gt;N01&lt;/b&gt;  C01 View app setup -&gt; C09. C09 Cancel -&gt; C01, no settings or registration effect." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="720" width="1140" height="44" />
        </mxCell>
        <mxCell id="N02" value="&lt;b&gt;N02&lt;/b&gt;  C09 Save app credentials -&gt; C01 configured Connect GitHub control; E01 on vault failure." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="764" width="1140" height="44" />
        </mxCell>
        <mxCell id="N03" value="&lt;b&gt;N03&lt;/b&gt;  C04 Skill files -&gt; authorized exact files or C05 locked viewer; never public fallback." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="808" width="1140" height="44" />
        </mxCell>
        <mxCell id="N04" value="&lt;b&gt;N04&lt;/b&gt;  C05 Manage GitHub connections -&gt; C10 owned connection manager; preserve Source/pins." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="852" width="1140" height="44" />
        </mxCell>
        <mxCell id="N05" value="&lt;b&gt;N05&lt;/b&gt;  C03/C10/C11 Install / manage -&gt; fixed https://github.com/settings/installations; explicit return refresh." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="896" width="1140" height="44" />
        </mxCell>
        <mxCell id="N06" value="&lt;b&gt;N06&lt;/b&gt;  C11 Refresh repository list -&gt; Verifying -&gt; C03/C11 or safe access error; no automatic consent." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="940" width="1140" height="44" />
        </mxCell>
        <mxCell id="N07" value="&lt;b&gt;N07&lt;/b&gt;  C10 Edit repository access -&gt; C03 for that connection; existing consent unchanged until confirm." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="984" width="1140" height="44" />
        </mxCell>
        <mxCell id="N08" value="&lt;b&gt;N08&lt;/b&gt;  C10 Connect another account -&gt; new P01 request with independent connection ID; existing Ready retained." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=0;fillColor=#F8FAFC;strokeColor=#E2E8F0;spacing=8;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="1028" width="1140" height="44" />
        </mxCell>
        <mxCell id="navnote" value="Close on a ready manager closes only the panel. Token Cancel clears the input. Pending has Cancel sign-in only. The configured C01 primary is Connect GitHub; Use a token instead remains available." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
