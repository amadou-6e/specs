<mxfile host="app.diagrams.net"><diagram id="github-connections" name="GitHub connections"><mxGraphModel grid="0" page="0" pageWidth="3600" pageHeight="2900" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="GitHub connections" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=34;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="2300" height="50" as="geometry" /></mxCell><mxCell id="goal" value="Manage saved accounts. Add a new connection, or reconnect an existing one. App installation setup is separate." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=20;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="50" y="88" width="2750" height="40" as="geometry" /></mxCell><mxCell id="legend" value="MATCH SCREENS A-F BY IDENTIFIER  |  Arrows = transitions  |  Dashed = secondary / recovery paths  |  Grey = service / decision" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=16;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="2750" height="38" as="geometry" /></mxCell><mxCell id="graph-title" value="01  State graph - ELK Layered; begin at green START" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="195" width="1450" height="40" as="geometry" /></mxCell><mxCell id="screens-title" value="02  Screens A-C - match the graph identifiers" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2310.0" y="215" width="1150" height="45" as="geometry" /></mxCell><mxCell id="recovery-route" value="Pending is not a saved connection. Cancel and failed verification preserve the current ready entry. Token and browser attempts share account verification and explicit repository consent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=16;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="210" y="1350" width="1230" height="55" as="geometry" /></mxCell><mxCell id="identity-rule" value="Reconnect is bound to the selected connection and expected account. Changing method never permits silent account fallback." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=16;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="2310.0" y="1310" width="1150" height="60" as="geometry" /></mxCell><mxCell id="screen-a" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2310.0" y="280" width="1150" height="310" as="geometry" /></mxCell><mxCell id="screen-a-heading" value="A  GitHub connections" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2334.0" y="298" width="1102" height="35" as="geometry" /></mxCell><mxCell id="screen-a-subtitle" value="Saved accounts and the repositories each connection may read." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="2334.0" y="341" width="1102" height="38" as="geometry" /></mxCell><mxCell id="ui-add" value="+ Add connection" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3180.0" y="302" width="245" height="44" as="geometry" /></mxCell><mxCell id="row0" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="2334.0" y="394" width="1102" height="70" as="geometry" /></mxCell><mxCell id="avatar0" value="A" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#dbeafe;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2350.0" y="409" width="38" height="38" as="geometry" /></mxCell><mxCell id="account0" value="@amadou" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2404.0" y="400" width="290" height="28" as="geometry" /></mxCell><mxCell id="repo0" value="2 repositories: my-skills, private-specs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=13;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="2404.0" y="428" width="570" height="26" as="geometry" /></mxCell><mxCell id="status0" value="Connected" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#15803d;" vertex="1" parent="1"><mxGeometry x="2890.0" y="406" width="260" height="34" as="geometry" /></mxCell><mxCell id="action0" value="View connection" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fontSize=14;" vertex="1" parent="1"><mxGeometry x="3192.0" y="409" width="225" height="40" as="geometry" /></mxCell><mxCell id="row1" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="2334.0" y="476" width="1102" height="70" as="geometry" /></mxCell><mxCell id="avatar1" value="W" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#dbeafe;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="2350.0" y="491" width="38" height="38" as="geometry" /></mxCell><mxCell id="account1" value="@work-account" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2404.0" y="482" width="290" height="28" as="geometry" /></mxCell><mxCell id="repo1" value="Selected repositories: team/skills" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=13;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="2404.0" y="510" width="570" height="26" as="geometry" /></mxCell><mxCell id="status1" value="Sign-in required" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#92400e;" vertex="1" parent="1"><mxGeometry x="2890.0" y="488" width="260" height="34" as="geometry" /></mxCell><mxCell id="action1" value="Reconnect" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fontSize=14;" vertex="1" parent="1"><mxGeometry x="3192.0" y="491" width="225" height="40" as="geometry" /></mxCell><mxCell id="screen-b" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2310.0" y="640" width="1150" height="245" as="geometry" /></mxCell><mxCell id="screen-b-heading" value="B  Connection details" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2334.0" y="658" width="1102" height="35" as="geometry" /></mxCell><mxCell id="screen-b-subtitle" value="@amadou - Connected. Reconnect follows the saved method; token connections explicitly replace the token." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="2334.0" y="701" width="1102" height="38" as="geometry" /></mxCell><mxCell id="details-repos" value="Repository access  |  amadou/my-skills, amadou/private-specs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=16;" vertex="1" parent="1"><mxGeometry x="2334.0" y="752" width="1090" height="35" as="geometry" /></mxCell><mxCell id="edit" value="Change repositories" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2334.0" y="813" width="280" height="42" as="geometry" /></mxCell><mxCell id="detail-reconnect" value="Reconnect" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="2634.0" y="813" width="210" height="42" as="geometry" /></mxCell><mxCell id="disconnect" value="Disconnect locally" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="2864.0" y="813" width="250" height="42" as="geometry" /></mxCell><mxCell id="screen-c" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2310.0" y="940" width="1150" height="330" as="geometry" /></mxCell><mxCell id="screen-c-heading" value="C  Choose repository access" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2334.0" y="958" width="1102" height="35" as="geometry" /></mxCell><mxCell id="screen-c-subtitle" value="Verified GitHub account: @amadou. Select repositories explicitly." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="2334.0" y="1001" width="1102" height="38" as="geometry" /></mxCell><mxCell id="repo-choice" value="[ ] amadou/my-skills&#10;[ ] amadou/private-specs" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;align=left;spacingLeft=20;" vertex="1" parent="1"><mxGeometry x="2334.0" y="1050" width="1102" height="85" as="geometry" /></mxCell><mxCell id="confirm" value="Allow selected reads" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2334.0" y="1165" width="290" height="44" as="geometry" /></mxCell><mxCell id="consent-cancel" value="Cancel" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="2644.0" y="1165" width="150" height="44" as="geometry" /></mxCell><mxCell id="install-link" value="Manage App repositories on GitHub   |   Refresh repositories" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="2810.0" y="1165" width="610" height="44" as="geometry" /></mxCell><mxCell id="secondary-heading" value="03  Setup and recovery - used only when needed" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="1400" width="2750" height="45" as="geometry" /></mxCell><mxCell id="screen-d" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="50" y="1470" width="1430" height="315" as="geometry" /></mxCell><mxCell id="screen-d-heading" value="D  Installation-wide GitHub App setup" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="74" y="1488" width="1382" height="35" as="geometry" /></mxCell><mxCell id="screen-d-subtitle" value="One-time host setup. Does not create or sign in an account connection." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="74" y="1531" width="1382" height="38" as="geometry" /></mxCell><mxCell id="register" value="Register GitHub App" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="74" y="1580" width="320" height="45" as="geometry" /></mxCell><mxCell id="setup-guidance" value="Contents read-only; expiring user tokens. Install on intended repositories.&#10;Callback: copy the exact read-only value shown by this installation." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="414" y="1575" width="1020" height="65" as="geometry" /></mxCell><mxCell id="client" value="Client ID" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="74" y="1670" width="350" height="40" as="geometry" /></mxCell><mxCell id="slug" value="App slug" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="444" y="1670" width="300" height="40" as="geometry" /></mxCell><mxCell id="secret" value="Client secret - masked" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="764" y="1670" width="390" height="40" as="geometry" /></mxCell><mxCell id="save-app" value="Save configuration" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1174" y="1670" width="280" height="40" as="geometry" /></mxCell><mxCell id="setup-return" value="Save succeeds &gt; return to A. Add connection is now available. Cancel changes nothing. Token entry remains a deliberate secondary method." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="74" y="1730" width="1380" height="38" as="geometry" /></mxCell><mxCell id="screen-e" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="2310.0" y="1470" width="1150" height="315" as="geometry" /></mxCell><mxCell id="screen-e-heading" value="E  Recovery message" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2334.0" y="1488" width="1102" height="35" as="geometry" /></mxCell><mxCell id="screen-e-subtitle" value="One concise message, one primary recovery action, and Dismiss." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="2334.0" y="1531" width="1102" height="38" as="geometry" /></mxCell><mxCell id="error-title" value="This sign-in attempt has ended" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=20;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2334.0" y="1590" width="1090" height="36" as="geometry" /></mxCell><mxCell id="error-copy" value="Your saved connections have not changed. Start a new sign-in to continue." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=16;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="2334.0" y="1635" width="1090" height="40" as="geometry" /></mxCell><mxCell id="retry" value="Start a new sign-in" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2334.0" y="1710" width="300" height="44" as="geometry" /></mxCell><mxCell id="dismiss" value="Dismiss" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="2654.0" y="1710" width="170" height="44" as="geometry" /></mxCell><mxCell id="coverage-title" value="04  Recovery and variant map - references resolve to Screens A-F" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="2150.0" width="2750" height="45" as="geometry" /></mxCell><mxCell id="variant0" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="50" y="2220.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title0" value="Empty list / no App" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="2230.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy0" value="A: no saved entries &gt; Add (browser). Missing App setup &gt; D; token alternative F stays available. Setup success enables browser Add, never read consent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="64" y="2266.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids0" value="C01, C09, C12; N01-N02, N17" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="64" y="2358.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant1" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="750" y="2220.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title1" value="Pending / cancel / stale attempt" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="764" y="2230.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy1" value="GitHub pending is separate from saved entries. Cancel clears provisional secrets only. Expired, replayed or stale generation &gt; E, fresh sign-in." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="764" y="2266.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids1" value="C02, C08, E03; P01, P03, P06, P08-P10; N11" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="764" y="2358.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant2" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="1450" y="2220.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title2" value="Wrong account / token entry" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1464" y="2230.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy2" value="Reconnect requires the expected account. Browser entry &gt; GitHub; token entry &gt; F replaces its token. Verify and confirm before updating the same entry. Clear masked input on submit/cancel." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="1464" y="2266.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids2" value="C06, E02; P02, P07; N10" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="1464" y="2358.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant3" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="2150" y="2220.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title3" value="Consent / empty access" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2164" y="2230.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy3" value="C: none selected by default. Empty list shows Manage App repositories, Refresh and Cancel. Refresh verifies again; no automatic consent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="2164" y="2266.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids3" value="C03, C11; P04-P05; N05-N08, N14" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="2164" y="2358.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant4" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="50" y="2425.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title4" value="Expired / renamed / offline" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="2435.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy4" value="B: reconnect explicitly on verified expiry or rename/transfer. Offline reads stay locked; do not assert revocation. Preserve pins; no public or account fallback." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="64" y="2471.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids4" value="C05, C07; R01-R05; SC04, SC06" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="64" y="2563.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant5" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="750" y="2425.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title5" value="Disconnect / cleanup failure" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="764" y="2435.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy5" value="Fence reads, clear private views, then remove local credentials. E: removal incomplete &gt; Retry removal. Never say GitHub consent was revoked." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="764" y="2471.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids5" value="E04; R07-R08; N13" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="764" y="2563.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant6" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="1450" y="2425.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title6" value="Crash / lost refresh" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1464" y="2435.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy6" value="Unknown refresh outcome &gt; B reconnect, no consumed-token replay. Broker restart invalidates pending only; unrelated ready connections stay unchanged." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="1464" y="2471.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids6" value="C08; P10; R03, R06; N11" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="1464" y="2563.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant7" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="2150" y="2425.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title7" value="Vault / unsupported setup" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2164" y="2435.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy7" value="E: no connection saved on vault failure. Unsupported app session &gt; setup instructions; no plaintext fallback or automatic auth-setting change." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="2164" y="2471.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids7" value="E01, E05, H01; N09, N15" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="2164" y="2563.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant8" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="50" y="2630.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title8" value="Private Skill source / viewer" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="64" y="2640.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy8" value="Source keeps explicit Anonymous/account choice and immutable pins. Failed access locks files/history. Manage connections opens A/B; never dispatch an Agent." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="64" y="2676.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids8" value="C04-C05; N03-N04; R01-R02" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="64" y="2768.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant9" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="750" y="2630.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title9" value="App-session recovery" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="764" y="2640.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy9" value="Missing private lease with valid app login &gt; Sign in again (Laomedo). Confirm logout then normal login; failure &gt; Retry sign-out. Keep GitHub entry and pins." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="764" y="2676.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids9" value="C13-C14; N18-N20" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="764" y="2768.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant10" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="1450" y="2630.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title10" value="Dismiss / close / late responses" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1464" y="2640.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy10" value="Dismiss hides the message only; never retries or unlocks. Close changes no connection. Owner/session/generation rechecked before bytes; stale reply cannot reopen views." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="1464" y="2676.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids10" value="N12, N16; R01-R02, R07-R08" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="1464" y="2768.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="variant11" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="2150" y="2630.0" width="680" height="185" as="geometry" /></mxCell><mxCell id="variant-title11" value="Open decisions / draft scope" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=17;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="2164" y="2640.0" width="652" height="30" as="geometry" /></mxCell><mxCell id="variant-copy11" value="Account labels shown; custom names and duplicate-account policy unresolved. Connection selection in source picker vs settings unresolved. Operator entry placement unresolved." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="2164" y="2676.0" width="652" height="86" as="geometry" /></mxCell><mxCell id="variant-ids11" value="All screens proposed; no runtime acceptance" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=12;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="2164" y="2768.0" width="652" height="36" as="geometry" /></mxCell><mxCell id="footer" value="DRAFT FOR DISCUSSION - Read graph 01, inspect screens 02, consult variants 03/04 only as needed. Prior studies are in Git history. No credentials or real authorization state." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="50" y="2850.0" width="2800" height="40" as="geometry" /></mxCell><mxCell id="ui-token" value="Use a token instead" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="2920.0" y="308" width="235" height="34" as="geometry" /></mxCell><mxCell id="screen-f" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="50" y="1830" width="1430" height="270" as="geometry" /></mxCell><mxCell id="token-heading" value="F  Use a fine-grained token" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="74" y="1848" width="1380" height="36" as="geometry" /></mxCell><mxCell id="token-explanation" value="Alternative to browser sign-in. Available even when no GitHub App is configured." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="74" y="1895" width="1380" height="35" as="geometry" /></mxCell><mxCell id="masked-token" value="Fine-grained token  |  [masked input]" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="74" y="1950" width="850" height="44" as="geometry" /></mxCell><mxCell id="token-submit" value="Verify token" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="944" y="1950" width="235" height="44" as="geometry" /></mxCell><mxCell id="token-back" value="Cancel" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=17;" vertex="1" parent="1"><mxGeometry x="1199" y="1950" width="250" height="44" as="geometry" /></mxCell><mxCell id="token-contract" value="Clear the field on submit or cancel. Never store it in a graph. Verify &gt; C (explicit repository consent) or E (classic, invalid, expired or wrong-account token). Cancel preserves all saved connections." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="74" y="2020" width="1380" height="55" as="geometry" /></mxCell><mxCell id="github" value="GitHub authorization" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#18181b;fontSize=16;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1123.0" y="454.0" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="failure" value="E - Recovery" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#ffffff;strokeColor=#b91c1c;fontColor=#18181b;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1487.0" y="439.0" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="save-new" value="Save new connection" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#18181b;fontSize=16;" vertex="1" parent="1">
