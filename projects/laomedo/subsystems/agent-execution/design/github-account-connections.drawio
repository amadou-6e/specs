        </mxCell>
        <mxCell id="help--N16" value="&lt;b&gt;N16&lt;/b&gt;  C01/C12/C07/C08/C10/C13/C14 Close -&gt; close panel only, no disconnect or retry; persistent state stays unchanged." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
