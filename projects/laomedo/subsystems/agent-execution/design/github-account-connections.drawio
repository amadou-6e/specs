          <mxGeometry as="geometry" x="840" y="480" width="300" height="42" />
        </mxCell>
        <mxCell id="configured-state" value="C01 configured variant: View app setup is replaced by Connect GitHub. Use a token instead is unchanged. N01/N02 own setup return." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=10;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
