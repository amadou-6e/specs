      <mxCell id="title" value="GitHub connections - one task, two sign-in methods" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=32;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="4000" height="50" as="geometry" /></mxCell><mxCell id="goal" value="Add a connection, choose a method, verify the account, choose repositories, then save. Existing entries keep their identity through edits and recovery." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=19;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="50" y="90" width="4100" height="45" as="geometry" /></mxCell><mxCell id="legend" value="Screens match by A / B / M / F / C / D / E1 / E2. Arrows show transitions only. Dashed GitHub node = external page; grey nodes = service steps." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=16;fontColor=#1d4ed8;" vertex="1" parent="1"><mxGeometry x="50" y="155" width="4100" height="38" as="geometry" /></mxCell><mxCell id="graph-title" value="01  Task flow - start at green START" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="210" width="2700" height="45" as="geometry" /></mxCell><mxCell id="attempt-context" value="ATTEMPT CONTEXT - carried through verification, consent, saving and retry&#10;NEW: add a connection. EXISTING: selected connection + expected account + generation.&#10;The chosen method is retained. A retry never changes account or creates a different entry silently. Cancel returns to A (new) or B (existing)." style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#eff6ff;align=left;spacingLeft=16;fontSize=17;" vertex="1" parent="1"><mxGeometry x="60" y="1110" width="2800" height="155" as="geometry" /></mxCell><mxCell id="decision-note" value="OPEN OWNER DECISIONS: duplicate accounts, optional connection names, disconnect confirmation and saving zero repositories. None is decided by this workshop." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="60" y="1300" width="2800" height="75" as="geometry" /></mxCell><mxCell id="screens-title" value="02  Matching screens - normal actions first" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3050" y="210" width="1150" height="45" as="geometry" /></mxCell><mxCell id="screen-a" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="3050" y="280" width="1150" height="310" as="geometry" /></mxCell><mxCell id="a-heading" value="A  GitHub connections" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3074" y="298" width="1102" height="36" as="geometry" /></mxCell><mxCell id="a-subtitle" value="Select a saved connection or add a new one." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=15;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="3074" y="342" width="1102" height="42" as="geometry" /></mxCell><mxCell id="a-add" value="+ Add connection" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#1d4ed8;strokeColor=#1d4ed8;fontColor=#ffffff;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3905" y="302" width="265" height="44" as="geometry" /></mxCell><mxCell id="a-row0" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="3074" y="394" width="1102" height="70" as="geometry" /></mxCell><mxCell id="a-account0" value="@amadou" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="3098" y="400" width="320" height="28" as="geometry" /></mxCell><mxCell id="a-repo0" value="2 repositories: my-skills, private-specs" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=13;fontColor=#52525b;" vertex="1" parent="1"><mxGeometry x="3098" y="430" width="620" height="24" as="geometry" /></mxCell><mxCell id="a-status0" value="Connected" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=Helvetica;fontColor=#18181b;fontSize=16;spacing=4;fontSize=14;fontColor=#15803d;" vertex="1" parent="1"><mxGeometry x="3700" y="410" width="230" height="30" as="geometry" /></mxCell><mxCell id="a-view0" value="View connection" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;" vertex="1" parent="1"><mxGeometry x="3940" y="409" width="210" height="40" as="geometry" /></mxCell><mxCell id="a-row1" value="" style="rounded=1;arcSize=6;html=1;whiteSpace=wrap;fillColor=#ffffff;strokeColor=#cbd5e1;fontColor=#18181b;fontFamily=Helvetica;fontSize=16;fillColor=#f8fafc;" vertex="1" parent="1"><mxGeometry x="3074" y="476" width="1102" height="70" as="geometry" /></