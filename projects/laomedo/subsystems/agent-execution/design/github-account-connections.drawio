        </mxCell>
        <mxCell id="manager--pending-title" value="&lt;b&gt;C02 - Waiting for GitHub&lt;/b&gt;&lt;br/&gt;GitHub connections" style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;text;strokeColor=none;fillColor=none;" vertex="1" parent="1">
