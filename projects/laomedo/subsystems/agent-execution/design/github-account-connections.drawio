t;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;rounded=1;fillColor=#27272a;strokeColor=#52525b;" vertex="1" parent="1"><mxGeometry x="1305" y="350" width="330" height="48" as="geometry"/></mxCell><mxCell id="row3-1" value="Browse skills" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#fafafa;strokeColor=#fafafa;fontColor=#18181b;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1305" y="414" width="330" height="48" as="geometry"/></mxCell><mxCell id="row3-2" value="Change repositories    -    Disconnect" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="1305" y="478" width="330" height="85" as="geometry"/></mxCell><mxCell id="number3" value="04" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontColor=#e5e7eb;fontSize=15;spacing=8;fontColor=#60a5fa;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1285" y="128" width="50" height="28" as="geometry"/></mxCell><mxCell id="notes" value="TRANSITIONS - Sign in - GitHub authorization - verified account and repository choices - explicit read consent - connected. Cancel or failed sign-in returns with a short retry message; never grants access.
