        <mxCell id="help--N17" value="&lt;b&gt;N17&lt;/b&gt;  C09 Open GitHub App registration -&gt; fixed https://github.com/settings/apps/new with reviewed read-only configuration; owner submits explicitly." style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=8;fillColor=#F8FAFC;strokeColor=#E2E8F0;" vertex="1" parent="1">
