        <mxCell id="manager--manager-note" value="Entry: Settings - GitHub connections. The configured/ready list shows account, mode and state, selected repositories, Edit access, Reconnect and Disconnect. Closing the panel does not disconnect a ready account. All actions are owner/session bound." style="whiteSpace=wrap;html=1;fontFamily=Arial;fontSize=14;align=left;verticalAlign=top;spacing=12;rounded=1;fillColor=#FFF7ED;strokeColor=#F59E0B;" vertex="1" parent="1">
