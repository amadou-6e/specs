          <mxGeometry x="1627.0" y="598.75" width="100" height="65" as="geometry" />
        </mxCell>
        <mxCell id="detail" value="B - Existing connection" style="shape=rectangle;rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fillColor=#ffffff;strokeColor=#2563eb;fontColor=#18181b;fontSize=16;" vertex="1" parent="1">
