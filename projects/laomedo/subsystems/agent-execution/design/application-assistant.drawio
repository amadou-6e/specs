<?xml version='1.0' encoding='utf-8'?>
<mxfile>
  <diagram name="A1 - Owner-selected persistent chat">
    <mxGraphModel page="1" pageWidth="1380" pageHeight="1040">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="heading" value="A1 / Laomedo application assistant - owner-selected chat; no workflow" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=20;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1280" height="55" as="geometry" />
        </mxCell>
        <mxCell id="entry" value="ENTRY-01  App header: Assistant&#10;Opens /assistant in a separate application tab. Existing editor and unsaved work remain in their original tab." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="95" width="1280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="history" value="HISTORY-01   History   [Drag / Collapse]&#10;&#10;Research + Implement&#10;[monochrome Codex mark] | Today&#10;&#10;Earlier discussion [spinner]&#10;[monochrome Claude mark] | Yesterday&#10;&#10;Marks replace provider text in metadata&#10;Muted titles; faint rules between rows&#10;Scrollbar at right edge beside 8px rail&#10;Rail: drag resizes; click collapses&#10;180-480px, bounded to available width&#10;Arrow keys +/-24px; Home/End&#10;Scroll loads earlier conversations&#10;&#10;[spinner] Working in background" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="200" width="260" height="660" as="geometry" />
        </mxCell>
        <mxCell id="binding" value="TITLE-01  Research + Implement&#10;Double-click or keyboard activate to rename inline. Wide input; Save / Enter commits, Cancel / Escape preserves title. No provider/model metadata header." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="310" y="200" width="1000" height="100" as="geometry" />
        </mxCell>
        <mxCell id="user" value="MESSAGE-01&#10;Combine Research and Implement using Skill X. Add an Output Contract at the end.&#10;14 px user and assistant body text; no repeated speaker labels." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="500" y="330" width="790" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tool" value="TOOL-01  Workflow tools&#10;Read 2 workflows | checked installed component ports&#10;Saved draft: Research + Implement | revision r1&#10;Status comes from persisted receipts, not assistant prose." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0fdf4;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="330" y="450" width="940" height="130" as="geometry" />
        </mxCell>
        <mxCell id="answer" value="MESSAGE-02&#10;I saved a separate draft. The original workflows are unchanged.&#10;The graph has not been run or published. No Thinking once answer text appears." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#ffffff;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=18;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="330" y="600" width="940" height="100" as="geometry" />
        </mxCell>
        <mxCell id="draft" value="DRAFT-01  Saved draft: Research + Implement | r1&#10;[ Open draft in new tab ]&#10;Opening is your choice; stay here to continue chatting." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="330" y="720" width="940" height="110" as="geometry" />
        </mxCell>
        <mxCell id="composer" value="COMPOSER-01  Message this assistant...&#10;[ gpt-6-luna  Low v ]                                      [ Send arrow / Stop square ]&#10;Enter sends; Shift+Enter newline. IME Enter does not send. Focus stays here; read-only during response." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="310" y="880" width="1000" height="120" as="geometry" />
        </mxCell>
        <mxCell id="new-conversation" value="+ New conversation" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f1f5f9;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=middle;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="50" y="795" width="220" height="45" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="A2 - Chat and recovery states">
    <mxGraphModel page="1" pageWidth="1500" pageHeight="2030">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="A2 / Owner-selected interaction and recovery states" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#e2e8f0;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=20;align=left;verticalAlign=top;spacing=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="1380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="new" value="STATE-NEW  Start chat&#10;Workflow illustration + Codex provider card&#10;Visible supported model/effort pair&#10;Compact menu and annotated effort slider&#10;First Send creates chat and starts inference." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="110" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="idle" value="STATE-IDLE  Ready&#10;Retained history and draft receipts&#10;Change model/effort for next turn&#10;Send / Enter; New conversation at bottom&#10;History/selection alone never dispatch." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0fdf4;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="530" y="110" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="active" value="STATE-ACTIVE  Thinking before answer&#10;Subtle staggered letters; reduced motion off&#10;Hide Thinking as soon as answer appears&#10;Stream answer/tools; Stop response&#10;Composer focused, read-only; no retry flash." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dbeafe;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1030" y="110" width="420" height="190" as="geometry" />
        </mxCell>
        <mxCell id="stopping" value="STATE-STOPPING  Stopping...&#10;Keep partial text and tool state&#10;Send disabled; no second dispatch&#10;Cancellation requested is not&#10;confirmed cleanup." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1030" y="410" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="settled" value="STATE-SETTLED  Response stopped / failed&#10;Partial history retained&#10;Saved drafts remain visible if committed&#10;[ Send ] only after continuation&#10;safety checks pass." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="530" y="410" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="attention" value="STATE-ATTENTION  Cannot safely continue&#10;Session unavailable / cleanup uncertain&#10;Dispatch outcome unknown: reconcile first&#10;Show stable reason + recovery guidance&#10;[ Check status ]&#10;[ Start linked conversation ]&#10;Never silently replay or replace session." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="410" width="420" height="235" as="geometry" />
        </mxCell>
        <mxCell id="reconnect" value="STATE-RECONNECT  Reconnecting...&#10;App reopened / connection lost&#10;Reload same conversation + attempt&#10;Send disabled until status reconciles&#10;No new model request." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="740" width="420" height="180" as="geometry" />
        </mxCell>
        <mxCell id="save" value="STATE-SAVE  Save pending / outcome unknown&#10;Show tool progress; no success card&#10;Reconcile operation key + receipt&#10;Committed -&gt; exact saved draft card&#10;Refused -&gt; errors, no new success card." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fef3c7;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="530" y="740" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="open" value="STATE-OPEN  Saved draft card&#10;[ Open draft in new tab ]&#10;Click opens exact saved draft identity&#10;Existing editor/unsaved work untouched&#10;No click -&gt; stay in chat; draft retained&#10;Open failure -&gt; retain card + retry link." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1030" y="740" width="420" height="200" as="geometry" />
        </mxCell>
        <mxCell id="refusal" value="STATE-ERROR  Cannot save this change&#10;Stale revision / invalid ports /&#10;unsupported dynamic field / source changed&#10;Show stable scoped explanation&#10;No overwrite; no graph execution." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="1080" width="420" height="195" as="geometry" />
        </mxCell>
        <mxCell id="locked" value="STATE-LOCKED  Profile locked&#10;Hide private messages/draft details&#10;Stop new dispatch; invalidate tool access&#10;[ Unlock profile ] via existing sign-in&#10;No credential form in the assistant." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="530" y="1080" width="420" height="195" as="geometry" />
        </mxCell>
        <mxCell id="unavailable" value="STATE-UNAVAILABLE  Assistant unavailable&#10;Provider/model/runner not ready&#10;Show existing reason/recovery action&#10;Preserve history; do not switch models&#10;No automatic login or inference probe." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=16;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="1030" y="1080" width="420" height="195" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="INTERACTION RULES&#10;Keyboard: logical focus order, labelled controls, visible focus; Enter sends, Shift+Enter newline; IME Enter does not send.&#10;The composer retains focus and becomes read-only while dispatching/responding. Keyboard and Send share admission rules. Stop remains reachable.&#10;No normal-send retry text. Only uncertain/restored unobserved submissions offer explicit same-key retry after observation settles; never automatic replay.&#10;Provider is fixed per conversation; model/effort may change per turn without replacing native thread/run. New conversation preserves the old one.&#10;This editable diagram records the selected UI contract; runtime evidence and known limits belong to validation." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="1330" width="1420" height="215" as="geometry" />
        </mxCell>
        <mxCell id="transitions" value="TRANSITIONS&#10;T01 New -&gt; Active: first Send creates chat and reserves first message. Creation/selection alone never invoke a model.&#10;T02 Idle -&gt; Active: Send with new message identity and immutable selected model/effort.&#10;T03 Active -&gt; Idle: completed and settled. T04 Active -&gt; Stopping: Stop response.&#10;T05a Active -&gt; Settled: native failure; retain partial output and reconcile effects.&#10;T05 Stopping -&gt; Settled: native work and tool effects reconciled. T06 Settled -&gt; Idle: safe continuation.&#10;T07 Settled -&gt; Attention: continuation unsafe. T08 Reconnect -&gt; Idle/Active/Attention: reconcile actual attempt state.&#10;T09 Save -&gt; Open card: persisted receipt. Save -&gt; Error: refused save; previous receipts remain distinct.&#10;T10 Any private state -&gt; Locked: profile lock/sign-out. Unlock -&gt; Reconnect: recheck owner and attempt.&#10;T11 Open card -&gt; new editor tab: user clicks Open; failure retains the card. Stay performs no navigation.&#10;T12 Unavailable -&gt; Reconnect: existing recovery action succeeds, no inference.&#10;T13 Attention -&gt; New: user explicitly chooses Start linked conversation; old history retained.&#10;T14 History selection changes the visible conversation only; it never dispatches or stops a turn." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontSize=17;fontFamily=Arial;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry x="30" y="1580" width="1420" height="380" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="A3 - Composer and title controls">
    <mxGraphModel page="1" pageWidth="1380" pageHeight="1650">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="A3 / Selected controls and send lifecycle" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1280" height="60" />
        </mxCell>
        <mxCell id="welcome" value="WELCOME-01&#10;Workflow illustration&#10;What would you like to build?&#10;Describe a workflow or ask to change one.&#10;[ Codex provider icon | OpenAI | Selected ]&#10;No repeated Your assistant caption." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="110" width="570" height="235" />
        </mxCell>
        <mxCell id="picker" value="MODEL-01  Compact composer popover&#10;Discovered model list: ( ) gpt-6-luna  ( ) other supported model&#10;Annotated effort slider: Low - Medium - High - Xhigh - Max&#10;Only discovered options; keyboard arrows select/step.&#10;No Refresh models button; no model-card grid.&#10;Selection locked during pending/active turn." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="640" y="110" width="670" height="235" />
        </mxCell>
        <mxCell id="rename" value="TITLE-EDIT-01&#10;[ Research + Implement                               ] Save  Cancel&#10;Input stays wide in the header.&#10;Double-click or keyboard activation opens edit.&#10;Enter / Save commits; Escape / Cancel leaves unchanged.&#10;No inference; owner/session fences apply." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="385" width="1280" height="185" />
        </mxCell>
        <mxCell id="pending" value="SEND-01  Normal pending&#10;User bubble appears immediately; same retained geometry.&#10;Thinking (gentle staggered letter lift; reduced-motion none).&#10;No resend/retry or submission-pending boilerplate.&#10;Composer clears after durable local reservation.&#10;Focus retained, read-only until response settles." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="610" width="610" height="205" />
        </mxCell>
        <mxCell id="answer" value="ANSWER-01  Response visible&#10;Assistant answer text streams or appears from retained result.&#10;Thinking disappears on first visible answer.&#10;Tool calls may remain grouped/expandable.&#10;Stop retains distinct stopping/reconciling status.&#10;No duplicate answer from terminal response." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="680" y="610" width="630" height="205" />
        </mxCell>
        <mxCell id="transitions" value="CONTROL TRANSITIONS&#10;C01 Welcome: visible supported pair permits first Send without opening picker. No inference on selection.&#10;C02 Idle selection changes next-turn model/effort, retaining native thread/run. Admitted settings are immutable.&#10;C03 Enter dispatches only when Send is admitted. Shift+Enter inserts newline; IME Enter does not dispatch.&#10;C04 Definite refusal restores draft. Uncertain outcome retains exact key/content/configuration for explicit retry.&#10;C05 Successful ACK plus history-read failure never becomes an automatic or new-key resend.&#10;C06 Title save updates header/sidebar; cancel does not mutate. Model selection never renames or reopens a session." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="855" width="1280" height="245" />
        </mxCell>
      <mxCell id="transcript-controls" value="TRANSCRIPT-01  Export conversation (header download icon)&#10;Download Markdown of all retained user/assistant text, including earlier pages.&#10;One Copy icon below each full response; copied/error feedback.&#10;Export is a retained snapshot, with partial/unavailable history stated.&#10;Export excludes tool payloads. Copy includes all retained agent text and displayed&#10;tool/command input/output, graph outcomes and drafts since that user request.&#10;Copy excludes user/native prompt wrappers and other requests.&#10;Compact bottom spacing: last answer/copy control stays close to composer.&#10;Copy/export never submit inference or change graph consent.&#10;DELETE-01  Trash icon beside Export opens confirmation naming this chat.&#10;Delete this conversation from Laomedo history? Saved workflows stay. [Cancel] [Delete]&#10;Active response/workflow: refuse with Stop/wait guidance, keep chat.&#10;Success: remove chat and its approvals/history, show new conversation.&#10;Failure: keep confirmation/chat, show retry guidance. Cancel has no effect." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1"><mxGeometry x="30" y="1140" width="1280" height="410" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
  <diagram name="A4 - Human-approved graph actions">
    <mxGraphModel page="1" pageWidth="1380" pageHeight="2140">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="A4 / Human-approved edits and runs - publication deferred" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="20" width="1280" height="60" />
        </mxCell>
        <mxCell id="edit" value="ACTION-EDIT  Edit workflow &quot;Research + Implement&quot;:&#10;Add Chat Output and connect it to the agent response.&#10;[ Approve ] [ Always approve edits ] [ Reject ]&#10;Always: any graph in this conversation.&#10;Top-right graph-link icon; reload warning in tooltip. No Details." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="110" width="610" height="325" />
        </mxCell>
        <mxCell id="run" value="ACTION-RUN  Run workflow &quot;Research + Implement&quot; with input &quot;Hello&quot;.&#10;Uses configured credentials; may incur costs or perform external actions.&#10;[ Approve ] [ Always approve runs ] [ Reject ]&#10;Always: any graph in this conversation.&#10;Top-right graph-link icon. Settled: operation, change and short outcome." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="680" y="110" width="630" height="325" />
        </mxCell>
        <mxCell id="pending" value="PENDING -&gt; ADMITTED&#10;Human chooses Approve or Always approve: disable controls while checking.&#10;Always grants only Rename/Edit/Run for this conversation and original app session.&#10;Covered proposals recheck consent/revision/authority atomically; otherwise pending.&#10;No model approval tool. Repeat admission never duplicates effects." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="460" width="1280" height="170" />
        </mxCell>
        <mxCell id="outcome" value="OUTCOMES&#10;Settled card: one muted sentence, no separate heading; outcome below left; graph-link icon top right.&#10;Graph-link tooltip: reload open editors before saving to avoid overwriting saved changes.&#10;Run succeeded/failed: authoritative short outcome; stable run ID retained in backend receipts.&#10;Not dispatched: authority/input refusal before entering execution; graph not started.&#10;Rejected / Expired / Stale revision: no effect; ask for a fresh proposal.&#10;Unknown after interruption: outcome uncertain; inspect history; do not automatically rerun.&#10;Graph run is independent of assistant Stop; closing chat does not cancel it." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="670" width="1280" height="200" />
        </mxCell>
        <mxCell id="rules" value="TRANSITIONS AND ACCESSIBILITY&#10;A01 MCP proposal -&gt; pending card attached to originating message; record before exposing Approve/Reject.&#10;A02 Approve exact digest -&gt; revision/session check -&gt; atomic edit or durable run claim -&gt; authoritative outcome.&#10;A03 Reject -&gt; retained rejected card. Expiry/stale/revocation refuses effects. Always is category/conversation/session scoped; Ask every time revokes it.&#10;A04 Restart: reconcile exact run ID/owner/flow. Terminal jobs resolve; others unknown. Never replay.&#10;A05 Model may read outcome on next user-requested turn; approval itself submits no new model prompt.&#10;Labelled keyboard-operable buttons, visible focus, polite state updates; untrusted preview is plain text.&#10;No automatic editor navigation or loss of unsaved work. No publication or provider permission control.&#10;New app session: old pending cards show fresh-proposal guidance without approval controls." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontFamily=Arial;fontSize=17;align=left;verticalAlign=top;spacing=16;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="30" y="910" width="1280" height="260" />
        </mxCell>
      <mxCell id="AC311-1-screen" value="Configuration&#10;&#10;Account  Personal Codex&#10;Model  discovered choice&#10;Skill  pinned revision&#10;&#10;Ready to save" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=16;fillColor=#171719;fontColor=#f5f5f5;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="40" y="1230" width="640" height="250" as="geometry" /></mxCell><mxCell id="AC311-1-story" value="AC311-1 ? User story&#10;&#10;The agent resolves real dependent choices and reports missing settings. A saved draft is ready only when required settings and bindings are complete." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=16;fillColor=#f5f5f5;fontColor=#222222;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="720" y="1230" width="600" height="250" as="geometry" /></mxCell><mxCell id="AC311-2-screen" value="Run result&#10;&#10;Completed&#10;Output: independently observed value&#10;&#10;Node diagnostics stay available" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=16;fillColor=#171719;fontColor=#f5f5f5;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="40" y="1520" width="640" height="250" as="geometry" /></mxCell><mxCell id="AC311-2-story" value="AC311-2 ? User story&#10;&#10;After existing human consent, show actual run results in the chat tool output. The agent can inspect node-specific safe errors and propose a precise repair. Completion alone is not an answer." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=16;fillColor=#f5f5f5;fontColor=#222222;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="720" y="1520" width="600" height="250" as="geometry" /></mxCell><mxCell id="AC311-3-screen" value="Cancellation&#10;&#10;Cancellation requested&#10;&#10;Cancelled ? partial output retained" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=16;fillColor=#171719;fontColor=#f5f5f5;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="40" y="1810" width="640" height="250" as="geometry" /></mxCell><mxCell id="AC311-3-story" value="AC311-3 ? User story&#10;&#10;Cancelling affects only the exact approved run. Show requested before observed settlement. Unknown stays unknown. Chat Stop does not silently change scope." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fontSize=16;fillColor=#f5f5f5;fontColor=#222222;strokeColor=#777777;" vertex="1" parent="1"><mxGeometry x="720" y="1810" width="600" height="250" as="geometry" /></mxCell></root>
    </mxGraphModel>
  </diagram>
<diagram id="assistant-sidebar-296" name="AS-296 - Resizable editor assistant"><mxGraphModel dx="1440" dy="900" grid="1" page="1" pageWidth="1440" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="title" value="AS-296: same persistent chat beside the graph" style="text;fontSize=24;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="40" as="geometry" /></mxCell><mxCell id="header" value="Graph name                                  Assistant [full chat]" style="rounded=0;fillColor=#202124;fontColor=#eeeeee;" vertex="1" parent="1"><mxGeometry x="30" y="80" width="1360" height="56" as="geometry" /></mxCell><mxCell id="canvas" value="Left rail: Assistant [toggle right chat]&#10;&#10;Existing graph editor stays mounted&#10;&#10;Unsaved canvas is preserved" style="rounded=0;fillColor=#18191b;fontColor=#eeeeee;fontSize=20;" vertex="1" parent="1"><mxGeometry x="30" y="136" width="880" height="650" as="geometry" /></mxCell><mxCell id="divider" value="" style="rounded=0;fillColor=#777777;" vertex="1" parent="1"><mxGeometry x="910" y="136" width="8" height="650" as="geometry" /></mxCell><mxCell id="chat" value="Conversation title      [history/export/delete] [full chat]&#10;&#10;Same saved conversations&#10;History from header icon; same 8px arrow rail drags / collapses&#10;&#10;Retained chat and existing approval cards&#10;&#10;&#10;&#10;&#10;Message composer + model / effort" style="rounded=0;fillColor=#202124;fontColor=#eeeeee;align=left;verticalAlign=top;spacing=18;fontSize=16;" vertex="1" parent="1"><mxGeometry x="918" y="136" width="472" height="650" as="geometry" /></mxCell><mxCell id="note" value="480px initially; 280-720px bounded width. Arrow keys +/-24px; Home/End. Narrow windows overlay the editor.&#10;Single arrow rail: drag resizes, click collapses; release after drag never collapses. Edge reopen preserves this mounted draft; full-chat link opens selected saved conversation, without transferring unsent text." style="text;align=left;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="805" width="1360" height="70" as="geometry" /></mxCell></root></mxGraphModel></diagram>

<diagram name="A6 - Native Codex command approval">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" page="1" pageWidth="1200" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="native-chat" value="User asks assistant to inspect native commands" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1f1f23;fontColor=#eeeeee;strokeColor=#666666;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="80" y="50" width="480" height="65" as="geometry" />
        </mxCell>
        <mxCell id="native-list" value="list_native_commands() / list_native_agents()&#10;Same conversation native catalog; agents unsupported" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1f1f23;fontColor=#eeeeee;strokeColor=#666666;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="80" y="150" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="native-proposal" value="propose_native_command(review, arguments, catalog revision, key)&#10;Pending exact digest; no command dispatched" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1f1f23;fontColor=#eeeeee;strokeColor=#666666;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="80" y="280" width="480" height="90" as="geometry" />
        </mxCell>
        <mxCell id="native-card" value="Run /review with arguments &quot;inspect error handling&quot;&#10;May consume model quota&#10;[Approve]  [Reject]" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1f1f23;fontColor=#eeeeee;strokeColor=#666666;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="280" width="470" height="125" as="geometry" />
        </mxCell>
        <mxCell id="native-active" value="Active chat turn?&#10;Keep pending; approve after settlement" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1f1f23;fontColor=#eeeeee;strokeColor=#666666;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="450" width="470" height="75" as="geometry" />
        </mxCell>
        <mxCell id="native-command" value="Human approval -&gt; reserve one command message&#10;Fresh catalog and owner/session checks&#10;Bare native command; same thread/checkpoint" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1f1f23;fontColor=#eeeeee;strokeColor=#666666;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="590" width="470" height="100" as="geometry" />
        </mxCell>
        <mxCell id="native-result" value="Command response + retained receipt&#10;Completed / Failed / Rejected / Outcome unknown&#10;No automatic follow-up or replay" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1f1f23;fontColor=#eeeeee;strokeColor=#666666;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="650" y="750" width="470" height="100" as="geometry" />
        </mxCell>
        <mxCell id="native-policy" value="Built-ins only: status, mcp, skills, review, compact&#10;Unavailable: account/title/goal/configuration controls,&#10;repository-specific reviews, unknown/custom commands&#10;Opening chat or listing does not submit inference" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#1f1f23;fontColor=#eeeeee;strokeColor=#666666;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="80" y="460" width="480" height="150" as="geometry" />
        </mxCell>
        <mxCell id="native-edge-0" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="native-chat" target="native-list">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="native-edge-1" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="native-list" target="native-proposal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="native-edge-2" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="native-proposal" target="native-card">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="native-edge-3" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="native-card" target="native-active">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="native-edge-4" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="native-active" target="native-command">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="native-edge-5" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;" edge="1" parent="1" source="native-command" target="native-result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

<diagram id="assistant-accounts-293" name="AC-293 - Account selection and blocked send"><mxGraphModel dx="1440" dy="1000" grid="1" page="1" pageWidth="1440" pageHeight="1000"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="title" value="AC-293: compact account menu and explicit send admission" style="text;fontSize=24;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1300" height="45" as="geometry" /></mxCell>
<mxCell id="menu-frame" value="" style="rounded=1;fillColor=#242424;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="310" height="180" as="geometry" /></mxCell>
<mxCell id="menu-label" value="Codex accounts" style="text;fontColor=#999999;fontSize=11;align=left;" vertex="1" parent="1"><mxGeometry x="52" y="110" width="280" height="22" as="geometry" /></mxCell>
<mxCell id="selected-account" value="[provider icon]  Personal                       ✓" style="rounded=1;fillColor=#343434;strokeColor=none;fontColor=#eeeeee;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="48" y="138" width="294" height="30" as="geometry" /></mxCell>
<mxCell id="other-account" value="[provider icon]  Work" style="text;fontColor=#cccccc;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="48" y="170" width="294" height="30" as="geometry" /></mxCell>
<mxCell id="settings-link" value="Manage accounts                                  ↗" style="text;fontColor=#aaaaaa;fontSize=12;align=left;spacing=8;" vertex="1" parent="1"><mxGeometry x="48" y="232" width="294" height="30" as="geometry" /></mxCell>
<mxCell id="trigger" value="[provider icon] Personal  ⌄       model / effort     ↑" style="rounded=1;fillColor=#202020;strokeColor=#555555;fontColor=#cccccc;fontSize=12;align=left;spacing=12;" vertex="1" parent="1"><mxGeometry x="40" y="290" width="650" height="55" as="geometry" /></mxCell>
<mxCell id="blocked" value="No account available&#10;&#10;Connect a Claude account in Settings - Providers to chat.&#10;[Claude icon] No account available        Choose model    Send disabled" style="rounded=1;fillColor=#202020;strokeColor=#555555;fontColor=#cccccc;fontSize=14;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="740" y="100" width="650" height="160" as="geometry" /></mxCell>
<mxCell id="model-loading" value="No selected account: placeholder Select an account, or No account available.&#10;Ready account available: default within the selected provider, then load models.&#10;No stale model/effort; no separate account-selection paragraph." style="rounded=1;fillColor=#202020;strokeColor=#555555;fontColor=#cccccc;fontSize=14;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="740" y="290" width="650" height="110" as="geometry" /></mxCell>
<mxCell id="welcome-text" value="Describe a workflow or ask me to change one.&#10;I can inspect workflows and save a separate editable draft." style="text;fontColor=#777777;fontSize=13;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="435" width="384" height="50" as="geometry" /></mxCell>
<mxCell id="welcome-card" value="[provider icon]  Codex          Selected&#10;                       OpenAI" style="rounded=1;fillColor=#202020;strokeColor=#555555;fontColor=#cccccc;fontSize=13;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="92" y="500" width="320" height="70" as="geometry" /></mxCell>
<mxCell id="rules" value="TRANSITIONS / ACCEPTANCE&#10;AC01 Account menu: compact icon rows; selected row subtly highlighted; separated Manage accounts link. Outside click/Escape dismiss; arrows navigate. New chats default to the first connected ready account for this profile/provider, without sending a prompt. If none is ready, a connected expired-token account uses guarded discovery/refresh; OpenCode held-key/unverified summaries may default without certifying auth. Both settings links navigate in the current tab, retaining profile-scoped drafts/provider for return and preserving the editor unsaved/build guard. Explicit choices persist.&#10;AC02 Provider has no connected account: placeholder and trigger say No account available. Model picker and Send disabled; draft stays editable. No fallback to another provider.&#10;AC03 Selected account: discover its models only; loading and empty discovery stay explicit. Switching provider preserves draft and defaults only within that provider. Same-account reselection keeps loaded models. A profile switch waits for its own list; existing conversations never change their saved binding.&#10;AC04 Provider cards have a320px maximum width, fluid in a narrow sidebar; explanatory sentence width stays independent; icon/text columns align. Composer stays editable during startup/active work while Send remains fenced; late acknowledgements preserve newer drafts.&#10;AC05 Before a native session, preview supported Codex command names; only initial status is selectable. No fabricated catalog or hidden model prompt. Existing sessions list observed executable commands.&#10;AC07 Incomplete/unmatched slash text is chat. Known unsupported commands and invalid arguments refuse; editing clears definite input errors only. Uncertain dispatch stays fenced.&#10;AC06 Real validation: new chat defaults the connected Codex account, loads models and accepts an ordinary message. Inspect empty Claude/OpenCode account states without credential copies or model probes." style="rounded=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=16;align=left;verticalAlign=top;spacing=16;whiteSpace=wrap;html=0;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1350" height="320" as="geometry" /></mxCell>
</root></mxGraphModel></diagram>
<diagram id="native-skills-293" name="NS-293 - Bundled native skills"><mxGraphModel grid="1" page="1" pageWidth="1280" pageHeight="800"><root><mxCell id="0" /><mxCell id="1" parent="0" />
<mxCell id="title" value="NS-293: Bundled skills in the native menu" style="text;fontSize=24;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="1180" height="50" as="geometry" /></mxCell>
<mxCell id="menu" value="" style="rounded=1;fillColor=#242424;strokeColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="540" height="330" as="geometry" /></mxCell>
<mxCell id="commands" value="Commands&#10; /status     Show session status&#10; /mcp        Show MCP servers&#10;&#10;Skills&#10; $skill-creator     Create or update a skill             &gt;&#10; $imagegen          Requires an unavailable service&#10; $skill-installer   Provider configuration is managed" style="text;fontSize=14;fontColor=#bbbbbb;align=left;verticalAlign=top;spacing=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="55" y="110" width="510" height="300" as="geometry" /></mxCell>
<mxCell id="composer" value="$skill-creator Explain how to structure a skill" style="rounded=1;fillColor=#1c1c1c;strokeColor=#777777;fontColor=#eeeeee;fontSize=14;align=left;spacing=14;" vertex="1" parent="1"><mxGeometry x="40" y="445" width="540" height="90" as="geometry" /></mxCell>
<mxCell id="approval" value="Human Send → Running → Native result&#10;No second approval.&#10;&#10;Assistant proposal: Run $skill-creator…&#10;May use model quota.  [Approve] [Reject]" style="rounded=1;fillColor=#1c1c1c;strokeColor=#555555;fontColor=#bbbbbb;fontSize=14;align=left;spacing=14;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="650" y="125" width="550" height="145" as="geometry" /></mxCell>
<mxCell id="rules" value="NS01 / opens observed Commands and Skills groups; $ also filters Codex skills. Skills use a book icon and retain provider names, descriptions and argument hints. Selecting fills the composer; it does not dispatch.&#10;&#10;NS02 Unsupported rows stay disabled with a capability-specific explanation. No host or personal skill import. No invented entries before native discovery. Currency like $20 stays chat; native skill mentions require the explicit native route.&#10;&#10;NS03 Human Send approves the exact request and atomically reserves one native invocation; no pending approval card. Assistant proposals still require Approve or Reject. Both paths revalidate source/catalog; Reject does not dispatch.&#10;&#10;NS04 Stream native activity and show the normal response. A completed turn is not proof of a file/configuration change. Missing load/expansion or terminal evidence cannot become success.&#10;&#10;NS05 Existing approvals, cancellation, copy/export and account isolation remain. A skill does not grant additional controller tools or external effects." style="rounded=1;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#0f172a;fontSize=15;align=left;verticalAlign=top;spacing=16;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="650" y="300" width="550" height="440" as="geometry" /></mxCell>
</root></mxGraphModel></diagram>
</mxfile>