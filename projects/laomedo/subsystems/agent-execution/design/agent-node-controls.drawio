<mxfile>
  <diagram name="Agent node controls">
    <mxGraphModel>
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="main" value="Agent node - main controls&#10;Task input&#10;Operation&#10;Model: runner-discovered dropdown&#10;Reasoning Effort: model-specific dropdown&#10;Skill References input (below Reasoning Effort)&#10;MCP Tools input (below Skill References; optional list)&#10;Answer / Run Reference / Submission outputs" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="440" height="240" as="geometry" />
        </mxCell>
        <mxCell id="advanced" value="Advanced controls - collapsed by default&#10;Expand inside node with click or keyboard&#10;Preserve values; no graph execution on toggle" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="440" height="110" as="geometry" />
        </mxCell>
        <mxCell id="expanded" value="Advanced controls - expanded state&#10;Output Continuation Retries&#10;HTTP Timeout&#10;Runner URL&#10;Only advanced scalar controls; wired controls stay outside&#10;Respect Inspector promotion to main form&#10;Update node handle geometry on toggle/minimize" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;" vertex="1" parent="1">
          <mxGeometry x="540" y="40" width="460" height="245" as="geometry" />
        </mxCell>
        <mxCell id="internal" value="Internal compatibility fields - not rendered&#10;Request ID and inline Skill IDs&#10;Output Requirements and its JSON alternative&#10;Prior Run and Prior Run JSON&#10;Join Bridge URL: backend configuration" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;" vertex="1" parent="1">
          <mxGeometry x="540" y="310" width="460" height="190" as="geometry" />
        </mxCell>
        <mxCell id="compatibility" value="Legacy connection limitation&#10;Hidden ports remain hidden in old saved schemas too.&#10;Backend values are retained. Visible-handle and&#10;editing/save migration remain unverified." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="440" height="150" as="geometry" />
        </mxCell>
        <mxCell id="behavior" value="Execution and ownership&#10;Request identity is automatic.&#10;Skills and revisions are configured on Skill nodes.&#10;Codex bridge applies only to fresh/start; lifecycle&#10;operations and OpenCode use their runner directly." style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0fdf4;" vertex="1" parent="1">
          <mxGeometry x="540" y="530" width="460" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="MCP Toolset connections - issue 280">
    <mxGraphModel page="1" pageWidth="1100" pageHeight="850">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="mcp" value="Existing MCP server node&#10;Registered server + selected tools&#10;Toolset output" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0fdf4;fontSize=15;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="60" width="310" height="135" />
        </mxCell>
        <mxCell id="skill" value="Skill node&#10;Pinned Skill References output" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f0fdf4;fontSize=15;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="250" width="310" height="100" />
        </mxCell>
        <mxCell id="agent" value="Laomedo Agent&#10;Task / Operation / Model / Effort&#10;Skill References input&#10;MCP Tools input (Tool; optional list)&#10;Answer / Run Reference / Submission" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;fontSize=15;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="60" width="440" height="225" />
        </mxCell>
        <mxCell id="idle" value="Disconnected&#10;Existing Agent behavior; no external access" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;fontSize=15;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="340" width="440" height="80" />
        </mxCell>
        <mxCell id="ready" value="Connected / running&#10;Exact selected tools; skills stay independent&#10;Fresh, asynchronous start and resume share access&#10;Start returns while app retains connections" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;fontSize=15;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="410" width="410" height="145" />
        </mxCell>
        <mxCell id="failure" value="Unavailable / changed / unsupported&#10;Use existing descriptive error presentation&#10;Safe error code and recovery guidance&#10;No fallback, widened grant or call replay" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#fff7ed;fontSize=15;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="490" y="470" width="440" height="145" />
        </mxCell>
        <mxCell id="stop" value="Completed / cancelled / app closed&#10;Revoke invocation access&#10;Do not close unrelated pooled clients" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#f8fafc;fontSize=15;align=left;spacing=12;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="40" y="620" width="410" height="105" />
        </mxCell>
        <mxCell id="mcp-edge" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=1;exitY=0.7;entryX=0;entryY=0.62;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="mcp" target="agent" value="Toolset ? MCP Tools">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="420" y="154" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="skill-edge" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;exitX=1;exitY=0.2;entryX=0;entryY=0.49;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="skill" target="agent" value="Skill References">
          <mxGeometry as="geometry" relative="1">
            <Array as="points">
              <mxPoint x="455" y="270" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>