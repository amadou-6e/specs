5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="51" y="663" width="610" height="32" as="geometry" /></mxCell><mxCell id="s2-pr" value="PR          No matching PRs.   ▾" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#f4f4f5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="51" y="711" width="610" height="32" as="geometry" /></mxCell><mxCell id="s3-title" value="Older saved template - presentation only" style="text;html=0;align=left;fontSize=15;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="725" y="465" width="650" height="30" as="geometry" /></mxCell><mxCell id="s3-card" value="" style="rounded=1;fillColor=#18181b;strokeColor=#52525b;" vertex="1" parent="1"><mxGeometry x="725" y="500" width="640" height="315" as="geometry" /></mxCell><mxCell id="s3-url-label" value="Repository URL" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#f4f4f5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="741" y="510" width="610" height="22" as="geometry" /></mxCell><mxCell id="s3-url" value="https://github.com/owner/repo" style="rounded=1;fillColor=#18181b;strokeColor=#52525b;text;html=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#f4f4f5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="741" y="537" width="610" height="35" as="geometry" /></mxCell><mxCell id="s3-status" value="" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#f4f4f5;whiteSpace=wrap;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="741" y="575" width="610" height="30" as="geometry" /></mxCell><mxCell id="s3-state" value="State     open / closed / merged / all   ▾" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#f4f4f5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="741" y="615" width="610" height="32" as="geometry" /></mxCell><mxCell id="s3-labels" value="Labels    backend   ▾" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#f4f4f5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="741" y="663" width="610" height="32" as="geometry" /></mxCell><mxCell id="s3-pr" value="PR          #42 Saved exact selection   ▾" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#f4f4f5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="741" y="711" width="610" height="32" as="geometry" /></mxCell><mxCell id="states-note" value="Refresh list lives inside Labels/PR menus, available after failure too. No tasks or writes. Older templates: reveal State, hide Discovery row, retain stored filters/selection until a normal read or user edit revalidates them." style="text;html=0;align=left;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="845" width="1350" height="45" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="pr-context-267" name="Unified PR context"><mxGraphModel page="1" pageWidth="1250" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ctx-title" value="GitHub PR: one input, one output" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=18;fontSize=16;fillColor=#18181b;fontColor=#f4f4f5;strokeColor=#52525b;"><mxGeometry x="40" y="20" width="1150" height="45" as="geometry" /></mxCell><mxCell id="ctx-ports" value="Repository URL / State / Labels / PR picker&#10;&#10;Input PR: optional identity + operation request&#10;Output PR: snapshot + operation outcome + evidence" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=18;fontSize=16;fillColor=#18181b;fontColor=#f4f4f5;strokeColor=#52525b;"><mxGeometry x="40" y="100" width="500" height="230" as="geometry" /></mxCell><mxCell id="ctx-read" value="Disconnected input -&gt; read picker selection&#10;Upstream successful context -&gt; revalidate same PR&#10;Upstream failed/unknown -&gt; refuse before dispatch&#10;Identity conflict or malformed input -&gt; safe failure" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=18;fontSize=16;fillColor=#18181b;fontColor=#f4f4f5;strokeColor=#52525b;"><mxGeometry x="600" y="100" width="570" height="230" as="geometry" /></mxCell><mxCell id="ctx-loop" value="PR output -&gt; Agent task (Data adapted to text)&#10;Agent answer -&gt; PR context input&#10;Host stamps authority; one operation; terminal output&#10;Terminal feedback never starts another Agent run" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=18;fontSize=16;fillColor=#18181b;fontColor=#f4f4f5;strokeColor=#52525b;"><mxGeometry x="40" y="390" width="500" height="230" as="geometry" /></mxCell><mxCell id="ctx-migration" value="Explicit legacy migration&#10;Known compatible edges -&gt; unified ports&#10;Two incoming connections / incompatible consumers -&gt; repair required&#10;No dropped edges or inferred permissions&#10;Retain unrelated graph values and wiring" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=18;fontSize=16;fillColor=#18181b;fontColor=#f4f4f5;strokeColor=#52525b;"><mxGeometry x="600" y="390" width="570" height="230" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>