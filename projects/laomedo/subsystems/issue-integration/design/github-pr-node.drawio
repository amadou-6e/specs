ce=wrap;" vertex="1" parent="1"><mxGeometry x="741" y="663" width="610" height="32" as="geometry" /></mxCell><mxCell id="s3-pr" value="PR          #42 Saved exact selection   ▾" style="text;html=0;align=left;verticalAlign=middle;fontSize=14;fontColor=#f4f4f5;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="741" y="711" width="610" height="32" as="geometry" /></mxCell><mxCell id="states-note" value="Refresh list lives inside Labels/PR menus, available after failure too. No tasks or writes. Older templates: reveal State, hide Discovery row, retain stored filters/selection until a normal read or user edit revalidates them." style="text;html=0;align=left;fontSize=13;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="35" y="845" width="1350" height="45" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="pr-context-267" name="Unified PR context"><mxGraphModel page="1" pageWidth="1250" pageHeight="900"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="ctx-title" value="GitHub PR: one input, one output" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=18;fontSize=16;fillColor=#18181b;fontColor=#f4f4f5;strokeColor=#52525b;"><mxGeometry x="40" y="20" width="1150" height="45" as="geometry" /></mxCell><mxCell id="ctx-ports" value="Repository URL / State / Labels / PR picker&#10;&#10;Input PR: optional identity + operation request&#10;Output PR: snapshot + operation outcome + evidence" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=18;fontSize=16;fillColor=#18181b;fontColor=#f4f4f5;strokeColor=#52525b;"><mxGeometry x="40" y="100" width="500" height="230" as="geometry" /></mxCell><mxCell id="ctx-read" value="Disconnected input -&gt; read picker selection&#10;Upstream successful context -&gt; revalidate same PR&#10;Upstream failed/unknown -&gt; refuse before dispatch&#10;Identity conflict or malformed input -&gt; safe failure" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=18;fontSize=16;fillColor=#18181b;fontColor=#f4f4f5;strokeColor=#52525b;"><mxGeometry x="600" y="100" width="570" height="230" as="geometry" /></mxCell><mxCell id="ctx-loop" value="PR output -&gt; Agent task (Data adapted to text)&#10;Agent answer -&gt; PR context input&#10;Host stamps authority; one operation; terminal output&#10;Terminal feedback never reruns the same Agent" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=18;fontSize=16;fillColor=#18181b;fontColor=#f4f4f5;strokeColor=#52525b;"><mxGeometry x="40" y="390" width="500" height="230" as="geometry" /></mxCell><mxCell id="ctx-migration" value="Maintained example wiring&#10;PR output -&gt; Agent Task&#10;Agent answer -&gt; same PR input&#10;Single context carries identity and operation&#10;Personal saved graphs are outside scope" vertex="1" parent="1" style="rounded=1;whiteSpace=wrap;html=0;align=left;spacing=18;fontSize=16;fillColor=#18181b;fontColor=#f4f4f5;strokeColor=#52525b;"><mxGeometry x="600" y="390" width="570" height="230" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="saved-accounts-286" name="Saved accounts"><mxGraphModel dx="1360" dy="2400" grid="1" gridSize="10" page="1" pageWidth="1360" pageHeight="2400" background="#ffffff"><root><mxCell id="0" value="" /><mxCell id="1" parent="0" value="" /><mxCell id="GN286-title" value="Saved GitHub accounts  -  GitHub PR" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=24;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="35" y="20" width="1270" height="42" as="geometry" /></mxCell><mxCell id="GN286-S01" value="S01&lt;br&gt;Choose connection" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;fillColor=#eff6ff;strokeColor=#93c5fd;" vertex="1" parent="1"><mxGeometry x="35" y="95" width="190" height="65" as="geometry" /></mxCell><mxCell id="GN286-S02" value="S02&lt;br&gt;Verify repository" styl