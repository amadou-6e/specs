<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="github-pr-node" name="GitHub PR">
    <mxGraphModel page="1" pageWidth="1300" pageHeight="1300">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="GI01" value="GitHub PR&#10;Repository URL [ https://github.com/owner/repo ]&#10;Inline connection feedback below URL; no Discovery heading&#10;State [ open / closed / merged / all ] (visible)&#10;Labels [ fuzzy search discovered labels v ] (multi-select)&#10;ALL labels match | [research] [backend]&#10;PR [ fuzzy search number/title v ]&#10;Input: PR context (optional identity + operation)&#10;Output: PR (snapshot + operation outcome)&#10;Open Labels/PR menu -&gt; Refresh list&#10;Tabs: PR viewer | Open in GitHub (replace Code)&#10;Read - Agent once - apply same PR - stop" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;">
          <mxGeometry as="geometry" x="40" y="40" width="550" height="310" />
        </mxCell>
        <mxCell id="GI02" value="Loading and dependency changes&#10;Repository change: clear labels and PR&#10;Labels/State change: clear PR&#10;Loading/failure/empty feedback below Repository URL&#10;Ignore late responses for previous selectors&#10;No implicit first-PR selection" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;">
          <mxGeometry as="geometry" x="630" y="40" width="600" height="200" />
        </mxCell>
        <mxCell id="GI03" value="All-label and State filtering&#10;No labels: all PRs in selected State&#10;research + backend: only PRs with both&#10;Closed includes merged (saved compatibility)&#10;Merged: closed + valid non-null merged_at -&gt; merged=true&#10;Fuzzy search only narrows discovered labels/PRs&#10;Exact PR identity retained; bounded closed-list pagination&#10;Missing/contradictory merge metadata never qualifies" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;">
          <mxGeometry as="geometry" x="630" y="270" width="600" height="210" />
        </mxCell>
        <mxCell id="GI04" value="Incoming operation&#10;Upstream -&gt; PR context (close or modify)&#10;Modify: title / body / labels (replace full set)&#10;PR context from an earlier node can bind target&#10;Explicit picker and reference must agree&#10;Host resolves scoped expiring grant; no token field" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;">
          <mxGeometry as="geometry" x="40" y="370" width="550" height="210" />
        </mxCell>
        <mxCell id="GI05" value="Failures and uncertain delivery&#10;No matching PRs / connection failure are distinct&#10;A changed PR must still match current filters&#10;Result: failed / unknown with fixed error category&#10;No blind replay after timeout or lost response&#10;A task message cannot imply successful mutation" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;">
          <mxGeometry as="geometry" x="630" y="490" width="600" height="210" />
        </mxCell>
        <mxCell id="GI06" value="Live execution and outcomes&#10;Read current selected PR at invocation&#10;One invocation: all outputs share one execution&#10;Close/modify read back confirmed current PR&#10;Result: not_requested / succeeded / failed / unknown&#10;After a filter-changing write, report the actual target&#10;New reads revalidate; evidence kept internally" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;">
          <mxGeometry as="geometry" x="40" y="640" width="550" height="220" />
        </mxCell>
        <mxCell id="GI07" value="Read-only PR viewer&#10;Selected repository and PR identity only&#10;Current title / body / labels / state / draft / merged&#10;Head branch / base branch&#10;Loading, unavailable, no selection and Retry&#10;Selection change aborts/ignores old reads&#10;No raw HTML, scripts or remote images&#10;Open in GitHub: exact URL, new tab, safe opener" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;">
          <mxGeometry as="geometry" x="40" y="970" width="1190" height="220" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
