ue="S04 Cancel  -  stay on canvas; no job. One dialog covers every reachable write-capable node. Runtime writes outside approved bounds fail before dispatch." style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="480" y="230" width="830" height="65" as="geometry" /></mxCell><mxCell id="GN286-node" value="" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=5;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="40" y="335" width="440" height="560" as="geometry" /></mxCell><mxCell id="GN286-node-title" value="GitHub PR" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=18;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="65" y="355" width="370" height="30" as="geometry" /></mxCell><mxCell id="GN286-connection-label" value="Connection" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;fontColor=#e4e4e7;" vertex="1" parent="1"><mxGeometry x="65" y="405" width="370" height="22" as="geometry" /></mxCell><mxCell id="GN286-connection" value="@account   v" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;align=left;spacingLeft=12;fillColor=#27272a;strokeColor=#52525b;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="65" y="430" width="370" height="36" as="geometry" /></mxCell><mxCell id="GN286-repository-label" value="Repository URL" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;fontColor=#e4e4e7;" vertex="1" parent="1"><mxGeometry x="65" y="485" width="370" height="22" as="geometry" /></mxCell><mxCell id="GN286-repository" value="https://github.com/account/private" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;align=left;spacingLeft=12;fillColor=#27272a;strokeColor=#52525b;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="65" y="510" width="370" height="36" as="geometry" /></mxCell><mxCell id="GN286-available" value="Connected  -  Repository access verified" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="65" y="558" width="370" height="25" as="geometry" /></mxCell><mxCell id="GN286-state-label" value="State" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;fontColor=#e4e4e7;" vertex="1" parent="1"><mxGeometry x="65" y="605" width="370" height="22" as="geometry" /></mxCell><mxCell id="GN286-state" value="Open   v" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;align=left;spacingLeft=12;fillColor=#27272a;strokeColor=#52525b;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="65" y="630" width="370" height="36" as="geometry" /></mxCell><mxCell id="GN286-labels-label" value="Labels" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;fontColor=#e4e4e7;" vertex="1" parent="1"><mxGeometry x="65" y="685" width="370" height="22" as="geometry" /></mxCell><mxCell id="GN286-labels" value="Select labels   v" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;align=left;spacingLeft=12;fillColor=#27272a;strokeColor=#52525b;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="65" y="710" width="370" height="36" as="geometry" /></mxCell><mxCell id="GN286-target-label" value="PR" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;fontColor=#e4e4e7;" vertex="1" parent="1"><mxGeometry x="65" y="765" width="370" height="22" as="geometry" /></mxCell><mxCell id="GN286-target" value="#12 Selected PR   v" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;align=left;spacingLeft=12;fillColor=#27272a;strokeColor=#52525b;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="65" y="790" width="370" height="36" as="geometry" /></mxCell><mxCell id="GN286-ports" value="Existing inputs and outputs stay unchanged." style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="65" y="852" width="370" height="25" as="geometry" /></mxCell><mxCell id="GN286-node-story" value="S01-S03  -  Choose the account for this node&lt;br&gt;&lt;br&gt;As a user, I choose a saved GitHub account and an allowed repository, then discover its real PRs.&lt;br&gt;&lt;br&gt;Changing account clears old labels and targets. No account is chosen implicitly and access failure never borrows another account.&lt;br&gt;&lt;br&gt;A write-capable node needs an exact picker target before Run. Agent-generated content can change that target's content only within the approved operation kinds; another target is refused." style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="525" y="345" width="780" height="245" as="geometry" /></mxCell><mxCell id="GN286-selector-menu" value="" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=5;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="525" y="630" width="480" height="230" as="geometry" /></mxCell><mxCell id="GN286-empty-label" value="Connection" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;fontColor=#e4e4e7;" vertex="1" parent="1"><mxGeometry x="545" y="646" width="440" height="22" as="geometry" /></mxCell><mxCell id="GN286-empty" value="Choose a connection   v" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;align=left;spacingLeft=12;fillColor=#27272a;strokeColor=#52525b;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="545" y="671" width="440" height="36" as="geometry" /></mxCell><mxCell id="GN286-option-0" value="@account  -  Connected" style="whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=12;fillColor=#27272a;strokeColor=#3f3f46;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="545" y="714" width="440" height="40" as="geometry" /></mxCell><mxCell id="GN286-option-1" value="@other  -  Reconnect required" style="whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=12;fillColor=#27272a;strokeColor=#3f3f46;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="545" y="757" width="440" height="40" as="geometry" /></mxCell><mxCell id="GN286-option-2" value="Configured host connection  -  Not configured" style="whiteSpace=wrap;html=1;fontSize=14;align=left;spacingLeft=12;fillColor=#27272a;strokeColor=#3f3f46;fontColor=#71717a;" vertex="1" parent="1"><mxGeometry x="545" y="800" width="440" height="40" as="geometry" /></mxCell><mxCell id="GN286-approval" value="" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=5;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="40" y="955" width="570" height="365" as="geometry" /></mxCell><mxCell id="GN286-approval-title" value="Allow changes for this run?" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=20;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="65" y="975" width="515" height="32" as="geometry" /></mxCell><mxCell id="GN286-approval-copy" value="These are the permitted targets and operations.&lt;br&gt;The Agent decides the patch content during the run." style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="65" y="1020" width="515" height="45" as="geometry" /></mxCell><mxCell id="GN286-approval-target-0" value="@account / account/private&lt;br&gt;PR #12  -  Modify title, body, labels; close" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;align=left;spacingLeft=14;fillColor=#27272a;strokeColor=#3f3f46;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="65" y="1080" width="515" height="62" as="geometry" /></mxCell><mxCell id="GN286-approval-target-1" value="@other / other/private&lt;br&gt;Issue #8  -  Modify title, body, labels; close" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;align=left;spacingLeft=14;fillColor=#27272a;strokeColor=#3f3f46;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="65" y="1152" width="515" height="62" as="geometry" /></mxCell><mxCell id="GN286-cancel" value="Cancel" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;fontStyle=1;fillColor=#27272a;strokeColor=#71717a;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="290" y="1260" width="110" height="36" as="geometry" /></mxCell><mxCell id="GN286-allow-run" value="Allow and run" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;fontStyle=1;fillColor=#fafafa;strokeColor=#fafafa;fontColor=#18181b;" vertex="1" parent="1"><mxGeometry x="415" y="1260" width="165" height="36" as="geometry" /></mxCell><mxCell id="GN286-approval-story" value="S04-S06  -  Approve once per run&lt;br&gt;&lt;br&gt;Canvas Run, node Run and playground share one combined dialog. All reachable write-capable nodes appear together.&lt;br&gt;&lt;br&gt;Cancel starts no job. Allow and run consumes this plan for one exact job; all listed permitted effects may execute within it. Existing effect IDs prevent duplicate dispatch.&lt;br&gt;&lt;br&gt;A read-only graph bypasses this dialog. An unexpected write is refused before dispatch. Unknown delivery is never silently retried.&lt;br&gt;&lt;br&gt;Private results remain in my normal profile history after disconnect. Other profiles cannot read them; flow exports omit runtime output." style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="655" y="975" width="650" height="310" as="geometry" /></mxCell><mxCell id="GN286-recovery-heading" value="S07  -  Recovery in the node" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=22;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="40" y="1370" width="1270" height="38" as="geometry" /></mxCell><mxCell id="GN286-error-0" value="" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=5;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="40" y="1430" width="625" height="110" as="geometry" /></mxCell><mxCell id="GN286-error-title-0" value="No connection" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=15;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="58" y="1442" width="585" height="24" as="geometry" /></mxCell><mxCell id="GN286-error-copy-0" value="Choose a connection." style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="58" y="1472" width="385" height="50" as="geometry" /></mxCell><mxCell id="GN286-error-action-0" value="Choose connection" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;fontStyle=1;fillColor=#27272a;strokeColor=#71717a;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="445" y="1483" width="200" height="36" as="geometry" /></mxCell><mxCell id="GN286-error-1" value="" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=5;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="705" y="1430" width="625" height="110" as="geometry" /></mxCell><mxCell id="GN286-error-title-1" value="Disconnected / expired login" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=15;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="723" y="1442" width="585" height="24" as="geometry" /></mxCell><mxCell id="GN286-error-copy-1" value="Reconnect this GitHub account." style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="723" y="1472" width="385" height="50" as="geometry" /></mxCell><mxCell id="GN286-error-action-1" value="Review GitHub access" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;fontStyle=1;fillColor=#27272a;strokeColor=#71717a;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="1110" y="1483" width="200" height="36" as="geometry" /></mxCell><mxCell id="GN286-error-2" value="" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=5;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="40" y="1560" width="625" height="110" as="geometry" /></mxCell><mxCell id="GN286-error-title-2" value="Connection changed / approval expired" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=15;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="58" y="1572" width="585" height="24" as="geometry" /></mxCell><mxCell id="GN286-error-copy-2" value="Access changed. Run again to review access." style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="58" y="1602" width="385" height="50" as="geometry" /></mxCell><mxCell id="GN286-error-action-2" value="Review run" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;fontStyle=1;fillColor=#27272a;strokeColor=#71717a;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="445" y="1613" width="200" height="36" as="geometry" /></mxCell><mxCell id="GN286-error-3" value="" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=5;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="705" y="1560" width="625" height="110" as="geometry" /></mxCell><mxCell id="GN286-error-title-3" value="Issues / PR permission missing" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=15;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="723" y="1572" width="585" height="24" as="geometry" /></mxCell><mxCell id="GN286-error-copy-3" value="Update this App's GitHub permissions." style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="723" y="1602" width="385" height="50" as="geometry" /></mxCell><mxCell id="GN286-error-action-3" value="Review GitHub access" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;fontStyle=1;fillColor=#27272a;strokeColor=#71717a;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="1110" y="1613" width="200" height="36" as="geometry" /></mxCell><mxCell id="GN286-error-4" value="" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=5;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="40" y="1690" width="625" height="110" as="geometry" /></mxCell><mxCell id="GN286-error-title-4" value="Repository not selected" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=15;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="58" y="1702" width="585" height="24" as="geometry" /></mxCell><mxCell id="GN286-error-copy-4" value="Select this repository for the connection." style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="58" y="1732" width="385" height="50" as="geometry" /></mxCell><mxCell id="GN286-error-action-4" value="Review GitHub access" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;fontStyle=1;fillColor=#27272a;strokeColor=#71717a;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="445" y="1743" width="200" height="36" as="geometry" /></mxCell><mxCell id="GN286-error-5" value="" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=5;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="705" y="1690" width="625" height="110" as="geometry" /></mxCell><mxCell id="GN286-error-title-5" value="Repository renamed or transferred" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=15;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="723" y="1702" width="585" height="24" as="geometry" /></mxCell><mxCell id="GN286-error-copy-5" value="Reconnect to confirm this repository's location." style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=13;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="723" y="1732" width="385" height="50" as="geometry" /></mxCell><mxCell id="GN286-error-action-5" value="Review GitHub access" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;fontStyle=1;fillColor=#27272a;strokeColor=#71717a;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="1110" y="1743" width="200" height="36" as="geometry" /></mxCell><mxCell id="GN286-permissions" value="" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=5;fillColor=#18181b;strokeColor=#3f3f46;" vertex="1" parent="1"><mxGeometry x="40" y="1885" width="570" height="380" as="geometry" /></mxCell><mxCell id="GN286-permission-title" value="Review GitHub access" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=20;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="65" y="1905" width="510" height="32" as="geometry" /></mxCell><mxCell id="GN286-permission-account" value="@account  -  account/private" style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;fontColor=#a1a1aa;" vertex="1" parent="1"><mxGeometry x="65" y="1952" width="510" height="25" as="geometry" /></mxCell><mxCell id="GN286-permission-copy" value="This App needs:&lt;br&gt; -  Issues: Read and write&lt;br&gt; -  Pull requests: Read and write&lt;br&gt;&lt;br&gt;Update your private App on GitHub, then approve its&lt;br&gt;installation's new permissions. Repository access&lt;br&gt;stays limited to the repositories you select." style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="65" y="1995" width="510" height="165" as="geometry" /></mxCell><mxCell id="GN286-app-settings" value="Open App settings" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;fontStyle=1;fillColor=#27272a;strokeColor=#71717a;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="65" y="2175" width="220" height="36" as="geometry" /></mxCell><mxCell id="GN286-check-access" value="Check access" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;fontStyle=1;fillColor=#fafafa;strokeColor=#fafafa;fontColor=#18181b;" vertex="1" parent="1"><mxGeometry x="310" y="2175" width="195" height="36" as="geometry" /></mxCell><mxCell id="GN286-back-node" value="Back to node" style="whiteSpace=wrap;html=1;fontSize=14;rounded=1;arcSize=8;fontStyle=1;fillColor=#27272a;strokeColor=#71717a;fontColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="65" y="2220" width="220" height="36" as="geometry" /></mxCell><mxCell id="GN286-permission-story" value="S07  -  S02  -  Update the same private App&lt;br&gt;&lt;br&gt;Review GitHub access opens Settings for the selected connection. It does not create or replace an App and never starts sign-in automatically.&lt;br&gt;&lt;br&gt;Open App settings goes to that account-owned App on GitHub. After the user approves the new permissions, Check access verifies the selected account, App, repository and permissions online.&lt;br&gt;&lt;br&gt;Success: Access updated. Failure stays here with actionable feedback. Back to node returns to the same graph without starting a run; node discovery revalidates access." style="whiteSpace=wrap;html=1;fontSize=14;text;align=left;verticalAlign=top;fillColor=none;strokeColor=none;fontSize=14;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="655" y="1905" width="650" height="330" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>