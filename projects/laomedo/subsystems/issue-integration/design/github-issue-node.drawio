<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net">
  <diagram id="github-issue-node" name="GitHub Issue">
    <mxGraphModel page="1" pageWidth="1300" pageHeight="1000">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="GI01" value="GitHub Issue&#10;Repository URL [ https://github.com/owner/repo ]&#10;Labels [ type to find labels v ] (multi-select)&#10;ALL labels match | [research] [backend]&#10;Issue [ #12 Implement endpoint                 v ]&#10;[Refresh list] | Discovery: 1 matching issue&#10;Advanced: State (open / closed / all)&#10;Inputs: Operation, optional Issue Reference&#10;Outputs: Issue | Task | Operation Result&#10;Tabs: Issue viewer | Open in GitHub (replace Code)" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;">
          <mxGeometry as="geometry" x="40" y="40" width="550" height="290" />
        </mxCell>
        <mxCell id="GI02" value="Loading and dependency changes&#10;Repository change: clear labels and issue&#10;Labels/State change: clear issue&#10;Discovery: Discovering GitHub issues...&#10;Ignore late responses for previous selectors&#10;No implicit first-issue selection" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;">
          <mxGeometry as="geometry" x="630" y="40" width="600" height="200" />
        </mxCell>
        <mxCell id="GI03" value="All-label filtering&#10;No labels: all issues in selected State&#10;research + backend: only issues with both&#10;Search narrows discovered labels/issues&#10;Exclude pull requests; bounded pagination&#10;Refresh keeps a valid exact issue identity" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;">
          <mxGeometry as="geometry" x="630" y="270" width="600" height="180" />
        </mxCell>
        <mxCell id="GI04" value="Incoming operation&#10;Upstream -&gt; Operation (close or modify)&#10;Modify: title / body / labels (replace full set)&#10;Issue Reference from an earlier node can bind target&#10;Explicit picker and reference must agree&#10;Host resolves scoped expiring grant; no token field" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;">
          <mxGeometry as="geometry" x="40" y="370" width="550" height="210" />
        </mxCell>
        <mxCell id="GI05" value="Failures and uncertain delivery&#10;No matching issues / connection failure are distinct&#10;A changed issue must still match current filters&#10;Result: failed / unknown with fixed error category&#10;No blind replay after timeout or lost response&#10;A task message cannot imply successful mutation" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;">
          <mxGeometry as="geometry" x="630" y="490" width="600" height="210" />
        </mxCell>
        <mxCell id="GI06" value="Live execution and outcomes&#10;Read current selected issue at invocation&#10;One invocation: all outputs share one execution&#10;Close/modify read back confirmed current issue&#10;Result: not_requested / succeeded / failed / unknown&#10;After a filter-changing write, report the actual target&#10;New reads revalidate; evidence kept internally" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;">
          <mxGeometry as="geometry" x="40" y="640" width="550" height="220" />
        </mxCell>
      <mxCell id="GI07" value="Read-only issue viewer&#10;Selected repository and issue identity only&#10;Current title / body / labels / state&#10;Loading, unavailable, no selection and Retry&#10;Selection change aborts/ignores old reads&#10;No raw HTML, scripts or remote images&#10;Open in GitHub: exact URL, new tab, safe opener" parent="1" vertex="1" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#172033;"><mxGeometry as="geometry" x="40" y="970" width="1190" height="220" /></mxCell></root>
    </mxGraphModel>
  </diagram>
<diagram id="saved-accounts-286" name="Saved accounts"><mxGraphModel page="1" pageWidth="1240" pageHeight="1050" background="#ffffff"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="GN286-title" parent="1" vertex="1" value="Saved GitHub accounts in GitHub Issue - state flow, screens and user stories" style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#111827;whiteSpace=wrap;fontSize=23;fontStyle=1;"><mxGeometry x="35" y="25" width="1160" height="40" as="geometry" /></mxCell><mxCell id="GN286-S01" parent="1" vertex="1" value="S01&#10;Choose connection" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#93c5fd;fontColor=#111827;fontFamily=Helvetica;fontSize=13;"><mxGeometry x="35" y="95" width="180" height="72" as="geometry" /></mxCell><mxCell id="GN286-S02" parent="1" vertex="1" value="S02&#10;Verify repository" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#93c5fd;fontColor=#111827;fontFamily=Helvetica;fontSize=13;"><mxGeometry x="234" y="95" width="180" height="72" as="geometry" /></mxCell><mxCell id="GN286-edge-S02" parent="1" edge="1" source="GN286-S01" target="GN286-S02" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#475569;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="GN286-S03" parent="1" vertex="1" value="S03&#10;Read / select target" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#93c5fd;fontColor=#111827;fontFamily=Helvetica;fontSize=13;"><mxGeometry x="433" y="95" width="180" height="72" as="geometry" /></mxCell><mxCell id="GN286-edge-S03" parent="1" edge="1" source="GN286-S02" target="GN286-S03" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#475569;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="GN286-S04" parent="1" vertex="1" value="S04&#10;Approve run changes" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#93c5fd;fontColor=#111827;fontFamily=Helvetica;fontSize=13;"><mxGeometry x="632" y="95" width="180" height="72" as="geometry" /></mxCell><mxCell id="GN286-edge-S04" parent="1" edge="1" source="GN286-S03" target="GN286-S04" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#475569;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="GN286-S05" parent="1" vertex="1" value="S05&#10;Execute + current checks" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#93c5fd;fontColor=#111827;fontFamily=Helvetica;fontSize=13;"><mxGeometry x="831" y="95" width="180" height="72" as="geometry" /></mxCell><mxCell id="GN286-edge-S05" parent="1" edge="1" source="GN286-S04" target="GN286-S05" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#475569;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="GN286-S06" parent="1" vertex="1" value="S06&#10;Confirmed / failed / unknown" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#eff6ff;strokeColor=#93c5fd;fontColor=#111827;fontFamily=Helvetica;fontSize=13;"><mxGeometry x="1030" y="95" width="180" height="72" as="geometry" /></mxCell><mxCell id="GN286-edge-S06" parent="1" edge="1" source="GN286-S05" target="GN286-S06" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#475569;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="GN286-flow-note" parent="1" vertex="1" value="Read-only runs pass S03 directly to S05. S04 Cancel: stay at S03, no job or write. S07: access unavailable -&gt; select / reconnect / update permissions; never fall back." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#111827;whiteSpace=wrap;"><mxGeometry x="35" y="190" width="1160" height="55" as="geometry" /></mxCell><mxCell id="GN286-node-card" parent="1" vertex="1" value="GitHub Issue&#10;&#10;Connection&#10;[ @account - Connected                    v ]&#10;&#10;Repository URL&#10;[ https://github.com/account/private ]&#10;&#10;[inline access / permission feedback]&#10;&#10;State&#10;[ Open                                              v ]&#10;&#10;Labels&#10;[ Select labels                                    v ]&#10;&#10;Issue&#10;[ #12 Selected issue                          v ]&#10;&#10;Existing input/output ports stay unchanged." style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#fafafa;align=left;verticalAlign=top;spacing=20;fontFamily=Helvetica;fontSize=15;"><mxGeometry x="45" y="290" width="430" height="435" as="geometry" /></mxCell><mxCell id="GN286-node-story" parent="1" vertex="1" value="S01-S03 / S07 - Select the intended account&#10;&#10;As a user, I choose one of my saved GitHub accounts, enter an allowed private repository and discover its real issues.&#10;&#10;Changing account clears old labels and targets. Unavailable access explains how to reconnect or update that same App.&#10;&#10;Configured host connection is an explicit separate option. Empty means choose a connection; failure never switches identities.&#10;&#10;Only opaque references enter the graph. Existing read/modify/close ports and result envelopes remain." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#111827;whiteSpace=wrap;"><mxGeometry x="520" y="290" width="665" height="340" as="geometry" /></mxCell><mxCell id="GN286-approval" parent="1" vertex="1" value="Allow changes for this run?&#10;&#10;@account / account/private&#10;Issue #12 - modify title/body/labels or close&#10;&#10;Only these targets, for this run.&#10;&#10;[ Cancel ]                     [ Allow and run ]" style="rounded=1;arcSize=8;whiteSpace=wrap;html=0;fillColor=#18181b;strokeColor=#3f3f46;fontColor=#fafafa;align=left;verticalAlign=top;spacing=20;fontFamily=Helvetica;fontSize=15;"><mxGeometry x="45" y="760" width="430" height="225" as="geometry" /></mxCell><mxCell id="GN286-approval-story" parent="1" vertex="1" value="S04-S06 - Approve once, then observe the result&#10;&#10;As a user, I review which account and targets this graph may change, approve once and receive confirmed, failed or unknown outcomes. Cancel starts no job.&#10;&#10;Changing the graph or target invalidates approval. Existing scoped mediation and duplicate-effect protection still apply.&#10;&#10;Private results stay in my local profile history after disconnect. New GitHub reads/writes stop; another profile cannot view that history. Flow exports omit private runtime output." style="text;html=0;strokeColor=none;fillColor=none;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#111827;whiteSpace=wrap;"><mxGeometry x="520" y="755" width="665" height="255" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>