<mxfile host="app.diagrams.net"><diagram id="pr-operation" name="PR operation"><mxGraphModel page="1" pageWidth="1450" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="read" parent="1" vertex="1" value="Laomedo · Action&#10;GitHub PR: select and read&#10;IN: Repository, ALL labels, PR #1&#10;OUT: Exact current PR reference&#10;DETAIL: PR viewer / Open in GitHub" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#dbeafe;strokeColor=#64748b;fontSize=16;"><mxGeometry x="30" y="100" width="350" height="180" as="geometry" /></mxCell><mxCell id="operation" parent="1" vertex="1" value="Fixture · Action&#10;Prepare modify operation&#10;IN: Host-scoped fixture grant&#10;OUT: Operation Data&#10;DETAIL: Update title and body" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f1f5f9;strokeColor=#64748b;fontSize=16;"><mxGeometry x="30" y="380" width="350" height="180" as="geometry" /></mxCell><mxCell id="apply" parent="1" vertex="1" value="Laomedo · Action&#10;GitHub PR: apply Operation&#10;IN: PR Reference + Operation&#10;OUT: PR + Operation Result&#10;DETAIL: Durable request; check grant" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#dbeafe;strokeColor=#64748b;fontSize=16;"><mxGeometry x="520" y="200" width="350" height="180" as="geometry" /></mxCell><mxCell id="result" parent="1" vertex="1" value="Laomedo · Artifact&#10;Inspect operation result&#10;IN: Confirmed / failed / unknown&#10;OUT: PR identity and current state&#10;DETAIL: No retry on unknown" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#dcfce7;strokeColor=#64748b;fontSize=16;"><mxGeometry x="1040" y="200" width="350" height="180" as="geometry" /></mxCell><mxCell id="e1" parent="1" edge="1" source="read" target="apply" value="PR Reference" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" parent="1" edge="1" source="operation" target="apply" value="Operation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" parent="1" edge="1" source="apply" target="result" value="Operation Result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="legend" parent="1" vertex="1" value="Credential-free example · 4 Langflow nodes · 3 edges&#10;Fake provider; real PR node, mediation and REST adapter.&#10;Two graph runs must produce one fixture mutation. No model turns or live writes." style="text;html=0;align=left;whiteSpace=wrap;fontSize=16;"><mxGeometry x="520" y="460" width="850" height="140" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>