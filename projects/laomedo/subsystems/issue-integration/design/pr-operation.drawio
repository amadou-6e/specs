<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="pr-operation" name="PR Agent round trip"><mxGraphModel page="1" pageWidth="1200" pageHeight="700"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="pr" parent="1" vertex="1" value="GitHub PR&#10;Selected PR #1&#10;1. Read current context&#10;3. Apply returned operation once&#10;4. Stop; expose Operation Result&#10;Viewer / Open in GitHub" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fillColor=#dbeafe;strokeColor=#64748b;fontSize=18;"><mxGeometry as="geometry" x="50" y="150" width="400" height="240" /></mxCell><mxCell id="agent" parent="1" vertex="1" value="Agent (fixture)&#10;2. Receive PR Task context&#10;Return one modify/close operation&#10;Exact connected output is consumed&#10;No model calls in this example" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fillColor=#dbeafe;strokeColor=#64748b;fontSize=18;"><mxGeometry as="geometry" x="700" y="150" width="400" height="240" /></mxCell><mxCell id="forward" parent="1" edge="1" source="pr" target="agent" value="Task context" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;exitY=0.2;entryY=0.2;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="return" parent="1" edge="1" source="agent" target="pr" value="Operation feedback (Task loop socket)" style="edgeStyle=orthogonalEdgeStyle;html=0;endArrow=block;exitY=0.85;entryY=0.85;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="note" parent="1" vertex="1" value="Two nodes, two connections. One Agent execution per run.&#10;Same selected PR and read digest; refuse concurrent edits.&#10;Failed / unknown stops without retry. Ordinary Operation input stays empty.&#10;Fake GitHub provider; no live writes. Creation mode remains a proposal." style="text;html=0;align=left;whiteSpace=wrap;fontSize=18;"><mxGeometry as="geometry" x="50" y="450" width="1050" height="180" /></mxCell></root></mxGraphModel></diagram></mxfile>