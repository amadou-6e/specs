        <mxCell id="U8-footer" value="U8   Copyright 2026 Laomedo contributors. MIT License.&#10;At viewport bottom for short content; follows long content." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#18181b;strokeColor=none;fontColor=#e4e4e7;fontFamily=Arial;fontSize=12;absoluteArcSize=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="1270" width="960" height="65" as="geometry" />
        </mxCell>
        <mxCell id="states-title" value="Selection states - identifiers link to the screen" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=none;strokeColor=none;fontColor=#18181b;fontFamily=Arial;fontSize=20;absoluteArcSize=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="110" width="600" height="55" as="geometry" />
        </mxCell>
        <mxCell id="S0" value="S0 - All activity / execution selected&#10;Full invocation aggregate; no conversation row pressed." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#18181b;fontFamily=Arial;fontSize=16;absoluteArcSize=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="180" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="S1" value="S1 - Conversation selected&#10;U2 pressed; details and exports include that conversation only." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#18181b;fontFamily=Arial;fontSize=16;absoluteArcSize=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="330" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="S2" value="S2 - Turn selected&#10;U3 pressed; breadcrumb adds turn; exact turn scope." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#18181b;fontFamily=Arial;fontSize=16;absoluteArcSize=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="480" width="560" height="90" as="geometry" />
        </mxCell>
        <mxCell id="S3" value="S3 - Selected ancestor collapsed&#10;Hidden descendant selection restores to the collapsed conversation." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#18181b;fontFamily=Arial;fontSize=16;absoluteArcSize=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1140" y="630" width="560" height="90" as="geometry" />
