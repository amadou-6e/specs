        <mxCell id="ACT-295-06" value="ACT-295-06 / collapse selected ancestor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#64748b;fontColor=#18181b;fontSize=12;" edge="1" parent="1" source="S2" target="S3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="transition-contract" value="ACT-295-07 / U1 execution change: clear scope; reset collapsed rows; select the first chronological captured invocation (or newest matching node when targeted).&#10;&#10;ACT-295-08 / U5 All activity: return to S0. Conversation breadcrumb: S1. Re-expanding a collapsed row keeps its conversation selected (S1).&#10;&#10;ACT-295-09 / U8: footer placement follows content height. U6/U7 stay outside the metadata/usage card.&#10;&#10;ACT-295-10 / Empty and short states: missing values remain unknown, zero telemetry is centered unbordered text, and empty activity has no selected detail.&#10;&#10;ACT-295-01..03 / Search and disclosure contracts remain on Activity detail controls.&#10;&#10;U4 is the conversation collapse/expand chevron in U2; it changes visibility only unless it hides the selection. Viewing never dispatches an agent." style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#f8fafc;strokeColor=#94a3b8;fontColor=#18181b;fontFamily=Arial;fontSize=15;absoluteArcSize=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="790" width="610" height="490" as="geometry" />
        </mxCell>
        <mxCell id="U2-child-conversation" value="        v  Child review conversation   1 turn" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=14;fillColor=#18181b;strokeColor=none;fontColor=#e4e4e7;fontFamily=Arial;fontSize=15;absoluteArcSize=1;arcSize=8;" vertex="1" parent="1">
          <mxGeometry x="70" y="510" width="420" height="40" as="geometry" />
