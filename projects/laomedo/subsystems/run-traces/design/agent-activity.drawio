<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram id="agent-activity" name="Graph Agents tab target"><mxGraphModel page="1" pageWidth="1500" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="tabs" parent="1" vertex="1" value="Graph     |     Agents [selected]     |     Results&#10;Design target only — no runtime data or product acceptance" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#e2e8f0;strokeColor=#64748b;fontSize=17;"><mxGeometry as="geometry" x="30" y="25" width="1440" height="60" /></mxCell><mxCell id="scope" parent="1" vertex="1" value="Graph execution [one run selector]     [Live / historical]     [Refresh]&#10;Tokens: observed counters / Unknown     Cost: provider estimate / calculated estimate / Unknown     [Filter agent / model / status]" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;"><mxGeometry as="geometry" x="30" y="100" width="1440" height="80" /></mxCell><mxCell id="lanes" parent="1" vertex="1" value="Agent lanes&#10;&#10;v Original Codex agent node&#10;   v Node invocation&#10;       v Native turn&#10;           Tool&#10;           Observed subagent&#10;&#10;Repeated invocations stay separate.&#10;A session can span invocations." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;"><mxGeometry as="geometry" x="30" y="200" width="290" height="420" /></mxCell><mxCell id="axis" parent="1" vertex="1" value="Shared time axis — local clock / elapsed time; exact UTC on hover" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#e2e8f0;strokeColor=#64748b;fontSize=17;"><mxGeometry as="geometry" x="335" y="200" width="740" height="45" /></mxCell><mxCell id="invocation" parent="1" vertex="1" value="Invocation interval — start / running / terminal status" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#dbeafe;strokeColor=#64748b;fontSize=17;"><mxGeometry as="geometry" x="350" y="265" width="690" height="58" /></mxCell><mxCell id="turn" parent="1" vertex="1" value="Turn interval — request / model / usage / messages" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#dcfce7;strokeColor=#64748b;fontSize=17;"><mxGeometry as="geometry" x="375" y="338" width="490" height="58" /></mxCell><mxCell id="tool" parent="1" vertex="1" value="Tool interval — arguments / output / exit" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#fef3c7;strokeColor=#64748b;fontSize=17;"><mxGeometry as="geometry" x="420" y="411" width="260" height="58" /></mxCell><mxCell id="subagent" parent="1" vertex="1" value="Observed child interval — explicit parent identity only" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#ede9fe;strokeColor=#64748b;fontSize=17;"><mxGeometry as="geometry" x="690" y="485" width="345" height="70" /></mxCell><mxCell id="time-note" parent="1" vertex="1" value="Source clock vs receipt clock is explicit. No inferred parent from overlap." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#64748b;fontSize=15;"><mxGeometry as="geometry" x="350" y="570" width="690" height="50" /></mxCell><mxCell id="details" parent="1" vertex="1" value="Selected segment&#10;Agent / invocation / session / turn&#10;Model / effort when observed&#10;Readable local start and duration&#10;&#10;Messages [rendered text]&#10;Tools [name, arguments, result]&#10;JSON / code [highlighted, folded]&#10;Errors / interruptions / approvals&#10;&#10;[Expand raw event and provenance]&#10;[Jump to parent / turn / node]" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;"><mxGeometry as="geometry" x="1090" y="200" width="380" height="420" /></mxCell><mxCell id="usage" parent="1" vertex="1" value="Usage and cost over time&#10;[Input / output / cache]     [Per agent / turn / model]     [Cumulative / increments]&#10;Time series share the timeline selection. Never sum cumulative snapshots.&#10;Cost series identifies provider vs rate-card estimate, currency and rate version.&#10;Missing price or billing information stays Unknown. No double counting across native and OTLP feeds." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f0fdfa;strokeColor=#64748b;fontSize=17;"><mxGeometry as="geometry" x="30" y="640" width="1045" height="180" /></mxCell><mxCell id="empty" parent="1" vertex="1" value="Empty / partial / unsupported&#10;No activity captured&#10;Capture unavailable / access refused&#10;Missing/redacted detail&#10;Incomplete stream / interrupted&#10;Provider capability not verified" style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#f8fafc;strokeColor=#64748b;fontSize=17;"><mxGeometry as="geometry" x="1090" y="640" width="380" height="180" /></mxCell><mxCell id="architecture" parent="1" vertex="1" value="Required evidence binding&#10;Host graph execution → node invocation → native session / turn / item IDs ↔ OTel trace / span / tool IDs&#10;One graph run is shown at a time; history is selectable. Viewing/refreshing never dispatches an agent.&#10;The original Codex Agent remains the execution component. No PR-specific agent node.&#10;Docker runtime, subagent/Claude execution, parallel graph binding and this UI still require real acceptance." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=12;fillColor=#e2e8f0;strokeColor=#64748b;fontSize=17;"><mxGeometry as="geometry" x="30" y="845" width="1440" height="170" /></mxCell></root></mxGraphModel></diagram></mxfile>