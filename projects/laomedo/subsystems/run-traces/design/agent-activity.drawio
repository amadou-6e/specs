<mxfile host="app.diagrams.net"><diagram id="agent-activity" name="Agent activity inspection"><mxGraphModel page="1" pageWidth="1200" pageHeight="800"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="agent" value="Agent node toolbar&#10;Agent activity&#10;Opens inspection; never dispatches a turn" style="rounded=0;whiteSpace=wrap;html=0;align=left;spacing=16;fillColor=#dbeafe;strokeColor=#64748b;fontSize=18;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="330" height="140" as="geometry"/></mxCell>
<mxCell id="viewer" value="Agent activity&#10;&#10;Invocation [start time · status ▼]    [Refresh activity]&#10;&#10;Status                 Captured stream: complete / partial&#10;Provider               Native session: value / Unknown&#10;Started / Ended         Received events (not unique actions)&#10;Usage: observed counters / Unknown&#10;&#10;#1 thread.started       Received time · Observed native event&#10;    Native JSON as plain text&#10;#2 item.completed       Received time · Observed native event&#10;    Message / tool details as plain text&#10;&#10;[First events]    [Next events]&#10;&#10;Empty: No retained activity for this agent.&#10;Unavailable: Capture unavailable or access refused.&#10;Stream completeness does not prove task success." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=16;fillColor=#f8fafc;strokeColor=#64748b;fontSize=18;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="720" height="630" as="geometry"/></mxCell>
<mxCell id="open" edge="1" parent="1" source="agent" target="viewer" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="scope" value="Read-only inspection&#10;Signed-in owner + exact flow/node/invocation&#10;Committed native receipts retained per invocation&#10;First slice: native Codex PR agent&#10;Claude / Docker runner / multi-agent overview unfinished" style="text;whiteSpace=wrap;html=0;align=left;fontSize=17;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="340" height="230" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
