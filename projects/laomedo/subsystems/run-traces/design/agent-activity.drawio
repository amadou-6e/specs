        <mxCell id="ACT-295-04" value="ACT-295-04 / select U2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=0;endArrow=block;strokeColor=#64748b;fontColor=#18181b;fontSize=12;" edge="1" parent="1" source="S0" target="S1">
          <mxGeometry relative="1" as="geometry" />
