        <mxCell id="image-architecture-text-48" value="Key rule: the UI reads BlogHub-owned metadata and stable asset URLs. Remote providers are contacted by backend workers, never synchronously by a card tab. SQLite never stores image bytes." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#18202A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="925" width="1590" height="75" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
