        <mxCell id="asset-data-model-edge-36" value="creates / supersedes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#735AA8;strokeWidth=2;endArrow=block;endFill=1;html=1;fontFamily=Arial;fontSize=11;fontColor=#586574;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="asset-data-model-box-23" target="asset-data-model-box-17">
