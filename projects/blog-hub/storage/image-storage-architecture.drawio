          <mxGeometry x="55" y="900" width="1690" height="240" as="geometry" />
        </mxCell>
        <mxCell id="asset-lifecycle-text-35" value="RETENTION AND GARBAGE COLLECTION" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#18202A;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="73" y="912" width="1654" height="26" as="geometry" />
        </mxCell>
        <mxCell id="asset-lifecycle-text-36" value="Deletion is reference-aware and asynchronous" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#586574;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="73" y="938" width="1654" height="34" as="geometry" />
        </mxCell>
        <mxCell id="asset-lifecycle-box-37" value="1. Remove logical binding&lt;br&gt;Article history may still reference asset" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE1E1;strokeColor=#B55454;fontColor=#18202A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="95" y="980" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="asset-lifecycle-box-38" value="2. Recompute references&lt;br&gt;Current, revisions, remote snapshots" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EDF1;strokeColor=#AAB4BF;fontColor=#18202A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="430" y="980" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="asset-lifecycle-box-39" value="3. Orphan quarantine&lt;br&gt;Retention window prevents accidents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0CC;strokeColor=#B58228;fontColor=#18202A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="765" y="980" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="asset-lifecycle-box-40" value="4. Delete blob and derivatives&lt;br&gt;Only when reference count is zero" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE1E1;strokeColor=#B55454;fontColor=#18202A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1100" y="980" width="250" height="85" as="geometry" />
        </mxCell>
        <mxCell id="asset-lifecycle-box-41" value="5. Record audit event&lt;br&gt;Storage reclaimed and reason" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF3E4;strokeColor=#4D8B62;fontColor=#18202A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1435" y="980" width="250" height="85" as="geometry" />
