        <mxCell id="asset-lifecycle-edge-43" value="zero references" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#4C78A8;strokeWidth=2;endArrow=block;endFill=1;html=1;fontFamily=Arial;fontSize=11;fontColor=#586574;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="asset-lifecycle-box-38" target="asset-lifecycle-box-39">
