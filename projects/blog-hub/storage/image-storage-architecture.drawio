        <mxCell id="asset-reconciliation-box-52" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#AAB4BF;fontColor=#18202A;fontSize=14;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1150" y="500" width="595" height="520" as="geometry" />
        </mxCell>
        <mxCell id="asset-reconciliation-text-53" value="FAILURE POLICY" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#18202A;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1168" y="512" width="559" height="26" as="geometry" />
        </mxCell>
        <mxCell id="asset-reconciliation-text-54" value="The UI remains useful when providers or storage are degraded" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#586574;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="1168" y="538" width="559" height="34" as="geometry" />
        </mxCell>
        <mxCell id="asset-reconciliation-box-55" value="Provider timeout / 5xx&lt;br&gt;Serve last good snapshot; mark stale; retry with backoff" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0CC;strokeColor=#AAB4BF;fontColor=#18202A;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1185" y="575" width="525" height="54" as="geometry" />
        </mxCell>
        <mxCell id="asset-reconciliation-box-56" value="429 rate limit&lt;br&gt;Honor Retry-After; coalesce refresh requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0CC;strokeColor=#AAB4BF;fontColor=#18202A;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1185" y="636" width="525" height="54" as="geometry" />
        </mxCell>
        <mxCell id="asset-reconciliation-box-57" value="Invalid image / MIME&lt;br&gt;Quarantine bytes; keep metadata; never render inline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE1E1;strokeColor=#AAB4BF;fontColor=#18202A;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1185" y="697" width="525" height="54" as="geometry" />
        </mxCell>
        <mxCell id="asset-reconciliation-box-58" value="Blob write succeeds, SQL fails&lt;br&gt;Leave temporary object; sweeper removes uncommitted blobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE1E1;strokeColor=#AAB4BF;fontColor=#18202A;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1185" y="758" width="525" height="54" as="geometry" />
        </mxCell>
        <mxCell id="asset-reconciliation-box-59" value="SQL commits, derivative fails&lt;br&gt;Original remains ready; retry derivative independently" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#AAB4BF;fontColor=#18202A;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1185" y="819" width="525" height="54" as="geometry" />
        </mxCell>
        <mxCell id="asset-reconciliation-box-60" value="Object missing&lt;br&gt;Mark asset damaged; restore from versioned bucket or remote source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E3FA;strokeColor=#AAB4BF;fontColor=#18202A;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1185" y="880" width="525" height="54" as="geometry" />
        </mxCell>
        <mxCell id="asset-reconciliation-box-61" value="Remote URL changes&lt;br&gt;Create new snapshot and binding; preserve prior provenance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E3FA;strokeColor=#AAB4BF;fontColor=#18202A;fontSize=11;fontStyle=0;align=left;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1">
          <mxGeometry x="1185" y="941" width="525" height="54" as="geometry" />
        </mxCell>
        <mxCell id="asset-reconciliation-text-62" value="Operational rule: stale is a visible state, not an exception. A failed refresh never erases the last known-good image or snapshot." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#18202A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="55" y="1050" width="1690" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="hashnode-publishing-paths" name="7 - Hashnode publishing paths">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="hashnode-paths-title" value="HASHNODE PUBLISHING PATHS" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#18202A;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="28" width="1690" height="36" as="geometry" /></mxCell>
        <mxCell id="hashnode-paths-subtitle" value="One BlogHub workflow, selected by account capability: deterministic API for Plus users or managed browser automation for non-Plus users" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#586574;fontSize=12;fontStyle=0;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="55" y="68" width="1620" height="34" as="geometry" /></mxCell>
        <mxCell id="hashnode-paths-page" value="07 / 07" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263341;strokeColor=#263341;fontColor=#FFFFFF;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1675" y="32" width="70" height="34" as="geometry" /></mxCell>

        <mxCell id="hashnode-paths-ui" value="BLOGHUB UI&lt;br&gt;Connect Hashnode, compare, draft, or publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E3FA;strokeColor=#7466A8;fontColor=#18202A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="70" y="145" width="300" height="100" as="geometry" /></mxCell>
        <mxCell id="hashnode-paths-capabilities" value="CONNECTION CAPABILITIES&lt;br&gt;Plan eligibility + PAT state&lt;br&gt;Browser-profile state + last verification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#4B77A8;fontColor=#18202A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="505" y="135" width="350" height="120" as="geometry" /></mxCell>
        <mxCell id="hashnode-paths-orchestrator" value="PUBLISHING ORCHESTRATOR&lt;br&gt;Authorize workspace and article&lt;br&gt;Require explicit action approval&lt;br&gt;Choose the best available path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#4F8A68;fontColor=#18202A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="990" y="130" width="410" height="130" as="geometry" /></mxCell>
        <mxCell id="hashnode-paths-policy" value="SHARED POLICY&lt;br&gt;No publish without approval&lt;br&gt;Idempotency per revision + destination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0CC;strokeColor=#B38A35;fontColor=#18202A;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1450" y="145" width="290" height="100" as="geometry" /></mxCell>

        <mxCell id="hashnode-plus-lane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F8FF;strokeColor=#4B77A8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="55" y="330" width="805" height="510" as="geometry" /></mxCell>
        <mxCell id="hashnode-plus-heading" value="PATH A — PLUS USER / API TOKEN" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#315F91;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="350" width="755" height="30" as="geometry" /></mxCell>
        <mxCell id="hashnode-plus-note" value="Preferred deterministic route when the account supports API publishing and a valid PAT is connected" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#586574;fontSize=11;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="80" y="382" width="755" height="30" as="geometry" /></mxCell>
        <mxCell id="hashnode-plus-eligibility" value="1. CAPABILITY CHECK&lt;br&gt;Hashnode Plus eligible&lt;br&gt;PAT present and verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B77A8;fontColor=#18202A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="90" y="445" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="hashnode-plus-vault" value="2. CREDENTIAL VAULT&lt;br&gt;Encrypted Hashnode PAT&lt;br&gt;Never exposed to UI or agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4B77A8;fontColor=#18202A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="350" y="445" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="hashnode-plus-api" value="3. HASHNODE API ADAPTER&lt;br&gt;GraphQL read, compare,&lt;br&gt;create draft, or publish" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#4B77A8;fontColor=#18202A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="610" y="445" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="hashnode-plus-behavior" value="DETERMINISTIC BEHAVIOR&lt;br&gt;Schema validation • stable API contract • bounded retries • provider response captured • no browser session required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#4F8A68;fontColor=#18202A;fontSize=13;align=center;verticalAlign=middle;strokeWidth=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="90" y="640" width="730" height="125" as="geometry" /></mxCell>

        <mxCell id="hashnode-browser-lane" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAF7FF;strokeColor=#7466A8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="940" y="330" width="805" height="510" as="geometry" /></mxCell>
        <mxCell id="hashnode-browser-heading" value="PATH B — NON-PLUS USER / BROWSER LOGIN" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#65528F;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="965" y="350" width="755" height="30" as="geometry" /></mxCell>
        <mxCell id="hashnode-browser-note" value="Fallback for accounts without API publishing: one interactive login, then a persisted isolated browser profile" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#586574;fontSize=11;align=left;verticalAlign=middle;fontFamily=Arial;spacing=0;" vertex="1" parent="1"><mxGeometry x="965" y="382" width="755" height="30" as="geometry" /></mxCell>
        <mxCell id="hashnode-browser-connect" value="1. MANAGED CONNECTION&lt;br&gt;Embedded takeover for login / 2FA&lt;br&gt;BlogHub stores profile ID only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7466A8;fontColor=#18202A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="975" y="445" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="hashnode-browser-skyvern" value="2. SKYVERN SANDBOX&lt;br&gt;Patchright browser worker&lt;br&gt;Encrypted persisted cookie jar" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E3FA;strokeColor=#7466A8;fontColor=#18202A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1235" y="445" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="hashnode-browser-editor" value="3. HASHNODE WEB EDITOR&lt;br&gt;Deterministic selectors first&lt;br&gt;Agent-assisted recovery second" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9E3FA;strokeColor=#7466A8;fontColor=#18202A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="1495" y="445" width="210" height="120" as="geometry" /></mxCell>
        <mxCell id="hashnode-browser-behavior" value="SESSION BEHAVIOR&lt;br&gt;Verify login before each run • pause for reauthentication only when expired • isolate filesystem and downloads • stop before final action unless approved" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF0CC;strokeColor=#B38A35;fontColor=#18202A;fontSize=13;align=center;verticalAlign=middle;strokeWidth=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="975" y="640" width="730" height="125" as="geometry" /></mxCell>

        <mxCell id="hashnode-shared-verification" value="SHARED RESULT VERIFICATION&lt;br&gt;Confirm remote ID, URL, draft/published state, content fingerprint, and provider timestamp" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F3EA;strokeColor=#4F8A68;fontColor=#18202A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="290" y="920" width="520" height="115" as="geometry" /></mxCell>
        <mxCell id="hashnode-shared-snapshot" value="IMMUTABLE REMOTE SNAPSHOT&lt;br&gt;Persist route used, provider response or browser evidence, reconciliation fingerprint, and revision binding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEBFF;strokeColor=#4B77A8;fontColor=#18202A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=2;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="990" y="920" width="520" height="115" as="geometry" /></mxCell>
        <mxCell id="hashnode-shared-rule" value="Selection rule: use the API path when Plus capability and a valid PAT are available. Otherwise use the saved Skyvern profile. A route failure never silently falls through to publishing by another route; BlogHub re-evaluates policy and approval first." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F7F8FA;strokeColor=#AAB4BF;fontColor=#18202A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;strokeWidth=1;spacing=10;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="180" y="1080" width="1440" height="70" as="geometry" /></mxCell>

        <mxCell id="hashnode-edge-ui-capabilities" value="request + intent" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#586574;fontColor=#586574;fontSize=11;fontFamily=Arial;" edge="1" parent="1" source="hashnode-paths-ui" target="hashnode-paths-capabilities"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hashnode-edge-capabilities-orchestrator" value="eligible routes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#586574;fontColor=#586574;fontSize=11;fontFamily=Arial;" edge="1" parent="1" source="hashnode-paths-capabilities" target="hashnode-paths-orchestrator"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hashnode-edge-policy-orchestrator" value="approval policy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#B38A35;fontColor=#8A641E;fontSize=11;fontFamily=Arial;" edge="1" parent="1" source="hashnode-paths-policy" target="hashnode-paths-orchestrator"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hashnode-edge-orchestrator-plus" value="Plus + valid PAT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4B77A8;fontColor=#315F91;fontSize=11;fontStyle=1;fontFamily=Arial;exitX=0.35;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hashnode-paths-orchestrator" target="hashnode-plus-eligibility"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1135" y="285" /><mxPoint x="70" y="285" /><mxPoint x="70" y="505" /></Array></mxGeometry></mxCell>
        <mxCell id="hashnode-edge-plus-vault" value="verified" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4B77A8;fontColor=#315F91;fontSize=11;fontFamily=Arial;" edge="1" parent="1" source="hashnode-plus-eligibility" target="hashnode-plus-vault"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hashnode-edge-vault-api" value="server-side only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4B77A8;fontColor=#315F91;fontSize=11;fontFamily=Arial;" edge="1" parent="1" source="hashnode-plus-vault" target="hashnode-plus-api"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hashnode-edge-orchestrator-browser" value="non-Plus / no API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7466A8;fontColor=#65528F;fontSize=11;fontStyle=1;fontFamily=Arial;exitX=0.65;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="hashnode-paths-orchestrator" target="hashnode-browser-connect"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1255" y="310" /><mxPoint x="920" y="310" /><mxPoint x="920" y="505" /></Array></mxGeometry></mxCell>
        <mxCell id="hashnode-edge-connect-skyvern" value="profile ID" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7466A8;fontColor=#65528F;fontSize=11;fontFamily=Arial;" edge="1" parent="1" source="hashnode-browser-connect" target="hashnode-browser-skyvern"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hashnode-edge-skyvern-editor" value="isolated session" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7466A8;fontColor=#65528F;fontSize=11;fontFamily=Arial;" edge="1" parent="1" source="hashnode-browser-skyvern" target="hashnode-browser-editor"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="hashnode-edge-api-verify" value="provider response" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4F8A68;fontColor=#35694B;fontSize=11;fontFamily=Arial;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.35;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hashnode-plus-behavior" target="hashnode-shared-verification"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="455" y="880" /><mxPoint x="472" y="880" /></Array></mxGeometry></mxCell>
        <mxCell id="hashnode-edge-browser-verify" value="browser evidence" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4F8A68;fontColor=#35694B;fontSize=11;fontFamily=Arial;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.65;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="hashnode-browser-behavior" target="hashnode-shared-verification"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="880" /><mxPoint x="628" y="880" /></Array></mxGeometry></mxCell>
        <mxCell id="hashnode-edge-verify-snapshot" value="verified result" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4F8A68;fontColor=#35694B;fontSize=11;fontStyle=1;fontFamily=Arial;" edge="1" parent="1" source="hashnode-shared-verification" target="hashnode-shared-snapshot"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
