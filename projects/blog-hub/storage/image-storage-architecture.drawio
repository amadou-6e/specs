        <mxCell id="asset-reconciliation-text-20" value="STALE schedules a new FETCHING attempt. DIVERGENT resolution creates a new FRESH snapshot. SYNC ERROR retries from FETCHING without erasing the last known-good image." style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#586574;fontSize=12;fontStyle=0;align=center;verticalAlign=middle;fontFamily=Arial;spacing=0;" vertex="1" parent="1">
