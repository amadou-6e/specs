          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="asset-data-model-edge-38" value="records outcomes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#B55454;strokeWidth=2;endArrow=block;endFill=1;html=1;fontFamily=Inter;fontSize=11;fontColor=#586574;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="asset-data-model-box-23" target="asset-data-model-box-26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="asset-data-model-edge-39" value="lifecycle events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;strokeColor=#B55454;strokeWidth=2;endArrow=block;endFill=1;html=1;fontFamily=Inter;fontSize=11;fontColor=#586574;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="asset-data-model-box-11" target="asset-data-model-box-26">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="asset-data-model-box-40" value="INVARIANTS&lt;br&gt;1. storage_key is never accepted from the client.  2. Asset bytes are immutable after hash assignment.  3. Deleting a binding does not immediately delete bytes.  4. A remote refresh creates a snapshot rather than mutating history.  5. Every row is workspace-scoped." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#263341;strokeColor=#263341;fontColor=#18202A;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;strokeWidth=1;spacing=8;fontFamily=Inter;fontColor=#FFFFFF;" vertex="1" parent="1">
          <mxGeometry x="70" y="1050" width="1760" height="90" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="asset-reconciliation" name="6 - Freshness and recovery">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="asset-reconciliation-text-2" value="FRESHNESS, RECONCILIATION, AND FAILURE RECOVERY" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#18202A;fontSize=25;fontStyle=1;align=left;verticalAlign=middle;fontFamily=Inter;spacing=0;" vertex="1" parent="1">
