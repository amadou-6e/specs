flowchart TD
    START(( )) --> BROWSE

    subgraph BROWSE ["▤  Browse Articles"]
        direction TB
        B0["Load: GET /api/articles"] --> B1[Table rendered]
        B1 -->|"search / status / platform filter (300 ms debounce)"| B0
    end

    B1 -->|click row| PANEL

    subgraph PANEL ["▣  Side Panel"]
        direction LR
        S1[Article detail visible] --> S2{Action}
    end

    S2 -->|Push drafts| JOB_PUSH
    S2 -->|Inspect| JOB_INSP
    S2 -->|"×  close"| B1

    subgraph JOB_PUSH ["↑  Push Job"]
        direction LR
        P1["POST /api/articles/:id/push → poll /api/jobs/:jobId every 2s"]
        P1 -->|done| P2([Reload table])
        P1 -->|error| PE([Error in panel])
    end

    subgraph JOB_INSP ["⊙  Inspect Job"]
        direction LR
        I1["POST /api/articles/:id/inspect → poll /api/jobs/:jobId every 2s"]
        I1 -->|done| I2([Reload table])
        I1 -->|error| IE([Error in panel])
    end

    P2 & PE & I2 & IE --> PANEL

    B1 -->|"New Article button"| END_NEW(( ))
    B1 -->|gate badge| END_INSP(( ))
    PANEL -->|gate badge| END_INSP

    style START  fill:#6366f1,stroke:none
    style END_NEW  fill:#6366f1,stroke:none
    style END_INSP fill:#6366f1,stroke:none
    style PE fill:#2a1515,stroke:#7f1d1d,color:#f87171
    style IE fill:#2a1515,stroke:#7f1d1d,color:#f87171