flowchart TD
    START(( )) --> TABS

    subgraph TABS ["⚙  Tabs"]
        direction LR
        T1[Platforms] & T2[AI Providers] & T3[Account]
    end

    T1 --> PLAT
    T2 --> AI

    %% ── Platform card ─────────────────────────────────────────────────
    subgraph PLAT ["⬡  Platform Card  (Medium / Hashnode / Dev.to)"]
        direction TB
        PL0{Status?}
        PL0 -->|disconnected| PL1[Connect button]
        PL0 -->|expired| PL1

        PL1 -->|"OAuth — Medium only"| PL_OAUTH[OAuth redirect]
        PL_OAUTH -->|callback ok| PL_CON

        PL1 -->|API key| PL_FORM[Key input form]
        PL_FORM -->|"Save / Enter"| PL_SAVE["PUT /api/connections/:id"]
        PL_SAVE -->|ok| PL_CON
        PL_SAVE -->|error| PL_FORM

        PL_CON([Connected])
        PL_CON -->|Test| PL_TEST["POST /api/connections/:id/test — ok or fail"]
        PL_CON -->|Update| PL_FORM
        PL_CON -->|Disconnect| PL_CONF[Confirm popover]
        PL_CONF -->|Confirm| PL_DEL["DELETE /api/connections/:id"]
        PL_CONF -->|Cancel| PL_CON
        PL_DEL --> PL0
    end

    %% ── AI Provider card ──────────────────────────────────────────────
    subgraph AI ["⬡  AI Provider Card  (Claude / Codex)"]
        direction TB
        AI0{Status?}
        AI0 -->|not configured| AI1{Login method}

        AI1 -->|API key| AIK[Key input form]
        AIK -->|"Save / Enter"| AIK2["PUT /api/connections/:id"]
        AIK2 -->|ok| AI_CON
        AIK2 -->|error| AIK

        AI1 -->|"Login with browser"| AI_START["GET /api/connections/:id/oauth-start"]

        AI_START -->|"flow: cli_browser (Anthropic)"| ANTH
        AI_START -->|"flow: device_code (OpenAI)"| OAI

        subgraph ANTH ["Anthropic Loopback OAuth"]
            direction TB
            AN1[Throbber + URL input field] --> AN2["POST submit-code {url}"]
            AN2 -->|ok| AN3["Poll cli-login-status every 2s"]
            AN2 -->|409 session expired| AN1
            AN3 -->|connected| AI_CON
            AN3 -->|error| ANE[Error — Try again]
            ANE -->|Try again| AI_START
        end

        subgraph OAI ["OpenAI Device Code"]
            direction TB
            OA1[Throbber + device code displayed] --> OA2["Poll cli-login-status every 2s"]
            OA2 -->|connected| AI_CON
            OA2 -->|timeout| OAE[Error — Try again]
            OAE -->|Try again| AI_START
        end

        AI_CON([Connected])
        AI_CON -->|Test| AIT["POST /api/connections/:id/test — ok or fail"]
        AI_CON -->|"Update key"| AIK
        AI_CON -->|Remove| AIR[Confirm popover]
        AIR -->|Confirm| AIR2["DELETE /api/connections/:id"]
        AIR -->|Cancel| AI_CON
        AIR2 --> AI0
    end

    style START fill:#6366f1,stroke:none
    style ANE fill:#2a1515,stroke:#7f1d1d,color:#f87171
    style OAE fill:#2a1515,stroke:#7f1d1d,color:#f87171