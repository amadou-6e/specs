;whiteSpace=wrap;html=1;fixedSize=1;fillColor=#a2a3aa;strokeColor=#7f8089;direction=west;size=0.18;" value="" vertex="1"><mxGeometry height="39.3588709677419" width="77.8101851851852" x="1330.18981481481" y="723.22983870968" as="geometry" /></mxCell><mxCell id="p-content-gridlines1" parent="1" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;left=0;right=0;bottom=1;fillColor=none;strokeColor=#676873;dashed=1;dashPattern=2 4;" value="" vertex="1"><mxGeometry height="0.915322580645161" width="265.983796296296" x="1142.0162037037" y="405.61290322581" as="geometry" /></mxCell><mxCell id="p-content-gridlines2" parent="1" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;left=0;right=0;bottom=1;fillColor=none;strokeColor=#676873;dashed=1;dashPattern=2 4;" value="" vertex="1"><mxGeometry height="0.915322580645161" width="265.983796296296" x="1142.0162037037" y="460.53225806452" as="geometry" /></mxCell><mxCell id="p-content-gridlines3" parent="1" style="shape=partialRectangle;whiteSpace=wrap;html=1;top=0;left=0;right=0;bottom=1;fillColor=none;strokeColor=#676873;dashed=1;dashPattern=2 4;" value="" vertex="1"><mxGeometry height="0.915322580645161" width="265.983796296296" x="1142.0162037037" y="515.45161290323" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="voxel-replay-sidebar-anatomy-optimized" name="Sidebar Anatomy (Optimized)"><mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1600" pageHeight="1520" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="Voxel Replay Sidebar Anatomy-bg" parent="1" style="rounded=0;fillColor=#1e1e1e;strokeColor=#3e3e42;" value="" vertex="1"><mxGeometry height="1520" width="1600" as="geometry" /></mxCell><mxCell id="Voxel Replay Sidebar Anatomy-top" parent="1" style="rounded=0;fillColor=#181818;strokeColor=#2b2b2b;fontColor=#f1f1f1;fontSize=22;fontStyle=1;align=left;spacingLeft=24;" value="AnySearch - Voxel Replay Sidebar Anatomy" vertex="1"><mxGeometry height="64" width="1600" as="geometry" /></mxCell><mxCell id="Voxel Replay Sidebar Anatomy-sub" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#9da5b4;fontSize=14;align=left;" value="One complete reference panel with the purpose and visual rationale for every functional section." vertex="1"><mxGeometry height="32" width="1540" x="30" y="76" as="geometry" /></mxCell><mxCell id="replay-sidebar-design-language" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#11161c;strokeColor=#0078d4;fontColor=#cccccc;fontSize=12;align=left;verticalAlign=top;spacing=14;" value="&lt;b&gt;OVERALL DESIGN LANGUAGE&lt;/b&gt;&lt;br&gt;The sidebar follows the VS Code dark workbench: neutral #181818 / #1f1f1f surfaces keep attention on the voxel viewport; thin borders establish hierarchy without card-like visual weight; blue is reserved for the current interactive target; green communicates available or successful state; red is reserved for negative reward. Dense numerical data uses compact or monospace treatment, while explanatory text remains quieter gray." vertex="1"><mxGeometry height="100" width="1520" x="30" y="112" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-panel" parent="1" style="rounded=0;fillColor=#181818;strokeColor=#3e3e42;" value="" vertex="1"><mxGeometry height="1030" width="286" x="60" y="236" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-number" parent="1" style="rounded=0;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=14;fontStyle=1;" value="1" vertex="1"><mxGeometry height="30" width="30" x="72" y="248" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#f1f1f1;fontSize=15;fontStyle=1;align=left;" value="Reference sidebar" vertex="1"><mxGeometry height="24" width="220" x="110" y="245" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-desc" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#9da5b4;fontSize=9;align=left;" value="Complete replay and explain handoff" vertex="1"><mxGeometry height="20" width="220" x="110" y="268" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-trial-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" value="TUNE TRIAL" vertex="1"><mxGeometry height="16" width="100" x="74" y="298" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-trial" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#11161c;strokeColor=#2b2b2b;fontColor=#cccccc;fontSize=10;align=left;spacingLeft=9;" value="Trial 2 / 10 | best reward 15.8&amp;#xa;|&amp;lt;   &amp;lt;   &amp;gt;   &amp;gt;|   T / Y keys&amp;#xa;lr 3.1e-4 | gamma 0.978 | layers 4x128" vertex="1"><mxGeometry height="72" width="262" x="72" y="316" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-experiment-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" value="EXPERIMENT" vertex="1"><mxGeometry height="16" width="100" x="74" y="398" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-experiment" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#2b2b2b;fontColor=#cccccc;fontSize=10;align=left;spacingLeft=9;" value="box_r1_initial_stage&amp;#xa;Run 1e25_0000 | observation box" vertex="1"><mxGeometry height="48" width="262" x="72" y="416" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-iteration-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" value="ITERATIONS" vertex="1"><mxGeometry height="16" width="100" x="74" y="474" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-iteration" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#2b2b2b;fontColor=#cccccc;fontSize=10;align=left;spacingLeft=9;" value="Iter 1 of 7 | #10 | mean reward 0.681&amp;#xa;[=========|------------]&amp;#xa;|&amp;lt;   &amp;lt;   &amp;gt;   &amp;gt;|      [ / ] keys" vertex="1"><mxGeometry height="70" width="262" x="72" y="492" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-episode-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" value="EPISODE" vertex="1"><mxGeometry height="16" width="100" x="74" y="572" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-episode" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#11161c;strokeColor=#2b2b2b;fontColor=#9da5b4;fontSize=10;align=left;spacingLeft=9;" value="Reward 0.681 | Steps 200 / 200 | Success false" vertex="1"><mxGeometry height="40" width="262" x="72" y="590" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-step-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#ffffff;fontSize=9;fontStyle=1;align=left;" value="STEPS" vertex="1"><mxGeometry height="16" width="100" x="74" y="640" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-step" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#04395e;strokeColor=#0078d4;fontColor=#ffffff;fontSize=10;align=left;spacingLeft=9;" value="Step 143 / 200&amp;#xa;[==============|-------]&amp;#xa;|&amp;lt;   &amp;lt;   &amp;gt;   &amp;gt;|      left / right keys" vertex="1"><mxGeometry height="70" width="262" x="72" y="658" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-current-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" value="CURRENT STEP" vertex="1"><mxGeometry height="16" width="100" x="74" y="738" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-current" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#11161c;strokeColor=#2b2b2b;fontColor=#cccccc;fontSize=10;align=left;spacingLeft=9;" value="Action 17 | Step reward -0.010&amp;#xa;Cursor [2, 6, 2] | Voxels 22 | placed false" vertex="1"><mxGeometry height="50" width="262" x="72" y="756" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-playback-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" value="PLAYBACK" vertex="1"><mxGeometry height="16" width="100" x="74" y="816" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-playback" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#2b2b2b;fontColor=#cccccc;fontSize=10;align=left;spacingLeft=9;" value="PLAY / PAUSE     Space key&amp;#xa;Plays continuously through every iteration&amp;#xa;[x] Geometry occludes agent and trail" vertex="1"><mxGeometry height="66" width="262" x="72" y="834" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-explain-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" value="EXPLAINABILITY" vertex="1"><mxGeometry height="16" width="120" x="74" y="910" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-explain-current" parent="1" style="rounded=1;arcSize=5;fillColor=#04395e;strokeColor=#0078d4;fontColor=#ffffff;fontSize=10;fontStyle=1;" value="Explain current step" vertex="1"><mxGeometry height="36" width="126" x="72" y="928" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-explain-open" parent="1" style="rounded=1;arcSize=5;fillColor=#1f1f1f;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=10;" value="Open Explain tab" vertex="1"><mxGeometry height="36" width="126" x="208" y="928" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-explain-note" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#63dc91;fontSize=9;align=left;" value="Checkpoint attached to this run" vertex="1"><mxGeometry height="18" width="250" x="74" y="968" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-reward-label" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" value="REWARD CURVE - CURRENT ITERATION" vertex="1"><mxGeometry height="16" width="230" x="74" y="998" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-reward-bg" parent="1" style="rounded=1;arcSize=5;fillColor=#090c10;strokeColor=#2b2b2b;" value="" vertex="1"><mxGeometry height="100" width="262" x="72" y="1018" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-reward-zero" parent="1" style="rounded=0;fillColor=#d13438;strokeColor=none;" value="" vertex="1"><mxGeometry height="2" width="250" x="78" y="1069" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-reward-line" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#63dc91;fontSize=15;fontFamily=Courier New;align=left;" value="____/\___/\______|______" vertex="1"><mxGeometry height="30" width="245" x="78" y="1041" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-shortcuts" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#11161c;strokeColor=#2b2b2b;fontColor=#9da5b4;fontSize=8;fontFamily=Courier New;align=center;" value="TRIAL T/Y | ITER [/] | STEP LEFT/RIGHT | PLAY SPACE" vertex="1"><mxGeometry height="40" width="262" x="72" y="1130" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-purpose" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#9da5b4;fontSize=9;align=left;verticalAlign=top;whiteSpace=wrap;" value="Inspect trajectory state, compare iterations/trials, and hand the exact selected step to Explain." vertex="1"><mxGeometry height="48" width="254" x="74" y="1182" as="geometry" /></mxCell><mxCell id="sidebar-callout-1" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;1. Tune trial and parameters&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; A Tune run contains multiple trained policies. Trial identity, best reward, hyperparameters, and first / previous / next / last navigation establish which policy produced the trajectory.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; It is conditional and secondary to trajectory inspection, so it uses a subdued neutral surface. Monospace-friendly values make parameters comparable without competing with playback." vertex="1"><mxGeometry height="192" width="555" x="410" y="236" as="geometry" /></mxCell><mxCell id="sidebar-callout-2" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;2. Experiment identity&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Experiment name, run ID, observation mode, and agent count preserve provenance. A replay is misleading if the user cannot tell which environment and observation contract generated it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; A compact neutral identity block acts as a stable anchor. It is readable but intentionally less prominent than iteration and step controls." vertex="1"><mxGeometry height="192" width="555" x="995" y="236" as="geometry" /></mxCell><mxCell id="sidebar-callout-3" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;3. Iteration navigation&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Saved trajectories represent policy checkpoints across training. The iteration index, source iteration number, mean reward, scrubber, navigation buttons, and [ / ] shortcuts let the user compare how behavior changed over learning.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; A slider communicates ordered progress; explicit edge buttons support exact navigation. The section is neutral until focused because iteration selection is contextual, not continuous playback." vertex="1"><mxGeometry height="192" width="555" x="410" y="446" as="geometry" /></mxCell><mxCell id="sidebar-callout-4" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;4. Episode outcome&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Reward, steps taken versus the limit, and success summarize whether the selected trajectory achieved the task and at what cost.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; The values share one compact row because they describe one outcome. Semantic green marks confirmed success; a failed or false outcome renders in the same red used for negative reward, so failure is never visually neutral." vertex="1"><mxGeometry height="192" width="555" x="995" y="446" as="geometry" /></mxCell><mxCell id="sidebar-callout-5" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;5. Step navigation&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Step selection is the primary replay operation. The current index, scrubber, boundary controls, and Left / Right shortcuts move through individual environment transitions.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; Blue marks this as the active control surface. The slider supports rapid scanning, while first / previous / next / last buttons preserve precise deterministic navigation." vertex="1"><mxGeometry height="192" width="555" x="410" y="656" as="geometry" /></mxCell><mxCell id="sidebar-callout-6" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;6. Current-step state&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Action, step reward, cursor coordinates, voxel count, and placement state explain exactly what changed at the selected transition. It is labeled “Step reward”, not “Reward”, so it cannot be confused with the episode-level total shown four sections up.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; It is read-only evidence, so it uses a dark property surface rather than button styling. A negative value renders in the same red as a failed episode, so reward sign is legible without reading the number." vertex="1"><mxGeometry height="192" width="555" x="995" y="656" as="geometry" /></mxCell><mxCell id="sidebar-callout-7" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;7. Playback and occlusion&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Play / pause animates continuously through all loaded iterations. The Space shortcut supports rapid inspection. Occlusion controls whether geometry hides the agent and trail, which changes interpretation of the viewport without changing trajectory data.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; These controls are grouped because both affect viewing behavior. The occlusion checkbox uses the same blue as other toggle/active-control surfaces, not green — green is reserved exclusively for positive reward, so a checked box can no longer be misread as a reward signal." vertex="1"><mxGeometry height="192" width="555" x="410" y="866" as="geometry" /></mxCell><mxCell id="sidebar-callout-8" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;8. Explainability handoff&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Explain current step sends the exact selected trajectory observation and checkpoint to the explainer. Open Explain tab exposes the full scenario editor. Availability must depend on an attached compatible checkpoint.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; Explain current step is the primary blue action; opening the general tab is secondary. Green attachment text confirms the prerequisite without implying policy success." vertex="1"><mxGeometry height="192" width="555" x="995" y="866" as="geometry" /></mxCell><mxCell id="sidebar-callout-9" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;9. Reward curve&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; The per-step reward trace gives temporal context that a single episode total cannot. The selected-step marker connects the chart to the current geometry and state readout.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; A dark plotting surface reduces noise. Green denotes positive reward, red the zero / negative reference, and a distinct cursor marks the selected step." vertex="1"><mxGeometry height="192" width="555" x="410" y="1076" as="geometry" /></mxCell><mxCell id="sidebar-callout-10" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" value="&lt;b&gt;10. Keyboard map and workflow&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Trial T / Y, iteration [ / ], step Left / Right, and playback Space make repeated trajectory inspection fast. The final note states the workflow: select policy, select checkpoint trajectory, select transition, then explain it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; A quiet monospace strip keeps shortcuts discoverable without duplicating the visual priority of the controls themselves." vertex="1"><mxGeometry height="192" width="555" x="995" y="1076" as="geometry" /></mxCell><mxCell id="sidebar-badge-1" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="1" vertex="1"><mxGeometry height="26" width="26" x="352" y="298" as="geometry" /></mxCell><mxCell id="sidebar-badge-2" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="2" vertex="1"><mxGeometry height="26" width="26" x="352" y="398" as="geometry" /></mxCell><mxCell id="sidebar-badge-3" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="3" vertex="1"><mxGeometry height="26" width="26" x="352" y="494" as="geometry" /></mxCell><mxCell id="sidebar-badge-4" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="4" vertex="1"><mxGeometry height="26" width="26" x="352" y="566" as="geometry" /></mxCell><mxCell id="sidebar-badge-5" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="5" vertex="1"><mxGeometry height="26" width="26" x="352" y="654" as="geometry" /></mxCell><mxCell id="sidebar-badge-6" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="6" vertex="1"><mxGeometry height="26" width="26" x="352" y="752" as="geometry" /></mxCell><mxCell id="sidebar-badge-7" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="7" vertex="1"><mxGeometry height="26" width="26" x="352" y="842" as="geometry" /></mxCell><mxCell id="sidebar-badge-8" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="8" vertex="1"><mxGeometry height="26" width="26" x="352" y="950" as="geometry" /></mxCell><mxCell id="sidebar-badge-9" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="9" vertex="1"><mxGeometry height="26" width="26" x="352" y="1040" as="geometry" /></mxCell><mxCell id="sidebar-badge-10" parent="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" value="10" vertex="1"><mxGeometry height="26" width="26" x="352" y="1172" as="geometry" /></mxCell><mxCell id="opt-changelog" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#241c10;strokeColor=#a9762c;fontColor=#e8c98a;fontSize=12;align=left;verticalAlign=top;spacing=10;" value="CHANGES FROM ORIGINAL&#xA;1. Episode “Success: false” and negative step reward now render red, matching the stated reward-color rule instead of staying neutral gray.&#xA;2. Current-step reward is now labeled “Step reward” to stop it reading as a duplicate of “Episode reward” six sections up.&#xA;3. The “Steps” scrubber label is bolded and the divider above it is bright blue, making the primary control surface visually distinct from the secondary Iterations/Episode sections above it.&#xA;4. The occlusion checkbox moved from green to blue: green is now reserved exclusively for positive reward, so a checked toggle can't be misread as a reward signal."><mxGeometry height="112" width="1540" x="30" y="1392" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="sidebar-html-mock" name="Sidebar Mock (HTML)"><mxGraphModel grid="1" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="1200" pageHeight="1219" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="mock-bg" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0e0e0e;strokeColor=#3c4653;strokeWidth=2;" value="" vertex="1"><mxGeometry height="1219" width="1200" as="geometry" /></mxCell><mxCell id="mock-title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#f1f4f8;fontSize=20;fontStyle=1;align=left;" value="Voxel Replay Sidebar &amp;#8212; HTML Mock (grouped hierarchy)" vertex="1"><mxGeometry height="32" width="800" x="32" y="24" as="geometry" /></mxCell><mxCell id="mock-subtitle" parent="1" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#8fa0b3;fontSize=12;align=left;verticalAlign=top;" value="Rendered from an HTML/CSS prototype, not hand-drawn shapes. Context sections (Iterations, Episode outcome, Reward curve, Explainability) sit on the plain panel background; the three primary control sections (Steps, Current step, Playback) are grouped into one raised card with a blue left rail so the active-control zone reads as a single block instead of ten evenly-weighted rows. Failure and negative reward render red; the occlusion toggle is blue, not green, since green is reserved for positive reward." vertex="1"><mxGeometry height="60" width="1136" x="32" y="60" as="geometry" /></mxCell><mxCell id="mock-image" parent="1" style="shape=image;html=1;imageAspect=1;aspect=fixed;image=data:image/png,;" value="" vertex="1"><mxGeometry height="999" width="420" x="32" y="150" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="run-card-alternatives" name="Run Card Alternatives"><mxGraphModel fold="1" pageWidth="1600" dx="1600" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1100" dy="1100" gridSize="10" pageScale="1" page="1" arrows="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="Run Card Alternatives-bg" value="" style="rounded=0;fillColor=#1e1e1e;strokeColor=#3e3e42;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" heig