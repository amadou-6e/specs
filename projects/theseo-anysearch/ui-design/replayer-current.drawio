try x="816" y="956" width="530" height="70" as="geometry" /></mxCell><mxCell id="run-alt-10-action" value="Stop&amp;#xa;Details" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="956" width="168" height="70" as="geometry" /></mxCell><mxCell id="run-alt-10-progress-bg" value="" style="rounded=0;fillColor=#313131;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="816" y="1029" width="712" height="4" as="geometry" /></mxCell><mxCell id="run-alt-10-progress" value="" style="rounded=0;fillColor=#0078d4;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="816" y="1029" width="392" height="4" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="voxel-replay-sidebar-anatomy" name="Voxel Replay Sidebar Anatomy"><mxGraphModel fold="1" pageWidth="1600" dx="1600" tooltips="1" guides="1" connect="1" grid="1" shadow="0" math="0" pageHeight="1380" dy="1100" gridSize="10" pageScale="1" page="1" arrows="1"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="Voxel Replay Sidebar Anatomy-bg" value="" style="rounded=0;fillColor=#1e1e1e;strokeColor=#3e3e42;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="1380" as="geometry" /></mxCell><mxCell id="Voxel Replay Sidebar Anatomy-top" value="AnySearch - Voxel Replay Sidebar Anatomy" style="rounded=0;fillColor=#181818;strokeColor=#2b2b2b;fontColor=#f1f1f1;fontSize=22;fontStyle=1;align=left;spacingLeft=24;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1600" height="64" as="geometry" /></mxCell><mxCell id="Voxel Replay Sidebar Anatomy-sub" value="One complete reference panel with the purpose and visual rationale for every functional section." style="text;html=1;strokeColor=none;fillColor=none;fontColor=#9da5b4;fontSize=14;align=left;" vertex="1" parent="1"><mxGeometry x="30" y="76" width="1540" height="32" as="geometry" /></mxCell><mxCell id="replay-sidebar-design-language" value="&lt;b&gt;OVERALL DESIGN LANGUAGE&lt;/b&gt;&lt;br&gt;The sidebar follows the VS Code dark workbench: neutral #181818 / #1f1f1f surfaces keep attention on the voxel viewport; thin borders establish hierarchy without card-like visual weight; blue is reserved for the current interactive target; green communicates available or successful state; red is reserved for negative reward. Dense numerical data uses compact or monospace treatment, while explanatory text remains quieter gray." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#11161c;strokeColor=#0078d4;fontColor=#cccccc;fontSize=12;align=left;verticalAlign=top;spacing=14;" vertex="1" parent="1"><mxGeometry x="30" y="112" width="1520" height="100" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-panel" value="" style="rounded=0;fillColor=#181818;strokeColor=#3e3e42;" vertex="1" parent="1"><mxGeometry x="60" y="236" width="286" height="1030" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-number" value="1" style="rounded=0;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=14;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72" y="248" width="30" height="30" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-title" value="Reference sidebar" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#f1f1f1;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="245" width="220" height="24" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-desc" value="Complete replay and explain handoff" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#9da5b4;fontSize=9;align=left;" vertex="1" parent="1"><mxGeometry x="110" y="268" width="220" height="20" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-trial-label" value="TUNE TRIAL" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="74" y="298" width="100" height="16" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-trial" value="Trial 2 / 10 | best reward 15.8&amp;#xa;|&amp;lt;   &amp;lt;   &amp;gt;   &amp;gt;|   T / Y keys&amp;#xa;lr 3.1e-4 | gamma 0.978 | layers 4x128" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#11161c;strokeColor=#2b2b2b;fontColor=#cccccc;fontSize=10;align=left;spacingLeft=9;" vertex="1" parent="1"><mxGeometry x="72" y="316" width="262" height="72" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-experiment-label" value="EXPERIMENT" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="74" y="398" width="100" height="16" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-experiment" value="box_r1_initial_stage&amp;#xa;Run 1e25_0000 | observation box" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#2b2b2b;fontColor=#cccccc;fontSize=10;align=left;spacingLeft=9;" vertex="1" parent="1"><mxGeometry x="72" y="416" width="262" height="48" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-iteration-label" value="ITERATIONS" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="74" y="474" width="100" height="16" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-iteration" value="Iter 1 of 7 | #10 | mean reward 0.681&amp;#xa;[=========|------------]&amp;#xa;|&amp;lt;   &amp;lt;   &amp;gt;   &amp;gt;|      [ / ] keys" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#2b2b2b;fontColor=#cccccc;fontSize=10;align=left;spacingLeft=9;" vertex="1" parent="1"><mxGeometry x="72" y="492" width="262" height="70" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-episode-label" value="EPISODE" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="74" y="572" width="100" height="16" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-episode" value="Reward 0.681 | Steps 200 / 200 | Success false" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#11161c;strokeColor=#2b2b2b;fontColor=#9da5b4;fontSize=10;align=left;spacingLeft=9;" vertex="1" parent="1"><mxGeometry x="72" y="590" width="262" height="40" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-step-label" value="STEPS" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="74" y="640" width="100" height="16" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-step" value="Step 143 / 200&amp;#xa;[==============|-------]&amp;#xa;|&amp;lt;   &amp;lt;   &amp;gt;   &amp;gt;|      left / right keys" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#04395e;strokeColor=#0078d4;fontColor=#ffffff;fontSize=10;align=left;spacingLeft=9;" vertex="1" parent="1"><mxGeometry x="72" y="658" width="262" height="70" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-current-label" value="CURRENT STEP" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="74" y="738" width="100" height="16" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-current" value="Action 17 | Reward -0.010&amp;#xa;Cursor [2, 6, 2] | Voxels 22 | placed false" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#11161c;strokeColor=#2b2b2b;fontColor=#cccccc;fontSize=10;align=left;spacingLeft=9;" vertex="1" parent="1"><mxGeometry x="72" y="756" width="262" height="50" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-playback-label" value="PLAYBACK" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="74" y="816" width="100" height="16" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-playback" value="PLAY / PAUSE     Space key&amp;#xa;Plays continuously through every iteration&amp;#xa;[x] Geometry occludes agent and trail" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#1f1f1f;strokeColor=#2b2b2b;fontColor=#cccccc;fontSize=10;align=left;spacingLeft=9;" vertex="1" parent="1"><mxGeometry x="72" y="834" width="262" height="66" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-explain-label" value="EXPLAINABILITY" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="74" y="910" width="120" height="16" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-explain-current" value="Explain current step" style="rounded=1;arcSize=5;fillColor=#04395e;strokeColor=#0078d4;fontColor=#ffffff;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="72" y="928" width="126" height="36" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-explain-open" value="Open Explain tab" style="rounded=1;arcSize=5;fillColor=#1f1f1f;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=10;" vertex="1" parent="1"><mxGeometry x="208" y="928" width="126" height="36" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-explain-note" value="Checkpoint attached to this run" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#63dc91;fontSize=9;align=left;" vertex="1" parent="1"><mxGeometry x="74" y="968" width="250" height="18" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-reward-label" value="REWARD CURVE - CURRENT ITERATION" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#858585;fontSize=9;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="74" y="998" width="230" height="16" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-reward-bg" value="" style="rounded=1;arcSize=5;fillColor=#090c10;strokeColor=#2b2b2b;" vertex="1" parent="1"><mxGeometry x="72" y="1018" width="262" height="100" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-reward-zero" value="" style="rounded=0;fillColor=#d13438;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="1069" width="250" height="2" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-reward-line" value="____/\___/\______|______" style="text;html=1;strokeColor=none;fillColor=none;fontColor=#63dc91;fontSize=15;fontFamily=Courier New;align=left;" vertex="1" parent="1"><mxGeometry x="78" y="1041" width="245" height="30" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-shortcuts" value="TRIAL T/Y | ITER [/] | STEP LEFT/RIGHT | PLAY SPACE" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#11161c;strokeColor=#2b2b2b;fontColor=#9da5b4;fontSize=8;fontFamily=Courier New;align=center;" vertex="1" parent="1"><mxGeometry x="72" y="1130" width="262" height="40" as="geometry" /></mxCell><mxCell id="functional-replay-sidebar-1-purpose" value="Inspect trajectory state, compare iterations/trials, and hand the exact selected step to Explain." style="text;html=1;strokeColor=none;fillColor=none;fontColor=#9da5b4;fontSize=9;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="74" y="1182" width="254" height="48" as="geometry" /></mxCell><mxCell id="sidebar-callout-1" value="&lt;b&gt;1. Tune trial and parameters&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; A Tune run contains multiple trained policies. Trial identity, best reward, hyperparameters, and first / previous / next / last navigation establish which policy produced the trajectory.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; It is conditional and secondary to trajectory inspection, so it uses a subdued neutral surface. Monospace-friendly values make parameters comparable without competing with playback." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="410" y="236" width="555" height="192" as="geometry" /></mxCell><mxCell id="sidebar-callout-2" value="&lt;b&gt;2. Experiment identity&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Experiment name, run ID, observation mode, and agent count preserve provenance. A replay is misleading if the user cannot tell which environment and observation contract generated it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; A compact neutral identity block acts as a stable anchor. It is readable but intentionally less prominent than iteration and step controls." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="995" y="236" width="555" height="192" as="geometry" /></mxCell><mxCell id="sidebar-callout-3" value="&lt;b&gt;3. Iteration navigation&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Saved trajectories represent policy checkpoints across training. The iteration index, source iteration number, mean reward, scrubber, navigation buttons, and [ / ] shortcuts let the user compare how behavior changed over learning.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; A slider communicates ordered progress; explicit edge buttons support exact navigation. The section is neutral until focused because iteration selection is contextual, not continuous playback." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="410" y="446" width="555" height="192" as="geometry" /></mxCell><mxCell id="sidebar-callout-4" value="&lt;b&gt;4. Episode outcome&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Reward, steps taken versus the limit, and success summarize whether the selected trajectory achieved the task and at what cost.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; The values share one compact row because they describe one outcome. Semantic green should appear only for confirmed success; normal or failed episodes remain neutral so color retains meaning." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="995" y="446" width="555" height="192" as="geometry" /></mxCell><mxCell id="sidebar-callout-5" value="&lt;b&gt;5. Step navigation&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Step selection is the primary replay operation. The current index, scrubber, boundary controls, and Left / Right shortcuts move through individual environment transitions.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; Blue marks this as the active control surface. The slider supports rapid scanning, while first / previous / next / last buttons preserve precise deterministic navigation." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="410" y="656" width="555" height="192" as="geometry" /></mxCell><mxCell id="sidebar-callout-6" value="&lt;b&gt;6. Current-step state&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Action, immediate reward, cursor coordinates, voxel count, and placement state explain exactly what changed at the selected transition and connect the controls to the rendered geometry.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; It is read-only evidence, so it uses a dark property surface rather than button styling. Aligned compact values make changes easy to compare step by step." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="995" y="656" width="555" height="192" as="geometry" /></mxCell><mxCell id="sidebar-callout-7" value="&lt;b&gt;7. Playback and occlusion&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Play / pause animates continuously through all loaded iterations. The Space shortcut supports rapid inspection. Occlusion controls whether geometry hides the agent and trail, which changes interpretation of the viewport without changing trajectory data.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; These controls are grouped because both affect viewing behavior. The checkbox exposes persistent state; playback receives action styling only while active." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="410" y="866" width="555" height="192" as="geometry" /></mxCell><mxCell id="sidebar-callout-8" value="&lt;b&gt;8. Explainability handoff&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Explain current step sends the exact selected trajectory observation and checkpoint to the explainer. Open Explain tab exposes the full scenario editor. Availability must depend on an attached compatible checkpoint.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; Explain current step is the primary blue action; opening the general tab is secondary. Green attachment text confirms the prerequisite without implying policy success." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="995" y="866" width="555" height="192" as="geometry" /></mxCell><mxCell id="sidebar-callout-9" value="&lt;b&gt;9. Reward curve&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; The per-step reward trace gives temporal context that a single episode total cannot. The selected-step marker connects the chart to the current geometry and state readout.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; A dark plotting surface reduces noise. Green denotes positive reward, red the zero / negative reference, and a distinct cursor marks the selected step." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="410" y="1076" width="555" height="192" as="geometry" /></mxCell><mxCell id="sidebar-callout-10" value="&lt;b&gt;10. Keyboard map and workflow&lt;/b&gt;&lt;br&gt;&lt;b&gt;Why it exists:&lt;/b&gt; Trial T / Y, iteration [ / ], step Left / Right, and playback Space make repeated trajectory inspection fast. The final note states the workflow: select policy, select checkpoint trajectory, select transition, then explain it.&lt;br&gt;&lt;br&gt;&lt;b&gt;Why this styling:&lt;/b&gt; A quiet monospace strip keeps shortcuts discoverable without duplicating the visual priority of the controls themselves." style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#181818;strokeColor=#3e3e42;fontColor=#cccccc;fontSize=11;align=left;verticalAlign=top;spacing=12;" vertex="1" parent="1"><mxGeometry x="995" y="1076" width="555" height="192" as="geometry" /></mxCell><mxCell id="sidebar-badge-1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="352" y="298" width="26" height="26" as="geometry" /></mxCell><mxCell id="sidebar-badge-2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="352" y="398" width="26" height="26" as="geometry" /></mxCell><mxCell id="sidebar-badge-3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="352" y="494" width="26" height="26" as="geometry" /></mxCell><mxCell id="sidebar-badge-4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="352" y="566" width="26" height="26" as="geometry" /></mxCell><mxCell id="sidebar-badge-5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="352" y="654" width="26" height="26" as="geometry" /></mxCell><mxCell id="sidebar-badge-6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="352" y="752" width="26" height="26" as="geometry" /></mxCell><mxCell id="sidebar-badge-7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="352" y="842" width="26" height="26" as="geometry" /></mxCell><mxCell id="sidebar-badge-8" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="352" y="950" width="26" height="26" as="geometry" /></mxCell><mxCell id="sidebar-badge-9" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="352" y="1040" width="26" height="26" as="geometry" /></mxCell><mxCell id="sidebar-badge-10" value="10" style="ellipse;whiteSpace=wrap;html=1;fillColor=#0078d4;strokeColor=#0078d4;fontColor=#ffffff;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="352" y="1172" width="26" height="26" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>